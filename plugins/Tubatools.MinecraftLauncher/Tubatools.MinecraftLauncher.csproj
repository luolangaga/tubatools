<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <EnableDefaultPRIResourceItems>false</EnableDefaultPRIResourceItems>
    <PackageId>Tubatools.MinecraftLauncher</PackageId>
    <Version>1.0.11</Version>
    <Authors>图吧工具箱</Authors>
    <Description>我的世界启动器：现代 Minecraft 界面、一键安装原版/Fabric/Quilt/Forge/NeoForge、Modrinth 整合包/模组/光影/资源包、微软正版与离线账户</Description>
    <PackageTags>Tubatools;Minecraft;启动器;Modrinth;整合包;Microsoft</PackageTags>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IsPackable>true</IsPackable>
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TubaWinUi3.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\TubaWinUi3.PluginSdk\TubaWinUi3.PluginSdk.csproj" Private="false" PrivateAssets="all" />
    <!-- 统一使用宿主下载队列；运行时不复制、不打进插件包。 -->
    <ProjectReference Include="..\..\TubaWinUi3.WinUI3\TubaWinUi3.csproj" Private="false" PrivateAssets="all" />
    <!-- 仅使用 WinUI 编译引用；运行时类型由宿主提供，禁止把框架 DLL 打进插件包。 -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" ExcludeAssets="runtime;native" />
    <!-- Modrinth 图标常为 WebP；用纯托管 ImageSharp 统一转 PNG，避免 WinUI 解码失败。 -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <!-- 微软令牌使用 Windows DPAPI（CurrentUser）加密落盘。 -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 插件资源只作为包内文件分发，不参与本项目的 XAML/PRI 编译。 -->
    <Page Remove="assets\**\*" />
    <Content Remove="assets\**\*" />
    <PRIResource Remove="assets\**\*" />
    <None Remove="assets\**\*" />
    <None Include="tubatools.json" Pack="true" PackagePath="/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="assets\**\*" Pack="true" PackagePath="assets/" />
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="plugin/" />
    <None Include="$(OutputPath)$(AssemblyName).deps.json" Pack="true" PackagePath="plugin/" />
    <!-- 宿主已加载的依赖（Downloader/DownloadQueueService 等）不随插件分发；只带插件自己的第三方库。 -->
    <None Include="$(OutputPath)SixLabors.ImageSharp.dll" Pack="true" PackagePath="plugin/" />
    <None Include="$(NuGetPackageRoot)system.security.cryptography.protecteddata\10.0.0\lib\net8.0\System.Security.Cryptography.ProtectedData.dll"
          Pack="true" PackagePath="plugin/" />
  </ItemGroup>

  <Target Name="CollectPluginDependencies" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <_PluginDependency Include="$(OutputPath)SixLabors.ImageSharp.dll" />
      <_PluginDependency Include="$(NuGetPackageRoot)system.security.cryptography.protecteddata\10.0.0\lib\net8.0\System.Security.Cryptography.ProtectedData.dll" />
      <None Include="@(_PluginDependency)" Pack="true" PackagePath="plugin/" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Compile Include="..\Shared\PluginOnboardingDialog.cs" Link="Onboarding\PluginOnboardingDialog.cs" />
  </ItemGroup>
</Project>
