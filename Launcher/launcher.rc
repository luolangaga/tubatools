#pragma code_page(65001)
#include <windows.h>

IDI_APP ICON "..\\TubaWinUi3.WinUI3\\Assets\\AppIcon.ico"

// RequireAdministrator 清单（CREATEPROCESS_MANIFEST_RESOURCE_ID=1, RT_MANIFEST=24）。
// 必须真正嵌入：UAC 在 launcher 进程创建前弹出，主程序直接以管理员启动，
// 省掉主程序内部 runas 二次提权重启（便携版单次完整启动）。
// 主程序本体保持 asInvoker，--copy-path 等免提权子模式不受影响。
1 24 "launcher.exe.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "TubaWinUi3"
            VALUE "FileDescription", "图吧工具箱CE"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "TubaWinUi3"
            VALUE "OriginalFilename", "图吧工具箱WinUI3.exe"
            VALUE "ProductName", "图吧工具箱CE"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
