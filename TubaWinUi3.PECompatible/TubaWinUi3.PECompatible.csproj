<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>TubaWinUi3.PECompatible</RootNamespace>
    <AssemblyName>图吧工具箱PE兼容版</AssemblyName>
    <Version>1.0.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- WmiProvider 用 unmanaged 函数指针直接调用 WMI 的 COM vtable（System.Management 在 AOT 下不可用）。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- 兼容未完整支持 CET 的旧版 Windows / PE，构建与单文件发布均禁用 CET。 -->
    <CetCompat>false</CetCompat>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <MewUIWin32TextEngine>Gdi</MewUIWin32TextEngine>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aprillz.MewUI.Core" Version="0.22.1" />
    <PackageReference Include="Aprillz.MewUI.Platform.Win32" Version="0.22.1" />
    <PackageReference Include="Aprillz.MewUI.Backend.Gdi" Version="0.22.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\TubaWinUi3.Compatible\Models\HardwareInfoItem.cs" Link="CompatibilityCore\Models\HardwareInfoItem.cs" />
    <Compile Include="..\TubaWinUi3.Compatible\Models\HardwareInfoSection.cs" Link="CompatibilityCore\Models\HardwareInfoSection.cs" />
    <Compile Include="..\TubaWinUi3.Compatible\Models\ToolItem.cs" Link="CompatibilityCore\Models\ToolItem.cs" />
    <Compile Include="..\TubaWinUi3.Compatible\Services\AppSettings.cs" Link="CompatibilityCore\Services\AppSettings.cs" />
    <Compile Include="..\TubaWinUi3.Compatible\Services\ConfigManager.cs" Link="CompatibilityCore\Services\ConfigManager.cs" />
    <Compile Include="..\TubaWinUi3.Compatible\Services\FavoritesService.cs" Link="CompatibilityCore\Services\FavoritesService.cs" />
    <Compile Include="..\TubaWinUi3.Compatible\Services\HardwareInfoService.cs" Link="CompatibilityCore\Services\HardwareInfoService.cs" />
    <Compile Include="..\TubaWinUi3.Compatible\Services\NpuCatalog.cs" Link="CompatibilityCore\Services\NpuCatalog.cs" />
    <Compile Include="..\TubaWinUi3.Compatible\Services\ToolCatalog.cs" Link="CompatibilityCore\Services\ToolCatalog.cs" />
    <Compile Include="..\TubaWinUi3.Compatible\Services\ToolIconService.cs" Link="CompatibilityCore\Services\ToolIconService.cs" />
    <Compile Include="..\TubaWinUi3.Compatible\Services\ToolMetadataService.cs" Link="CompatibilityCore\Services\ToolMetadataService.cs" />
    <Compile Include="..\TubaWinUi3.Compatible\Services\WmiRow.cs" Link="CompatibilityCore\Services\WmiRow.cs" />
  </ItemGroup>

  <!--
    开发调试：Debug 构建完成后，把 PE 兼容版产物复制到普通版（主程序）的 Debug 输出目录下，
    固定放进「图吧工具箱PE兼容版」子目录。该子目录位于普通版 Debug 目录内，兼容版服务会沿
    父目录向上查找 Tools/Metadata（ToolCatalog.FindToolsRoot / ToolMetadataService.FindRoot），
    因此复制过去即可直接运行并加载完整工具集调试。仅当主程序已构建出 Debug 产物时执行；
    目标文件正在运行时复制失败只警告、不阻断构建。
  -->
  <Target Name="CopyToWinUiDebugDir" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <ItemGroup>
      <_WinUiDebugMarkers Include="$(MSBuildProjectDirectory)\..\TubaWinUi3.WinUI3\bin\**\Debug\net10.0-windows10.0.26100.0\$(RuntimeIdentifier)\TubaWinUi3.exe" />
      <_WinUiDebugDirs Include="@(_WinUiDebugMarkers->'%(RootDir)%(Directory)图吧工具箱PE兼容版')" />
      <_PeCompatibleFiles Include="$(TargetDir)**\*" />
    </ItemGroup>

    <Message Importance="High"
             Text="未找到普通版 Debug 输出目录（先构建 TubaWinUi3.WinUI3），跳过 PE 兼容版复制。"
             Condition="'@(_WinUiDebugDirs)' == ''" />

    <MakeDir Directories="@(_WinUiDebugDirs)" Condition="'@(_WinUiDebugDirs)' != ''" />
    <Copy SourceFiles="@(_PeCompatibleFiles)"
          DestinationFolder="%(_WinUiDebugDirs.Identity)"
          SkipUnchangedFiles="true"
          ContinueOnError="WarnAndContinue"
          Condition="'@(_WinUiDebugDirs)' != ''" />

    <Message Importance="High"
             Text="PE 兼容版已复制到普通版 Debug 目录：%(_WinUiDebugDirs.Identity)"
             Condition="'@(_WinUiDebugDirs)' != ''" />
  </Target>
</Project>
