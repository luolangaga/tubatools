<Project Sdk="Microsoft.NET.Sdk">
  <!--
    主动拦截后端（流氓软件拦截器）：独立常驻进程，用 NativeAOT 编译为单文件原生
    可执行文件，无运行时依赖，内存占用最小。核心原理参照 ContextMenuMgr
    （https://github.com/PLFJY/ContextMenuMgr）：监控右键菜单注册表根，检测到
    新增的第三方右键项即自动屏蔽（先拦截再审核），并持续轮询纠偏期望状态。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>TubaWinUI3.BackEnd</RootNamespace>
    <AssemblyName>TubaWinUI3.BackEnd</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- NativeAOT：单文件、无运行时、最小内存 -->
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Speed</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <DebugType>none</DebugType>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <Version>1.0.0</Version>
    <NoWarn>$(NoWarn);IL2026;IL3050</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 供测试项目访问 internal 成员（如 ClsidResolver.NormalizeServerPath） -->
    <InternalsVisibleTo Include="TubaWinUi3.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="binverify 2\TubaWinUI3.BackEnd.dll" />
    <None Remove="binverify 2\TubaWinUI3.BackEnd.exe" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="binverify 2\" />
  </ItemGroup>
</Project>
