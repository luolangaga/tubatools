<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TubaWinUi3.Controls.FestivalOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsHitTestVisible="False"
    Visibility="Collapsed">

    <!-- 顶部装饰（emoji/雪堆）与 Composition 粒子分两层：
         两层都不参与命中测试，工具卡、标题栏和导航的点击不受影响。 -->
    <Grid x:Name="Root" Background="Transparent">
        <Canvas x:Name="DecorCanvas" IsHitTestVisible="False" />
        <Canvas x:Name="ParticleHost" IsHitTestVisible="False" />
    </Grid>
</UserControl>
