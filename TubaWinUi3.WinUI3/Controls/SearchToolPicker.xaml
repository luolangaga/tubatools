<UserControl
    x:Class="TubaWinUi3.Controls.SearchToolPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:TubaWinUi3.Models"
    xmlns:l="using:WinUI3Localizer">
    <Grid x:Name="SearchPanel" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="SearchRegistrationHint" l:Uids.Uid="SearchPicker_Hint" Text="勾选的工具会添加到开始菜单与 Windows 搜索；一个都不选就不注册。"
            TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <AutoSuggestBox x:Name="ToolSearchBox" l:Uids.Uid="SearchPicker_Query" Grid.Row="1" Header="选择要添加的工具" QueryIcon="Find"
            PlaceholderText="搜索工具名称或分类" TextChanged="ToolSearchBox_TextChanged"
            AutomationProperties.AutomationId="WizardToolSearch" />
        <Grid x:Name="SelectionActions" Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectionSummary" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
            <Button x:Name="SelectAllButton" l:Uids.Uid="SearchPicker_All" Grid.Column="1" Content="全选" Click="SelectAll_Click" AutomationProperties.AutomationId="WizardSelectAll" />
            <Button x:Name="ClearSelectionButton" l:Uids.Uid="SearchPicker_None" Grid.Column="2" Content="全不选" Click="ClearSelection_Click" AutomationProperties.AutomationId="WizardClearSelection" />
        </Grid>
        <Grid Grid.Row="3">
            <ListView x:Name="SearchToolsList" SelectionMode="Multiple" IsMultiSelectCheckBoxEnabled="True"
                SelectionChanged="SearchToolsList_SelectionChanged" HorizontalContentAlignment="Stretch"
                AutomationProperties.AutomationId="WizardSearchTools">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:SetupSearchTool">
                        <Grid Padding="4,6" ColumnSpacing="12" AutomationProperties.Name="{x:Bind Name}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid>
                            <Image Width="32" Height="32" Source="{x:Bind Icon, Mode=OneWay}" Visibility="{x:Bind IconVisibility, Mode=OneWay}" />
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="24" Glyph="{x:Bind IconGlyph}"
                                Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />
                        </Grid>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel x:Name="ToolsLoadingPanel" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <ProgressRing Width="28" Height="28" IsActive="True" HorizontalAlignment="Center" />
                <TextBlock Text="正在读取可添加的工具…" l:Uids.Uid="SearchPicker_Loading" />
            </StackPanel>
            <TextBlock x:Name="ToolsEmptyText" l:Uids.Uid="SearchPicker_Empty" Text="没有匹配的工具，请换个名称试试。" TextWrapping="Wrap"
                HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>
        <InfoBar x:Name="ToolsMessage" Grid.Row="4" IsOpen="False" IsClosable="False" Severity="Informational" />
    </Grid>
</UserControl>
