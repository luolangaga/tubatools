<UserControl
    x:Class="TubaWinUi3.Controls.DashboardContentEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TubaWinUi3.Controls">
    <Grid RowSpacing="12">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <SelectorBar x:Name="PaneSelector" Visibility="Collapsed" SelectionChanged="PaneSelector_SelectionChanged">
          <SelectorBarItem x:Name="LibraryTab" Text="添加工具" IsSelected="True" AutomationProperties.AutomationId="DashboardLibraryTab"/>
          <SelectorBarItem x:Name="SelectedTab" Text="首页内容" AutomationProperties.AutomationId="DashboardSelectedTab"/>
      </SelectorBar>
      <Grid x:Name="EditorGrid" Grid.Row="1" ColumnSpacing="24" RowSpacing="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="LibraryPane" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="LibraryHeading" Text="添加工具" Style="{ThemeResource SubtitleTextBlockStyle}"/>
            <TextBox Grid.Row="1" x:Name="SearchBox" AutomationProperties.AutomationId="DashboardToolSearch"
                     PlaceholderText="搜索名称、介绍或分类" TextChanged="SearchBox_TextChanged"/>
            <Grid x:Name="FilterRow" Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="CategoryBox" AutomationProperties.AutomationId="DashboardToolScope"
                          HorizontalAlignment="Stretch" SelectionChanged="CategoryBox_SelectionChanged"/>
                <TextBlock x:Name="ResultsText" Grid.Column="1" VerticalAlignment="Center"
                           Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
            <Border x:Name="LibraryResultsBorder" Grid.Row="3" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <ListView x:Name="LibraryList" AutomationProperties.AutomationId="DashboardAllTools" SelectionMode="None"
                              HorizontalContentAlignment="Stretch" Padding="4">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:DashboardEditorOption">
                                <CheckBox IsChecked="{x:Bind Included, Mode=TwoWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          AutomationProperties.Name="{x:Bind Name}" AutomationProperties.AutomationId="{x:Bind Target}" Padding="8,10" MinWidth="0">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid Width="36" Height="36" VerticalAlignment="Center">
                                            <FontIcon Glyph="{x:Bind FallbackGlyph}" FontSize="28" Visibility="{x:Bind FallbackVisibility, Mode=OneWay}" Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/>
                                            <Image Source="{x:Bind Icon, Mode=OneWay}" Stretch="Uniform"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{x:Bind Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind Description}" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="{x:Bind Description}"/>
                                            <TextBlock Text="{x:Bind CategoryLabel}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </CheckBox>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="NoResultsText" Text="没有找到匹配的工具" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
        <ScrollViewer x:Name="SelectedScroll" AutomationProperties.AutomationId="DashboardSelectedPaneScroll" Grid.Column="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="SelectedPane" RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="SelectedHeading" Text="首页内容" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                <Button x:Name="RestoreButton" Grid.Column="1" Content="恢复默认" Click="RestoreButton_Click" AutomationProperties.AutomationId="DashboardRestoreContent"/>
            </Grid>
            <TextBlock x:Name="OrderHint" Grid.Row="1" Text="勾选添加工具，选中后可设置展示样式。" TextWrapping="Wrap"
                       Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Border Grid.Row="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" MinHeight="96">
                <Grid>
                    <ListView x:Name="SelectedList" AutomationProperties.AutomationId="DashboardSelectedTools" SelectionMode="Single"
                              CanDragItems="True" CanReorderItems="True" AllowDrop="True"
                              HorizontalContentAlignment="Stretch" Padding="4" SelectionChanged="SelectedList_SelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8,6"/></Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:DashboardEditorCard">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE784;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    <Grid Grid.Column="1" Width="28" Height="28">
                                        <FontIcon Glyph="{x:Bind Option.FallbackGlyph}" FontSize="24" Visibility="{x:Bind Option.FallbackVisibility, Mode=OneWay}"/>
                                        <Image Source="{x:Bind Option.Icon, Mode=OneWay}"/>
                                    </Grid>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="3" Tag="{x:Bind}" Click="RemoveButton_Click" Background="Transparent" BorderThickness="0"
                                            AutomationProperties.Name="移除此卡片" ToolTipService.ToolTip="移除此卡片" Padding="6" MinWidth="28" MinHeight="28">
                                        <FontIcon Glyph="&#xE711;" FontSize="12"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptySelectionText" Text="尚未添加工具" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
            </Border>
            <StackPanel Grid.Row="3" Spacing="10">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="DetailsHeading" Text="编辑选中的卡片" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                    <Button x:Name="MoveUpButton" Grid.Column="1" Click="MoveUpButton_Click" AutomationProperties.AutomationId="DashboardMoveUp" AutomationProperties.Name="上移" ToolTipService.ToolTip="上移" Padding="8"><FontIcon Glyph="&#xE70E;" FontSize="12"/></Button>
                    <Button x:Name="MoveDownButton" Grid.Column="2" Click="MoveDownButton_Click" AutomationProperties.AutomationId="DashboardMoveDown" AutomationProperties.Name="下移" ToolTipService.ToolTip="下移" Padding="8"><FontIcon Glyph="&#xE70D;" FontSize="12"/></Button>
                </Grid>
                <TextBox x:Name="CardTitleBox" Header="名称" MaxLength="60" TextChanged="CardText_TextChanged" AutomationProperties.AutomationId="DashboardCardTitle"/>
                <TextBox x:Name="CardDescriptionBox" Header="介绍" MaxLength="240" AcceptsReturn="True" TextWrapping="Wrap" Height="76"
                         TextChanged="CardText_TextChanged" AutomationProperties.AutomationId="DashboardCardDescription"/>
            </StackPanel>
        </Grid>
        </ScrollViewer>
      </Grid>
    </Grid>
</UserControl>
