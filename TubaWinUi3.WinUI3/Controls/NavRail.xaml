<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TubaWinUi3.Controls.NavRail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- 按钮模板只保留内容与焦点框：悬停底由自绘小卡片负责，避免默认样式的整行底色盖住内缩的选中卡片。 -->
        <Style x:Key="NavRailTileStyle" TargetType="Button">
            <Setter Property="Width" Value="88" />
            <Setter Property="Height" Value="62" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            x:Name="MenuScroller"
            Grid.Row="0"
            HorizontalScrollMode="Disabled"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Hidden"
            VerticalScrollMode="Auto">
            <Grid x:Name="MenuContent">
                <!-- 共享的选中指示器：白色圆角卡片 + 贴左缘的蓝色竖条，切换项时整体纵向滑动。 -->
                <Grid
                    x:Name="MenuSelection"
                    Width="88"
                    Height="52"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Opacity="0"
                    IsHitTestVisible="False">
                    <Border
                        Width="72"
                        Height="52"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}"
                        CornerRadius="8" />
                    <Border
                        Width="3"
                        Height="18"
                        Margin="2,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="2" />
                </Grid>

                <StackPanel x:Name="MenuPanel" Margin="0,8,0,8" Spacing="2" />
            </Grid>
        </ScrollViewer>

        <Border
            x:Name="FooterBorder"
            Grid.Row="1"
            Padding="0,6,0,8"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid x:Name="FooterContent">
                <Grid
                    x:Name="FooterSelection"
                    Width="88"
                    Height="52"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,5,0,0"
                    Opacity="0"
                    IsHitTestVisible="False">
                    <Border
                        Width="72"
                        Height="52"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}"
                        CornerRadius="8" />
                    <Border
                        Width="3"
                        Height="18"
                        Margin="2,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="2" />
                </Grid>
                <StackPanel x:Name="FooterPanel" Spacing="2" />
            </Grid>
        </Border>

        <!-- 与内容区之间的细分隔线（商店左侧栏同款） -->
        <Border
            Grid.RowSpan="2"
            Width="1"
            HorizontalAlignment="Right"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
            IsHitTestVisible="False" />
    </Grid>
</UserControl>
