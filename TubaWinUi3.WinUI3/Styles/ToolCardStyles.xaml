<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        共享组件样式：工具卡容器（GridViewItem 悬停动效统一）、卡片/页头操作按钮、状态药丸。
        卡片内容的 DataTemplate 因含各页事件处理器，保留在页面内；
        这里的容器样式供 HomePage / FavoritesPage / BuiltinToolsPage / CommunityToolsPage 共用。
    -->

    <!-- 工具卡容器：悬停微放大 1.03 / 按下 0.97（与首页原动效一致，统一到一处） -->
    <Style x:Key="ToolCardItemStyle" TargetType="GridViewItem">
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- 简洁模式卡片容器（间距略小，原生反馈与常规卡一致） -->
    <Style x:Key="CompactToolCardItemStyle" TargetType="GridViewItem" BasedOn="{StaticResource ToolCardItemStyle}">
        <Setter Property="Margin" Value="0,0,10,10" />
    </Style>

    <!-- 页头操作按钮（返回键旁的刷新/导出等紧凑按钮） -->
    <Style x:Key="ToolHeaderActionButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 工具卡底部图标操作按钮（占满所在单元格） -->
    <Style x:Key="ToolCardActionButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <!-- 状态药丸（版本号/扩展名/状态标签）：8,3 内边距 + 圆角 12 + 淡底 -->
    <Style x:Key="StatusPillStyle" TargetType="Border">
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="CornerRadius" Value="{StaticResource PillCornerRadiusToken}" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
    </Style>

</ResourceDictionary>
