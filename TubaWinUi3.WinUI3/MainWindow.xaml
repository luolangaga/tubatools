<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="TubaWinUi3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TubaWinUi3"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="图吧工具箱CE"
    xmlns:controls="using:TubaWinUi3.Controls"
    xmlns:l="using:WinUI3Localizer"
    mc:Ignorable="d">

    <Grid PointerPressed="RootGrid_PointerPressed">
        <Grid.Resources>
            <local:IconPathToVisibilityConverter x:Key="IconPathToVisibility" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="SplashOverlay"
              Grid.RowSpan="3"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              Canvas.ZIndex="9999"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform />
            </Grid.RenderTransform>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" RowSpacing="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Width="96"
                    Height="96"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="12"
                    HorizontalAlignment="Center">
                    <Image
                        Width="64"
                        Height="64"
                        Source="ms-appx:///Assets/AppIcon.ico"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="4">
                    <TextBlock
                        FontSize="28"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        l:Uids.Uid="MainWindow_SplashTitle"
                        Text="图吧工具箱CE" />
                    <TextBlock
                        FontSize="12"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        x:Name="SplashStatusText"
                        l:Uids.Uid="MainWindow_SplashStatus"
                        Text="正在初始化..." />
                </StackPanel>

                <ProgressBar
                    x:Name="SplashProgress"
                    Grid.Row="2"
                    Width="200"
                    IsIndeterminate="True"
                    HorizontalAlignment="Center" />

                <TextBlock
                    x:Name="SplashVersionText"
                    Grid.Row="3"
                    FontSize="12"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </Grid>
        </Grid>

        <TitleBar
            x:Name="AppTitleBar"
            Title="图吧工具箱CE"
            AutoRefreshDragRegions="True"
            FontWeight="SemiBold"
            BackRequested="TitleBar_BackRequested"
            IsBackButtonVisible="True"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.Resources>
                <!-- TitleBar 默认把 Content 居中；内容宽于可用列宽时会向两侧溢出，
                     右侧溢出会压到系统的标题按钮上（Issue #262）。改为横向拉伸，
                     内容只会从左侧起始、宽度由可用空间决定。 -->
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.ico" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <!-- 内容必须始终收在标题栏 Content 列宽内：TitleBar 会把每个交互控件的
                     布局矩形原样登记成「直通区域」（不做裁剪），一旦溢出到右侧就会连
                     最小拖拽区和最小化/最大化/关闭按钮一起吃掉。实际宽度由
                     TitleBarContent_SizeChanged 按列宽收放搜索框与右侧按钮。 -->
                <Grid
                    x:Name="TitleBarContent"
                    VerticalAlignment="Center"
                    SizeChanged="TitleBarContent_SizeChanged"
                    TitleBar.IsDragRegion="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid
                        x:Name="TitleSearchArea"
                        Grid.Column="0"
                        Width="320"
                        Margin="0,0,8,0"
                        HorizontalAlignment="Left">
                        <AutoSuggestBox
                            x:Name="SearchBox"
                            MinWidth="0"
                            PlaceholderText="搜索工具、设置..."
                            l:Uids.Uid="MainWindow_SearchPlaceholder"
                            QueryIcon="Find"
                            VerticalAlignment="Center"
                            TitleBar.IsDragRegion="False"
                            GotFocus="SearchBox_GotFocus"
                            LostFocus="SearchBox_LostFocus"
                            TextChanged="SearchBox_TextChanged"
                            QuerySubmitted="SearchBox_QuerySubmitted" />
                        <Popup
                            x:Name="SearchPopup"
                            VerticalOffset="32"
                            GettingFocus="SearchPopup_GettingFocus">
                            <Popup.Transitions>
                                <TransitionCollection>
                                    <PopupThemeTransition />
                                </TransitionCollection>
                            </Popup.Transitions>
                            <Border
                                x:Name="SearchPopupBorder"
                                Width="318"
                                MaxHeight="400"
                                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="4">
                                <ListView
                                    x:Name="SearchListView"
                                    SelectionMode="Single"
                                    IsItemClickEnabled="True"
                                    KeyDown="SearchListView_KeyDown"
                                    ItemClick="SearchListView_ItemClick">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="12" Padding="4,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border
                                                    Width="32"
                                                    Height="32"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    CornerRadius="8">
                                                    <Grid>
                                                        <Image
                                                            Width="24" Height="24"
                                                            Stretch="Uniform"
                                                            Source="{Binding IconPath}"
                                                            Visibility="{Binding HasIconPath, Converter={StaticResource IconPathToVisibility}}" />
                                                        <Image
                                                            Width="24" Height="24"
                                                            Stretch="Uniform"
                                                            Source="{Binding IconSource}"
                                                            Visibility="{Binding HasIconSource, Converter={StaticResource IconPathToVisibility}}" />
                                                        <FontIcon
                                                            FontSize="14"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Glyph="{Binding Glyph}"
                                                            Visibility="{Binding HasGlyphFallback, Converter={StaticResource IconPathToVisibility}}" />
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock

                                                        FontSize="14"
                                                        FontWeight="SemiBold"
                                                        MaxLines="1"
                                                        Text="{Binding Title}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock

                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        MaxLines="1"
                                                        Text="{Binding Subtitle}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <Border
                                                    Grid.Column="2"
                                                    Style="{StaticResource StatusPillStyle}"
                                                    VerticalAlignment="Center">
                                                    <TextBlock

                                                        FontSize="12"
                                                        Text="{Binding KindText}" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                        </Popup>
                    </Grid>

                    <StackPanel
                        x:Name="TitleActionButtons"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="6">
                        <Button
                            x:Name="NewbieTutorialButton"
                            Click="NewbieTutorialButton_Click"
                            Width="34" Height="30"
                            Padding="0"
                            BorderThickness="0"
                            Background="Transparent"
                            ToolTipService.ToolTip="新手教程"
                            AutomationProperties.Name="新手教程"
                            TitleBar.IsDragRegion="False"
                            l:Uids.Uid="MainWindow_NewbieTutorialButton">
                            <FontIcon FontSize="14" Glyph="&#xE7BE;" />
                        </Button>

                        <Button
                            x:Name="DownloadQueueButton"
                            Click="DownloadQueueButton_Click"
                            Width="34" Height="30"
                            Padding="0"
                            BorderThickness="0"
                            Background="Transparent"
                            AutomationProperties.Name="下载队列"
                            TitleBar.IsDragRegion="False">
                            <Grid>
                                <FontIcon FontSize="14" Glyph="&#xE896;" />
                                <InfoBadge
                                    x:Name="DownloadQueueBadge"
                                    Value="0"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Right"
                                    Margin="0,-4,-4,0" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </TitleBar.Content>
        </TitleBar>

        <StackPanel Grid.Row="1">
            <controls:UpdateBanner x:Name="UpdateBanner" />
            <InfoBar
                x:Name="ToolUpdateToast"
                IsClosable="True"
                IsOpen="False" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Image
                x:Name="BackgroundImg"
                Stretch="UniformToFill"
                Opacity="0.15"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsHitTestVisible="False" />

            <NavigationView
                x:Name="NavView"
                CompactModeThresholdWidth="0"
                ExpandedModeThresholdWidth="600"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleButtonVisible="False"
                OpenPaneLength="200"
                SelectionChanged="NavView_SelectionChanged">
                <NavigationView.Resources>
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                </NavigationView.Resources>
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="首页" Tag="home" l:Uids.Uid="MainWindow_NavHome"
                                        AutomationProperties.AutomationId="NavHome">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE80F;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="硬件信息" Tag="hardware" l:Uids.Uid="MainWindow_NavHardware">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE977;" FontWeight="Bold" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="内置" Tag="builtin" l:Uids.Uid="MainWindow_NavBuiltin">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE90F;" FontWeight="Bold" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="性能测试" Tag="benchmark" l:Uids.Uid="MainWindow_NavBenchmark">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE9D9;" FontWeight="Bold" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="CommunityNavItem" Content="插件" Tag="community" l:Uids.Uid="MainWindow_NavCommunity">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE779;" FontWeight="Bold" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="AI 助手" Tag="ai-assistant" l:Uids.Uid="MainWindow_NavAiAssistant">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE99A;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>
                <Frame x:Name="NavFrame" CacheSize="10" />
            </NavigationView>
        </Grid>
    </Grid>
</Window>
