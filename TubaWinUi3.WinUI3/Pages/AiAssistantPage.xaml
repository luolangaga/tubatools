<Page x:Class="TubaWinUi3.Pages.AiAssistantPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:agent="using:TubaWinUi3.Services.AiAgent"
      xmlns:l="using:WinUI3Localizer" NavigationCacheMode="Required" FontFamily="Segoe UI Variable Text" FontSize="14"
      Loaded="Page_Loaded" Unloaded="Page_Unloaded" SizeChanged="Page_SizeChanged"
      AllowDrop="True" DragOver="Composer_DragOver" Drop="Composer_Drop">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AgentStroke" Color="#2B2B2B"/>
                    <SolidColorBrush x:Key="AgentComposer" Color="#191919"/>
                    <SolidColorBrush x:Key="AgentSelected" Color="#272727"/>
                    <SolidColorBrush x:Key="AgentHint" Color="#A0A0A0"/>
                    <SolidColorBrush x:Key="AgentUser" Color="#202020"/>
                    <SolidColorBrush x:Key="AgentSend" Color="#404040"/>
                    <SolidColorBrush x:Key="AgentSendText" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#272727"/>
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#303030"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AgentStroke" Color="#E3E3E3"/>
                    <SolidColorBrush x:Key="AgentComposer" Color="#FAFAFA"/>
                    <SolidColorBrush x:Key="AgentSelected" Color="#E8E8E8"/>
                    <SolidColorBrush x:Key="AgentHint" Color="#686868"/>
                    <SolidColorBrush x:Key="AgentUser" Color="#F2F2F2"/>
                    <SolidColorBrush x:Key="AgentSend" Color="#303030"/>
                    <SolidColorBrush x:Key="AgentSendText" Color="#FFFFFF"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="AgentStroke" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="AgentComposer" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="AgentSelected" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="AgentHint" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="AgentUser" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="AgentSend" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="AgentSendText" Color="{ThemeResource SystemColorHighlightTextColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
            <Style x:Key="AgentUserBubble" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AgentUser}"/><Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12,8"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="MaxWidth" Value="720"/>
            </Style>
            <Style x:Key="AgentIconButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="6"/><Setter Property="MinWidth" Value="30"/><Setter Property="MinHeight" Value="26"/>
            </Style>
            <Style x:Key="AgentChoice" TargetType="ComboBox">
                <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
                <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="26"/>
                <Setter Property="Padding" Value="6,0,4,0"/><Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{ThemeResource AgentHint}"/>
            </Style>
            <Style x:Key="AgentHistoryItem" TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="8,5"/>
                <Setter Property="Margin" Value="0,2"/><Setter Property="CornerRadius" Value="6"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FontSize" Value="14"/>
            </Style>
        </ResourceDictionary>
    </Page.Resources>
    <Grid PreviewKeyDown="Page_PreviewKeyDown">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <!-- Full-screen canvas host: part of the page tree so WebView2 re-parenting is reliable. -->
        <Grid x:Name="CanvasOverlayHost" Grid.ColumnSpan="2" Visibility="Collapsed" Canvas.ZIndex="100"
              Background="{ThemeResource LayerFillColorDefaultBrush}"/>
        <Border x:Name="Sidebar" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="12,16,12,16">
            <Grid RowSpacing="24">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid ColumnSpacing="4" MinHeight="40" Padding="10,0,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="图吧工作区" l:Uids.Uid="Agent_WorkspaceTitle" FontSize="14"/>
                        <TextBlock x:Name="WorkspacePathText" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource AgentHint}"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="WorkspaceMenuButton" Style="{StaticResource AgentIconButton}" AutomationProperties.Name="工作区菜单" AutomationProperties.AutomationId="AgentWorkspaceMenu">
                        <FontIcon Glyph="&#xE712;" FontSize="14"/>
                        <Button.Flyout><MenuFlyout>
                            <MenuFlyoutItem Text="打开工作区" l:Uids.Uid="Agent_OpenWorkspace" Click="Workspace_Click"/>
                            <MenuFlyoutItem Text="AI 提供商…" l:Uids.Uid="Agent_ProviderMenu" Click="Providers_Click" AutomationProperties.AutomationId="AgentProviders"/>
                            <MenuFlyoutItem Text="准备 AI 组件" l:Uids.Uid="Agent_PrepareMenu" Click="Prepare_Click"/>
                            <MenuFlyoutItem Text="重新安装 AI 组件" l:Uids.Uid="Agent_Repair" Click="Repair_Click"/>
                        </MenuFlyout></Button.Flyout>
                    </Button>
                </Grid>
                <Button Grid.Row="1" x:Name="NewButton" Height="34" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{ThemeResource AgentComposer}" BorderBrush="{ThemeResource AgentStroke}" Click="New_Click" AutomationProperties.AutomationId="AgentNew" ToolTipService.ToolTip="Ctrl+N">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE70F;" FontSize="13"/><TextBlock Text="新建会话" l:Uids.Uid="Agent_NewLabel" FontSize="13"/></StackPanel>
                </Button>
                <ListView Grid.Row="2" x:Name="HistoryList" Padding="0" SelectionMode="Single" ItemContainerStyle="{StaticResource AgentHistoryItem}" SelectionChanged="History_Changed" ContainerContentChanging="History_ContainerContentChanging" AutomationProperties.AutomationId="AgentHistory">
                    <ListView.ItemTemplate><DataTemplate x:DataType="agent:AgentSessionRow"><TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis"/></DataTemplate></ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
        <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{ThemeResource AgentStroke}" CornerRadius="12,0,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Padding="54,0,24,0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button x:Name="CompactNewButton" Visibility="Collapsed" Style="{StaticResource AgentIconButton}" Click="New_Click" AutomationProperties.Name="新建会话" AutomationProperties.AutomationId="AgentCompactNew"><FontIcon Glyph="&#xE70F;" FontSize="14"/></Button>
                    <TextBlock Grid.Column="1" x:Name="SessionTitleText" Text="新会话" TextTrimming="CharacterEllipsis" FontSize="14" VerticalAlignment="Center"/>
                    <ProgressRing Grid.Column="2" x:Name="RunSpinner" Width="16" Height="16" IsActive="False" Visibility="Collapsed" Foreground="{ThemeResource AgentHint}"/>
                    <Button Grid.Column="3" x:Name="SessionMenuButton" Style="{StaticResource AgentIconButton}" Click="SessionMenu_Click" AutomationProperties.Name="会话菜单" AutomationProperties.AutomationId="AgentSessionMenu"><FontIcon Glyph="&#xE712;" FontSize="14"/></Button>
                </Grid>
                <InfoBar Grid.Row="1" x:Name="NoticeBar" Margin="24,0,24,8" IsOpen="False" IsClosable="True" Severity="Error">
                    <InfoBar.ActionButton><Button x:Name="RetryButton" Content="继续" l:Uids.Uid="Agent_Retry" Click="Retry_Click" AutomationProperties.AutomationId="AgentRetry"/></InfoBar.ActionButton>
                </InfoBar>
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <InfoBar x:Name="CanvasBanner" Margin="24,0,24,8" IsOpen="False" IsClosable="False" Severity="Informational"
                             IsIconVisible="True" Message="教学模式已开启：助手的讲解会作为可交互的「画布消息」出现在对话里。" l:Uids.Uid="Agent_CanvasBanner"/>
                    <Grid Grid.Row="1">
                    <ScrollViewer x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" ViewChanged="Transcript_ViewChanged">
                        <StackPanel Margin="58,16,32,20" MaxWidth="920" HorizontalAlignment="Stretch" Spacing="16">
                            <Button x:Name="OlderButton" Content="显示更早的消息" l:Uids.Uid="Agent_Older" Visibility="Collapsed" Click="Older_Click" HorizontalAlignment="Center" AutomationProperties.AutomationId="AgentOlder"/>
                            <StackPanel x:Name="Transcript" Spacing="22"/>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer x:Name="EmptyState" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center">
                    <StackPanel Spacing="16" MaxWidth="640" Margin="24" VerticalAlignment="Center">
                        <TextBlock Text="从一个任务开始" l:Uids.Uid="Agent_EmptyTitle" FontSize="24" TextWrapping="Wrap" TextAlignment="Center"/>
                        <TextBlock Text="直接描述要开发的功能或遇到的电脑问题，助手会按任务自动加载对应技能。" l:Uids.Uid="Agent_EmptyDescription" Foreground="{ThemeResource AgentHint}" TextWrapping="Wrap" TextAlignment="Center"/>
                        <Button x:Name="PrepareButton" Content="准备 AI 组件" l:Uids.Uid="Agent_Prepare" Click="Prepare_Click" HorizontalAlignment="Center" AutomationProperties.AutomationId="AgentPrepare"/>
                    </StackPanel>
                    </ScrollViewer>
                    <Button x:Name="JumpButton" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" CornerRadius="16" Click="Jump_Click" AutomationProperties.Name="跳到最新消息" AutomationProperties.AutomationId="AgentJump"><FontIcon Glyph="&#xE74B;" FontSize="12"/></Button>
                    </Grid>
                </Grid>
                <Grid Grid.Row="3" x:Name="RunStatus" Visibility="Collapsed" Margin="40,0,40,8" MaxWidth="920">
                    <TextBlock x:Name="RunStatusText" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource AgentHint}" AutomationProperties.AutomationId="AgentRunStatus"/>
                </Grid>
                <Border Grid.Row="4" x:Name="Composer" Margin="48,0,32,0" MaxWidth="920" Background="{ThemeResource AgentComposer}" BorderBrush="{ThemeResource AgentStroke}" BorderThickness="1" CornerRadius="14">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid x:Name="AttachmentSummary" Margin="12,8,8,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled">
                                <StackPanel x:Name="AttachmentItems" Orientation="Horizontal" Spacing="8" AutomationProperties.AutomationId="AgentAttachments"/>
                            </ScrollViewer>
                            <Button Grid.Column="1" x:Name="ClearAttachmentsButton" Style="{StaticResource AgentIconButton}" Click="ClearAttachments_Click" AutomationProperties.Name="清除引用文件" AutomationProperties.AutomationId="AgentClearAttachments"><FontIcon Glyph="&#xE711;" FontSize="10"/></Button>
                        </Grid>
                        <TextBox Grid.Row="1" x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="190" Background="Transparent" BorderThickness="0" Padding="12,12,12,8" PlaceholderText="随便问点什么…" l:Uids.Uid="Agent_ComposerPrompt" AutomationProperties.AutomationId="AgentPrompt" PreviewKeyDown="Prompt_PreviewKeyDown" Paste="Prompt_Paste" TextChanged="Prompt_TextChanged"/>
                        <Grid Grid.Row="2" Margin="8,0,8,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button x:Name="AddContextButton" Style="{StaticResource AgentIconButton}" HorizontalAlignment="Left" AutomationProperties.Name="添加上下文" AutomationProperties.AutomationId="AgentAddContext">
                                <FontIcon Glyph="&#xE710;" FontSize="14"/>
                                <Button.Flyout><MenuFlyout><MenuFlyoutItem Text="引用本地文件…" l:Uids.Uid="Agent_AttachFiles" Click="AttachFiles_Click"/><MenuFlyoutItem Text="打开工作区" l:Uids.Uid="Agent_OpenWorkspace" Click="Workspace_Click"/></MenuFlyout></Button.Flyout>
                            </Button>
                            <Button Grid.Column="1" x:Name="SendButton" Click="Send_Click" Width="32" Height="32" Padding="7" Background="{ThemeResource AgentSend}" Foreground="{ThemeResource AgentSendText}" BorderThickness="0" AutomationProperties.Name="发送" AutomationProperties.AutomationId="AgentSend"><FontIcon Glyph="&#xE74A;" FontSize="14"/></Button>
                            <Button Grid.Column="1" x:Name="StopButton" Visibility="Collapsed" Click="Stop_Click" Width="32" Height="32" Padding="7" Background="{ThemeResource AgentSend}" Foreground="{ThemeResource AgentSendText}" BorderThickness="0" AutomationProperties.Name="停止" AutomationProperties.AutomationId="AgentStop"><FontIcon Glyph="&#xE71A;" FontSize="12"/></Button>
                        </Grid>
                        <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource AgentStroke}" Padding="4,2,4,3">
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="ModelBox" Style="{StaticResource AgentChoice}" DisplayMemberPath="DisplayName" SelectionChanged="Model_Changed" HorizontalAlignment="Left" AutomationProperties.Name="模型" AutomationProperties.AutomationId="AgentModel"/>
                                <ComboBox Grid.Column="1" x:Name="PermissionBox" Style="{StaticResource AgentChoice}" SelectionChanged="Permission_Changed" AutomationProperties.Name="权限模式" AutomationProperties.AutomationId="AgentPermissions"/>
                                <ComboBox Grid.Column="2" x:Name="ModeBox" Style="{StaticResource AgentChoice}" SelectionChanged="Mode_Changed" HorizontalAlignment="Left" AutomationProperties.Name="交互模式" AutomationProperties.AutomationId="AgentMode"/>
                                <Button Grid.Column="4" x:Name="CanvasButton" Style="{StaticResource AgentIconButton}" Visibility="Collapsed" Click="CanvasToggle_Click" AutomationProperties.Name="画布" AutomationProperties.AutomationId="AgentCanvasToggle">
                                    <FontIcon Glyph="&#xE7F4;" FontSize="13"/>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
