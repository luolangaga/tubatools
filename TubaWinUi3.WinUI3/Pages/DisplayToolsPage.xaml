<Page x:Class="TubaWinUi3.Pages.DisplayToolsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluentIcons="using:TubaWinUi3.Controls" Background="{ThemeResource LayerFillColorDefaultBrush}">
 <Page.Resources>
  <Style x:Key="DisplayCard" TargetType="Border"><Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="24"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 </Page.Resources>
 <Grid Padding="28,24,28,0" RowSpacing="16" SizeChanged="Layout_Changed">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid ColumnSpacing="16">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Spacing="4"><TextBlock Text="屏幕工具" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="显示器信息与画质检测" Style="{StaticResource Muted}"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
    <Button Click="Copy_Click" AutomationProperties.AutomationId="DisplayCopyReport" ToolTipService.ToolTip="复制检测报告"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8C8;" FontSize="16"/><TextBlock Text="复制报告"/></StackPanel></Button>
    <Button Click="Refresh_Click" x:Name="RefreshButton" AutomationProperties.AutomationId="DisplayRefresh" AutomationProperties.Name="刷新显示器信息" ToolTipService.ToolTip="刷新显示器信息"><FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE72C;" FontSize="16"/></Button>
   </StackPanel>
  </Grid>
  <ComboBox Grid.Row="1" x:Name="DisplayPicker" HorizontalAlignment="Stretch" SelectionChanged="Display_Changed" AutomationProperties.Name="选择显示器" AutomationProperties.AutomationId="DisplayPicker"/>
  <InfoBar Grid.Row="2" x:Name="Status" IsOpen="False" IsClosable="True"/>
  <Grid Grid.Row="3" x:Name="Details" Visibility="Collapsed">
   <Grid RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><SelectorBar x:Name="DisplayTabs" SelectionChanged="Tab_Changed" AutomationProperties.AutomationId="DisplayTabs"><SelectorBarItem Text="显示概览" Tag="overview" IsSelected="True" AutomationProperties.AutomationId="DisplayOverviewTab"/><SelectorBarItem Text="屏幕检测" Tag="tests" AutomationProperties.AutomationId="DisplayTestsTab"/><SelectorBarItem Text="颜色管理" Tag="color" AutomationProperties.AutomationId="DisplayColorTab"/></SelectorBar>
    <Grid x:Name="OverviewView" Grid.Row="1">
     <ScrollViewer x:Name="OverviewScroll" HorizontalScrollBarVisibility="Disabled" Padding="0,8,0,24" AutomationProperties.AutomationId="DisplayOverviewScroll">
      <StackPanel Spacing="16">
       <Border Style="{StaticResource DisplayCard}">
        <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <FontIcon Glyph="&#xE7F4;" FontSize="48" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
         <StackPanel Grid.Column="1" Spacing="8"><TextBlock x:Name="MonitorName" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/><TextBlock x:Name="MonitorMode" Style="{StaticResource Muted}"/></StackPanel>
         <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4"><TextBlock Text="缩放" Style="{StaticResource Muted}"/><TextBlock x:Name="MonitorScale" Style="{StaticResource BodyStrongTextBlockStyle}"/></StackPanel>
        </Grid>
       </Border>
       <Grid x:Name="OverviewColumns" ColumnSpacing="16" RowSpacing="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel x:Name="LeftColumn" Spacing="16">
        <Border x:Name="InformationCard" Style="{StaticResource DisplayCard}" VerticalAlignment="Top">
         <StackPanel Spacing="20">
          <StackPanel Spacing="4"><TextBlock Text="显示器规格" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock Text="规格与连接信息" Style="{StaticResource Muted}"/></StackPanel>
          <StackPanel x:Name="InfoRows" Spacing="12"/>
          <Expander Header="全部设备参数" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="DisplayInfo"><StackPanel x:Name="TechnicalRows" Spacing="12"/></Expander>
         </StackPanel>
        </Border>
        <Border Style="{StaticResource DisplayCard}">
         <StackPanel Spacing="12"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE9D9;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock Text="一句话看懂" Style="{StaticResource BodyStrongTextBlockStyle}"/></StackPanel><TextBlock x:Name="GamutSummary" TextWrapping="Wrap" LineHeight="24"/><TextBlock Text="仅分析声明色域范围，不代表色准、亮度或 HDR 效果。" Style="{StaticResource Muted}" FontSize="12"/></StackPanel>
        </Border>
       <Expander x:Name="HdrExpander" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="DisplayHdr">
        <Expander.Header><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE793;" FontSize="24" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="HDR 与输出信号" Style="{StaticResource BodyStrongTextBlockStyle}"/><TextBlock x:Name="HdrSummary" Style="{StaticResource Muted}"/></StackPanel></Grid></Expander.Header>
        <StackPanel Spacing="16"><StackPanel x:Name="HdrRows" Spacing="12"/><TextBlock Text="亮度来自系统 / EDID 声明。参考档位仅比较峰值门槛，不代表 VESA DisplayHDR 认证。" Style="{StaticResource Muted}"/><Button Content="Windows 显示设置" Click="Settings_Click" AutomationProperties.AutomationId="DisplaySettings"/></StackPanel>
       </Expander>
        </StackPanel>
        <Border x:Name="ColorCard" Grid.Column="1" Style="{StaticResource DisplayCard}" VerticalAlignment="Top">
         <StackPanel Spacing="16">
          <Grid><TextBlock Text="色域表现" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock Text="CIE 1931 xy" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Muted}"/></Grid>
          <Viewbox MaxWidth="340" HorizontalAlignment="Center" Stretch="Uniform"><Canvas x:Name="GamutCanvas" Width="460" Height="460" AutomationProperties.Name="CIE 1931 xy 色度图"/></Viewbox>
          <TextBlock Text="实线 本屏  ·  虚线 参考色域  ·  圆点 白点" Style="{StaticResource Muted}" FontSize="12"/>
          <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><TextBlock Text="参考色域" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="覆盖率" HorizontalAlignment="Right" Style="{StaticResource Muted}"/><TextBlock Grid.Column="2" Text="面积比" HorizontalAlignment="Right" Style="{StaticResource Muted}"/></Grid>
          <StackPanel x:Name="GamutRows" Spacing="12"/>
          <TextBlock Text="依据 EDID / 驱动声明计算，非仪器实测。" Style="{StaticResource Muted}" FontSize="12"/>
         </StackPanel>
        </Border>
       </Grid>

      </StackPanel>
     </ScrollViewer>
    </Grid>
    <Grid x:Name="TestView" Grid.Row="1" Visibility="Collapsed">
     <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="0,8,0,24">
      <StackPanel Spacing="24" MaxWidth="760" HorizontalAlignment="Left">
       <StackPanel Spacing="8"><TextBlock Text="检查屏幕显示效果" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock Text="用纯色检查坏点，用渐变检查色阶。测试将在上方选定的显示器中全屏打开。" Style="{StaticResource Muted}"/></StackPanel>
       <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="32" HorizontalAlignment="Stretch">
        <StackPanel Spacing="20"><Border CornerRadius="6" BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}" BorderThickness="4" MaxWidth="400" Height="180"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#E85757"/><Border Grid.Column="1" Background="#E9BC58"/><Border Grid.Column="2" Background="#75BD84"/><Border Grid.Column="3" Background="#62BDBA"/><Border Grid.Column="4" Background="#609BD5"/><Border Grid.Column="5" Background="#A988CC"/><Border Grid.Column="6" Background="#EAEAEA"/></Grid></Border><TextBlock Text="纯色 / 漏光 / 对比度 / 色阶 / 网格" HorizontalAlignment="Center" Style="{StaticResource Muted}"/></StackPanel>
       </Border>
       <ComboBox x:Name="TestPicker" Header="1. 选择测试项目" HorizontalAlignment="Stretch" SelectedIndex="0" AutomationProperties.AutomationId="DisplayTestPattern">
        <ComboBoxItem Content="坏点测试 · 循环纯色画面" Tag="0"/><ComboBoxItem Content="漏光测试 · 纯黑画面" Tag="8"/><ComboBoxItem Content="亮部对比度" Tag="13"/><ComboBoxItem Content="暗部对比度" Tag="14"/><ComboBoxItem Content="色阶渐变 · 灰 / 红 / 绿 / 蓝" Tag="15"/><ComboBoxItem Content="饱和度" Tag="19"/><ComboBoxItem Content="网格" Tag="20"/><ComboBoxItem Content="棋盘格" Tag="21"/>
       </ComboBox>
       <StackPanel Spacing="8"><TextBlock Text="2. 清洁屏幕，开始观察" Style="{StaticResource BodyStrongTextBlockStyle}"/><TextBlock Text="← → 或空格切换画面，Esc 退出。建议从正面观察；漏光测试可适当调暗室内光线。" Style="{StaticResource Muted}"/></StackPanel>
       <Button Content="开始全屏检测" Style="{StaticResource AccentButtonStyle}" Click="Test_Click" Padding="24,10" AutomationProperties.AutomationId="DisplayStartTest"/>
      </StackPanel>
     </ScrollViewer>
    </Grid>
    <Grid x:Name="ProfileView" Grid.Row="1" Visibility="Collapsed">
     <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="0,8,0,24">
      <StackPanel Spacing="20">
       <StackPanel Spacing="4"><TextBlock Text="把颜色调成你喜欢的样子" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock Text="直接调整上方所选屏幕，或为它选择颜色配置。" Style="{StaticResource Muted}"/></StackPanel>
       <InfoBar x:Name="ColorCapability" IsOpen="False" IsClosable="False" Severity="Informational"/>
       <Grid x:Name="ColorSettingsColumns" ColumnSpacing="16" RowSpacing="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource DisplayCard}" VerticalAlignment="Top">
         <StackPanel Spacing="20">
          <Grid><TextBlock Text="滤镜与微调" Style="{StaticResource SubtitleTextBlockStyle}"/><Button Content="重置参数" Click="ResetColorValues_Click" HorizontalAlignment="Right" Style="{StaticResource SubtleButtonStyle}" AutomationProperties.AutomationId="DisplayResetColorValues"/></Grid>
          <ContentControl x:Name="ColorEditor" HorizontalContentAlignment="Stretch"><StackPanel Spacing="16">
           <ComboBox x:Name="ColorPreset" Header="滤镜预设" HorizontalAlignment="Stretch" SelectionChanged="ColorPreset_Changed" AutomationProperties.AutomationId="DisplayColorPreset"><ComboBoxItem Content="原色" Tag="neutral"/><ComboBoxItem Content="暖色 · 降低冷色感" Tag="warm"/><ComboBoxItem Content="冷色 · 清爽色调" Tag="cool"/><ComboBoxItem Content="柔和 · 降低反差" Tag="soft"/><ComboBoxItem Content="明亮 · 提亮中间调" Tag="bright"/><ComboBoxItem Content="高对比 · 增强明暗层次" Tag="contrast"/></ComboBox>
           <StackPanel x:Name="BasicColorControls" Spacing="16"/>
           <Expander Header="Gamma 与 RGB 通道" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="DisplayAdvancedColorControls"><StackPanel x:Name="AdvancedColorControls" Spacing="16"/></Expander>
          </StackPanel></ContentControl>
          <TextBlock x:Name="ColorEffectStatus" Text="参数尚未应用" Style="{StaticResource Muted}"/>
          <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="ApplyColorButton" Content="应用到所选屏幕" Click="ApplyColor_Click" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="DisplayApplyColor"/><Button x:Name="RestoreColorButton" Content="恢复原始效果" Click="RestoreColor_Click" AutomationProperties.AutomationId="DisplayRestoreColor"/></StackPanel>
          <TextBlock Text="先预览 20 秒，确认后保留到工具箱退出；未确认会自动恢复。亮度调整改变画面输出，不调节屏幕背光。" Style="{StaticResource Muted}" FontSize="12"/>
         </StackPanel>
        </Border>
        <Border x:Name="ProfileSettingsCard" Grid.Column="1" Style="{StaticResource DisplayCard}" VerticalAlignment="Top">
         <StackPanel Spacing="20">
          <StackPanel Spacing="4"><TextBlock Text="颜色配置" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock Text="自动发现已安装的显示器配置，也可按屏幕声明生成原生配置。" Style="{StaticResource Muted}"/></StackPanel>
          <StackPanel Spacing="8"><TextBlock Text="当前配置" Style="{StaticResource BodyStrongTextBlockStyle}"/><TextBlock x:Name="ProfileName" TextWrapping="Wrap" IsTextSelectionEnabled="True"/><TextBlock x:Name="ProfileDetails" TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="12"/></StackPanel>
          <ComboBox x:Name="ColorProfilePicker" Header="选择颜色配置" HorizontalAlignment="Stretch" SelectionChanged="ColorProfile_Changed" AutomationProperties.AutomationId="DisplayColorProfilePicker"/>
          <TextBlock x:Name="ProfileChoiceDescription" TextWrapping="Wrap" Style="{StaticResource Muted}"/>
          <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="ApplyProfileButton" Content="应用配置" Click="ApplyProfile_Click" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="DisplayApplyProfile"/><Button x:Name="RestoreProfileButton" Content="撤销配置更改" Click="RestoreProfile_Click" AutomationProperties.AutomationId="DisplayRestoreProfile"/></StackPanel>
          <Expander Header="了解颜色配置" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="DisplayProfileHelp"><TextBlock Text="配置会保存为当前用户的默认 SDR 显示配置，退出工具箱后仍然有效。&#10;&#10;原生配置由 EDID 三原色、白点和 Gamma 生成，属于估算的色彩描述，不是仪器校准。标准 sRGB 适合本身接近 sRGB 的屏幕，不能把广色域屏幕强制限制为 sRGB。&#10;&#10;ICC 主要影响支持色彩管理的程序，部分程序需要重新打开才能读取新配置。" TextWrapping="Wrap"/></Expander>
         </StackPanel>
        </Border>
       </Grid>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Grid>
  </Grid>
 </Grid>
</Page>
