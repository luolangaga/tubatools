<Page x:Class="TubaWinUi3.Pages.SteamToolboxPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI" xmlns:local="using:TubaWinUi3.Pages" xmlns:s="using:TubaWinUi3.Services" xmlns:c="using:TubaWinUi3.Controls">
 <Page.Resources>
  <CollectionViewSource x:Name="LibrarySource" IsSourceGrouped="True" ItemsPath="Games"/>
 </Page.Resources>
 <Grid x:Name="PageViewport" SizeChanged="PageViewport_SizeChanged"><Grid x:Name="PageSurface" HorizontalAlignment="Center"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <c:ToolPageHeader ToolId="steam-toolbox" Title="Steam 工具箱" Glyph="&#xE7FC;" HeaderPadding="24,12,24,8" BackRequested="Back_Click"/>
  <InfoBar x:Name="Notice" Grid.Row="1" Margin="24,0,24,8" IsOpen="False" IsClosable="True"/>
  <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <SelectorBar x:Name="WorkspaceTabs" SelectionChanged="WorkspaceTabs_SelectionChanged" Margin="24,0,24,8"><SelectorBarItem x:Name="CollectionTab" Text="我的收藏" IsSelected="True"/><SelectorBarItem x:Name="IdleTab" Text="挂卡与时长"/><SelectorBarItem x:Name="AccelerationTab" Text="网站加速"/></SelectorBar>
   <Grid x:Name="CollectionPanel" Grid.Row="1"><GridView x:Name="GamesView" SizeChanged="Games_SizeChanged" Padding="24,8,24,24" SelectionMode="None" IsItemClickEnabled="False" ItemsSource="{Binding Source={StaticResource LibrarySource}}" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="SteamControl1">
   <GridView.Header>
    <StackPanel x:Name="HeaderPanel" Spacing="20" HorizontalAlignment="Stretch" Margin="0,0,0,16">
     <Border Padding="24" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel Spacing="8"><TextBlock Text="游戏收藏" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE7FC;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock x:Name="GameCount" Text="—" Style="{StaticResource TitleTextBlockStyle}"/></StackPanel></StackPanel>
       <StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="磁盘占用" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xEDA2;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock x:Name="TotalSize" Text="—" Style="{StaticResource TitleTextBlockStyle}"/></StackPanel></StackPanel>
       <StackPanel Grid.Column="2" Spacing="8"><TextBlock Text="Steam 账号" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE77B;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock x:Name="AccountCount" Text="—" Style="{StaticResource TitleTextBlockStyle}"/></StackPanel></StackPanel>
      </Grid>
     </Border>
     <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <FontIcon Glyph="&#xE8B7;" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="STEAM 安装目录" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="InstallPath" Text="正在检测…" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True"/></StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"><Button Content="更改目录" Click="Locate_Click" AutomationProperties.AutomationId="SteamLocate"/><Button x:Name="RefreshButton" Click="Refresh_Click" AutomationProperties.AutomationId="SteamRefresh" ToolTipService.ToolTip="重新扫描账号与游戏"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="14"/><TextBlock Text="刷新"/></StackPanel></Button></StackPanel>
     </Grid>
     <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Visibility="Collapsed"/>
     <StackPanel Spacing="4"><TextBlock Text="你的账号" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock Text="这台电脑上登录过的 Steam 账号" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
     <ItemsControl x:Name="AccountsView">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="340" ItemHeight="192"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate x:DataType="s:SteamAccount">
       <Border Padding="20" Margin="0,0,12,12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><PersonPicture Width="48" Height="48" DisplayName="{x:Bind Name}" ProfilePicture="{x:Bind Avatar}"/><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{x:Bind Name}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind Login}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel></Grid>
         <TextBlock Grid.Row="1" Text="{x:Bind Id}" FontFamily="Consolas" FontSize="12" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
         <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Status}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><Button Grid.Column="1" Content="&#xE8A7;" FontFamily="Segoe Fluent Icons" Tag="{x:Bind Id}" Click="Profile_Click" AutomationProperties.Name="打开 Steam 个人主页" Style="{StaticResource SubtleButtonStyle}"/></Grid>
        </Grid>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <TextBlock x:Name="AccountEmpty" Visibility="Collapsed" Text="还没有本机账号记录，登录 Steam 后刷新即可。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <TextBlock Text="封面优先使用本机缓存，缺失时从 Steam CDN 加载。时长来自最近账号的本机记录。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <TextBlock Text="已安装游戏" FontSize="20" FontWeight="SemiBold"/>
     <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" Header="搜索游戏" PlaceholderText="名称或 AppID" TextChanged="Filter_Changed" AutomationProperties.AutomationId="SteamControl18"/><ComboBox Grid.Column="1" x:Name="SortBox" Header="排序" SelectedIndex="0" SelectionChanged="Sort_Changed" AutomationProperties.AutomationId="SteamControl19"><ComboBoxItem Content="名称"/><ComboBoxItem Content="占用从大到小"/></ComboBox></Grid>
     <TextBlock x:Name="EmptyText" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
   </GridView.Header>
   <GridView.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate x:DataType="s:SteamLibrary"><TextBlock Text="{x:Bind Header}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="4,20,0,12"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></GridView.GroupStyle>
   <GridView.ItemTemplate><DataTemplate x:DataType="s:SteamGame">
    <Border Width="270" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,8,12">
     <StackPanel>
      <Grid Height="126" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><FontIcon Glyph="&#xE7FC;" FontSize="44" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><Image Source="{x:Bind Art}" Stretch="UniformToFill" AutomationProperties.Name="游戏封面"/></Grid>
      <StackPanel Padding="14" Spacing="8">
       <TextBlock Text="{x:Bind Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}"/>
       <TextBlock Text="{x:Bind Details}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       <TextBlock Text="{x:Bind Playtime}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="更新于" FontSize="12"/><TextBlock Text="{x:Bind Updated}" FontSize="12"/><TextBlock Text="{x:Bind State}" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/></StackPanel>
       <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="▷ 启动" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Tag="{x:Bind AppId}" Click="Launch_Click" IsEnabled="{x:Bind Installed}" AutomationProperties.AutomationId="SteamControl22"/><Button Grid.Column="1" Content="挂时长" Tag="{x:Bind AppId}" Click="Idle_Click" AutomationProperties.AutomationId="SteamControl23"/><Button Grid.Column="2" Content="&#xE712;" FontFamily="Segoe Fluent Icons" AutomationProperties.Name="游戏操作" AutomationProperties.AutomationId="SteamControl24"><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="打开游戏文件夹" Tag="{x:Bind Folder}" Click="Folder_Click"/><MenuFlyoutItem Text="Steam 商店页面" Tag="{x:Bind AppId}" Click="Store_Click"/></MenuFlyout></Button.Flyout></Button></Grid>
      </StackPanel>
     </StackPanel>
    </Border>
   </DataTemplate></GridView.ItemTemplate>
  </GridView></Grid>
  <ScrollViewer x:Name="IdleScroll" Grid.Row="1" Visibility="Collapsed" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Center" SizeChanged="Body_SizeChanged"><StackPanel x:Name="IdleContent" Padding="24,16,24,32" Spacing="20" HorizontalAlignment="Center">
   <StackPanel Spacing="4"><TextBlock Text="挂卡与游戏时长" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock Text="登录账号 → 选择游戏 → 查看当前任务。" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
   <Border x:Name="CurrentTaskCard" Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1">
    <StackPanel Spacing="16">
     <TextBlock x:Name="CurrentTaskTitle" Text="当前没有挂时长任务" FontSize="18" FontWeight="SemiBold"/>
     <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border x:Name="CurrentArtPanel" Width="136" Height="64" CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><Grid><FontIcon Glyph="&#xE7FC;"/><Image x:Name="CurrentTaskArt" Stretch="UniformToFill" AutomationProperties.Name="当前挂时长游戏封面"/></Grid></Border>
      <StackPanel Grid.Column="1" Spacing="4"><TextBlock x:Name="CurrentTaskName" Text="选择游戏开始挂时长" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="CurrentTaskAppId" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="CurrentTaskAccount" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
     </Grid>
     <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Spacing="4"><TextBlock Text="开始时间" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="CurrentTaskStarted" Text="—" TextWrapping="Wrap"/></StackPanel>
      <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="本次累计运行" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="CurrentTaskElapsed" Text="00:00:00" FontFamily="Consolas" FontSize="22"/></StackPanel>
     </Grid>
     <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="PauseIdleButton" Content="暂停" Click="PauseIdle_Click" AutomationProperties.AutomationId="SteamCurrentPause"/><Button x:Name="StopIdleButton" Content="停止任务" Click="StopIdle_Click" AutomationProperties.AutomationId="SteamCurrentStop"/><Button x:Name="LogoutIdleButton" Content="退出账号" Click="Logout_Click"/></StackPanel>
     <TextBlock Text="此处计时表示工具箱会话运行时间，暂停和断线时不累计；Steam 实际入账时长及掉卡以服务器为准。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
   </Border>
   <Border x:Name="LoginForm" Padding="24" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
    <StackPanel Spacing="16">
     <TextBlock Text="登录 Steam" FontSize="18" FontWeight="SemiBold"/>
     <Grid x:Name="LoginColumns" ColumnSpacing="32" RowSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="248"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel x:Name="CredentialFields" Spacing="12" HorizontalAlignment="Left"><TextBox x:Name="SteamUsername" Header="账号名称" PlaceholderText="Steam 登录账号，非昵称" AutomationProperties.AutomationId="SteamUsername"/><PasswordBox x:Name="SteamPassword" Header="密码" AutomationProperties.AutomationId="SteamPassword"/><CheckBox x:Name="PreferGuardCode" Content="使用手机令牌码验证"/><Button Content="账号密码登录" Click="PasswordLogin_Click" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="SteamPasswordLogin"/></StackPanel>
      <StackPanel x:Name="QrLoginPanel" Grid.Column="1" Spacing="12" Width="240" HorizontalAlignment="Left"><FontIcon Glyph="&#xED14;" FontSize="32" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock Text="手机扫码，更轻松" FontWeight="SemiBold"/><Button Content="生成登录二维码" Click="Login_Click" AutomationProperties.AutomationId="SteamLogin"/><Image x:Name="LoginQr" Width="180" Height="180" Visibility="Collapsed" AutomationProperties.Name="Steam 登录二维码"/><TextBlock Text="用 Steam 手机客户端扫码并确认" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
     </Grid>
     <StackPanel x:Name="GuardPanel" Visibility="Collapsed" Spacing="8"><TextBlock x:Name="GuardPrompt" TextWrapping="Wrap"/><TextBox x:Name="GuardCode" Header="Steam Guard 验证码" MaxLength="10" AutomationProperties.AutomationId="SteamGuardCode"/><Button Content="提交验证码" Click="GuardSubmit_Click" AutomationProperties.AutomationId="SteamGuardSubmit"/></StackPanel>
     <InfoBar x:Name="IdleStateBar" IsOpen="True" IsClosable="False" Severity="Informational"><TextBlock x:Name="IdleStatus" Text="尚未登录挂卡会话" TextWrapping="Wrap"/></InfoBar>
     <TextBlock Text="密码和会话凭据仅保留在内存中，不保存到设置。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
   </Border>
   <Border x:Name="GameSelectionCard" Padding="24" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel Spacing="16">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="选择要挂时长的游戏" FontSize="18" FontWeight="SemiBold"/><Button Grid.Column="1" Content="刷新账号资料" Click="RefreshOnline_Click"/></Grid>
    <TextBlock x:Name="OnlineProfile" Text="登录后可查看账号资料、拥有的游戏与好友。" TextWrapping="Wrap"/>
    <StackPanel Spacing="8"><ComboBox x:Name="OwnedGamePicker" Header="账号游戏库（包含未安装的游戏）" DisplayMemberPath="Display" HorizontalAlignment="Stretch"/><Button x:Name="StartOwnedIdleButton" Content="挂所选游戏" Click="OwnedIdle_Click" AutomationProperties.AutomationId="SteamOwnedIdleStart"/></StackPanel>
    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><NumberBox x:Name="IdleAppId" Header="手动指定 AppID" Minimum="1" Maximum="4294967295" SpinButtonPlacementMode="Compact" AutomationProperties.AutomationId="SteamIdleAppId"/><Button x:Name="StartManualIdleButton" Grid.Column="1" Content="挂此 AppID" VerticalAlignment="Bottom" Click="ManualIdle_Click" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="SteamIdleStart"/></Grid>
    <TextBlock Text="在其他客户端开始游戏时会让出会话。关闭本页后继续运行，退出工具箱后停止。时长和掉卡资格以 Steam 为准。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <Expander Header="好友" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><ListView x:Name="FriendsView" MaxHeight="280" SelectionMode="None" DisplayMemberPath="Display"/></Expander>
   </StackPanel></Border>
  </StackPanel></ScrollViewer>
  <ScrollViewer x:Name="SitesScroll" Grid.Row="1" Visibility="Collapsed" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Center" SizeChanged="Body_SizeChanged"><StackPanel x:Name="SitesContent" Padding="24,16,24,32" Spacing="20" HorizontalAlignment="Center">
   <StackPanel x:Name="NetworkConfiguration" Spacing="20">
   <Border Padding="24" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel Spacing="16">
    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE774;" FontSize="32" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="连接你的常用网站" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock x:Name="AccelerationStatus" Text="加速未开启" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><Button Grid.Column="2" x:Name="StartAcceleration" Content="开启加速" Click="StartAcceleration_Click" Style="{StaticResource AccentButtonStyle}"/></Grid>
    <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="StopAcceleration" Content="停止并还原" Click="StopAcceleration_Click"/><Button x:Name="ProbeButton" Content="检测连通性" Click="Probe_Click"/><Button Content="全选网站" Click="SelectAllSites_Click" AutomationProperties.AutomationId="SteamSitesSelectAll"/><Button Content="清空选择" Click="ClearSites_Click"/></StackPanel>
    <TextBlock Text="开启后自动配置所选域名的本机 Hosts 和信任证书，停止时还原。仅优化网站访问，不加速游戏对战。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <TextBlock x:Name="ProbeResult" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
   </StackPanel></Border>
   <TextBox x:Name="SiteSearch" PlaceholderText="搜索网站或域名" Header="选择要加速的网站" TextChanged="SiteSearch_Changed"/>
   <TextBlock x:Name="SelectionLabel" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock x:Name="CatalogLabel" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
   <ItemsControl x:Name="SiteGroups"><ItemsControl.ItemTemplate><DataTemplate x:DataType="s:SteamAccelerationGroup"><StackPanel Spacing="12" Margin="0,0,0,24">
    <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="{x:Bind Glyph}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock Text="{x:Bind Name}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{x:Bind CountLabel}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/></StackPanel>
    <ItemsControl ItemsSource="{x:Bind Rules}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="300" ItemHeight="88"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="s:SteamAccelerationRule">
     <Border Padding="12" Margin="0,0,12,12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" ToolTipService.ToolTip="{x:Bind DomainSummary}"><CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind Available}" HorizontalAlignment="Stretch"><StackPanel Spacing="4"><TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind Details}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></CheckBox></Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel>
   <StackPanel x:Name="NetworkDashboard" Visibility="Collapsed" Spacing="20">
    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Spacing="4"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE73E;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock Text="网络加速已开启" Style="{StaticResource SubtitleTextBlockStyle}"/></StackPanel><TextBlock x:Name="NetworkUptime" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
     <Button x:Name="DashboardStopButton" Grid.Column="1" Content="停止并返回配置" Click="StopAcceleration_Click" VerticalAlignment="Center" AutomationProperties.AutomationId="SteamNetworkStop"/>
    </Grid>
    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel Spacing="8"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE896;" Foreground="{ThemeResource DataSeries3Brush}"/><TextBlock Text="实时下载" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><TextBlock x:Name="NetworkDownloadRate" Text="0 B/s" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="NetworkDownloadTotal" Text="累计下载 0 B" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Border>
     <Border Grid.Column="1" Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel Spacing="8"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE898;" Foreground="{ThemeResource DataSeries1Brush}"/><TextBlock Text="实时上传" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><TextBlock x:Name="NetworkUploadRate" Text="0 B/s" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="NetworkUploadTotal" Text="累计上传 0 B" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Border>
    </Grid>
    <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel Spacing="16">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="流量趋势" FontSize="18" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="最近 60 秒" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid>
     <lvc:CartesianChart x:Name="ProxyTrafficChart" Background="Transparent" Height="220" AutomationProperties.Name="最近一分钟代理上传和下载速率图"/>
     <StackPanel Orientation="Horizontal" Spacing="24"><TextBlock Text="↓ 下载" Foreground="{ThemeResource DataSeries3Brush}"/><TextBlock Text="↑ 上传" Foreground="{ThemeResource DataSeries1Brush}"/><TextBlock x:Name="NetworkRequestCounts" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
    </StackPanel></Border>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="当前连接与近期活动" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock Grid.Column="1" x:Name="NetworkConnectionCount" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid>
    <TextBlock x:Name="NetworkEmpty" Text="等待网站连接。打开已勾选的网站后，流量和连接会显示在这里。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <ListView x:Name="NetworkConnections" MaxHeight="360" SelectionMode="None" HorizontalContentAlignment="Stretch" AutomationProperties.Name="加速器连接列表"><ListView.ItemTemplate><DataTemplate x:DataType="local:SteamConnectionRow"><Grid Padding="4,10" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock Text="{x:Bind Host, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind Detail, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Right"><TextBlock Text="{x:Bind Download, Mode=OneWay}"/><TextBlock Text="{x:Bind Upload, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Grid></DataTemplate></ListView.ItemTemplate></ListView>
