<UserControl
    x:Class="TubaWinUi3.Pages.WifiPasswordView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:TubaWinUi3.Services">
    <Grid x:Name="Root" Margin="28,0,28,24" RowSpacing="16" Loaded="View_Loaded" Unloaded="View_Unloaded" SizeChanged="Root_SizeChanged">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Narrow">
                    <VisualState.Setters>
                        <Setter Target="DetailColumn.Width" Value="0"/>
                        <Setter Target="DetailRow.Height" Value="0"/><Setter Target="DetailPanel.Visibility" Value="Collapsed"/><Setter Target="DetailsButton.Visibility" Value="Visible"/>
                        <Setter Target="DetailPanel.(Grid.Row)" Value="1"/>
                        <Setter Target="DetailPanel.(Grid.Column)" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    
                    <VisualState.Setters>
                        <Setter Target="DetailColumn.Width" Value="340"/><Setter Target="DetailPanel.Visibility" Value="Visible"/><Setter Target="DetailsButton.Visibility" Value="Collapsed"/>
                        <Setter Target="DetailRow.Height" Value="0"/>
                        <Setter Target="DetailPanel.(Grid.Row)" Value="0"/>
                        <Setter Target="DetailPanel.(Grid.Column)" Value="1"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Pivot x:Name="Sections" Margin="0,4,0,0" SelectionChanged="Sections_SelectionChanged">
            <PivotItem Header="WiFi 网络" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid RowSpacing="16" Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20,16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE701;" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock x:Name="ConnectionTitle" Text="正在读取 WiFi 网络…" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="Summary" Text="密码默认隐藏，仅在本机读取" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="2" x:Name="RefreshButton" AutomationProperties.AutomationId="WifiRefreshButton" Click="Refresh_Click" ToolTipService.ToolTip="重新读取网络" AutomationProperties.Name="刷新网络"><FontIcon Glyph="&#xE72C;" FontSize="16"/></Button>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <AutoSuggestBox Header="查找网络" x:Name="Search" AutomationProperties.AutomationId="WifiSearch" PlaceholderText="搜索网络名称或安全协议" QueryIcon="Find" TextChanged="Search_Changed" AutomationProperties.Name="搜索已保存的 WiFi 网络"/>
                        <Grid Grid.Row="1" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="Filter" AutomationProperties.AutomationId="WifiFilter" SelectedIndex="0" SelectionChanged="Options_Changed" HorizontalAlignment="Stretch" AutomationProperties.Name="筛选网络">
                                <ComboBoxItem Content="全部网络"/><ComboBoxItem Content="当前连接"/><ComboBoxItem Content="有可读密码"/><ComboBoxItem Content="开放网络"/>
                            </ComboBox>
                            <ComboBox Grid.Column="1" x:Name="Sort" AutomationProperties.AutomationId="WifiSort" SelectedIndex="0" SelectionChanged="Options_Changed" AutomationProperties.Name="网络排序">
                                <ComboBoxItem Content="已连接优先"/><ComboBoxItem Content="名称 A → Z"/><ComboBoxItem Content="名称 Z → A"/>
                            </ComboBox>
                        </Grid>
                        <Button Grid.Row="2" x:Name="DetailsButton" Content="查看所选网络详情与密码" Click="Details_Click" HorizontalAlignment="Stretch" Visibility="Collapsed"/>
                    </Grid>
                    <Grid Grid.Row="2" ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailColumn" Width="340"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="DetailRow" Height="0"/></Grid.RowDefinitions>
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock x:Name="ResultCount" Text="已保存的网络" FontWeight="SemiBold"/>
                            <ListView Grid.Row="1" x:Name="Networks" AutomationProperties.AutomationId="WifiNetworks" SelectionMode="Single" SelectionChanged="Network_Selected" HorizontalContentAlignment="Stretch" AutomationProperties.Name="已保存的网络">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="services:WifiNetwork">
                                        <Grid Padding="8,12" ColumnSpacing="14">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE701;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            <StackPanel Grid.Column="1" Spacing="5">
                                                <TextBlock Text="{x:Bind Ssid, Mode=OneTime}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{x:Bind SecurityLabel, Mode=OneTime}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{x:Bind Status, Mode=OneTime}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Grid.Row="1" x:Name="Empty" Visibility="Collapsed" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE721;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="EmptyText" Text="没有匹配的网络" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ProgressRing Grid.Row="1" x:Name="LoadingRing" IsActive="False" Visibility="Collapsed" Width="32" Height="32"/>
                        </Grid>
                        <Border x:Name="DetailPanel" Grid.Column="1" Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="网络详情" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock x:Name="DetailName" Text="选择一个网络" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <StackPanel x:Name="DetailContent" Spacing="16" Visibility="Collapsed">
                                        <TextBlock x:Name="DetailStatus" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="WiFi 密码" FontWeight="SemiBold"/>
                                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Password" IsReadOnly="True" AutomationProperties.Name="已保存的 WiFi 密码"/><ToggleButton Grid.Column="1" x:Name="Reveal" AutomationProperties.AutomationId="WifiReveal" Click="Reveal_Click" ToolTipService.ToolTip="显示或隐藏密码" AutomationProperties.Name="显示密码"><FontIcon Glyph="&#xE890;" FontSize="16"/></ToggleButton></Grid>
                                            <TextBlock x:Name="PasswordHint" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <Button x:Name="CopyPassword" AutomationProperties.AutomationId="WifiCopyPassword" Content="复制密码" Click="CopyPassword_Click" HorizontalAlignment="Stretch"/>
                                        </StackPanel>
                                        <Grid ColumnSpacing="12" RowSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Text="安全协议" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Grid.Column="1" x:Name="Auth" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="1" Text="加密方式" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Grid.Row="1" Grid.Column="1" x:Name="Cipher" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="2" Text="自动连接" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Grid.Row="2" Grid.Column="1" x:Name="AutoConnect"/>
                                            <TextBlock Grid.Row="3" Text="隐藏网络" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Grid.Row="3" Grid.Column="1" x:Name="HiddenNetwork"/>
                                            <TextBlock Grid.Row="4" Text="无线网卡" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Grid.Row="4" Grid.Column="1" x:Name="Adapter" TextWrapping="Wrap"/>
                                        </Grid>
                                        <Button Content="复制网络名称" Click="CopyName_Click" HorizontalAlignment="Stretch"/>
                                        <Button x:Name="Share" AutomationProperties.AutomationId="WifiShare" Content="二维码分享" Click="Share_Click" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"/>
                                        <HyperlinkButton Content="打开 Windows WiFi 设置" Click="Settings_Click" Padding="0,8"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                    <InfoBar Grid.Row="3" x:Name="Notice" IsOpen="False" IsClosable="True"/>
                </Grid>
            </PivotItem>
            <PivotItem Header="局域网设备" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid RowSpacing="14" Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20,16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE968;" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Name="LanTitle" Text="局域网设备" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="LanSummary" Text="切换到此标签页后自动扫描一次，只做探测，不修改任何设备" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="RouterButton" AutomationProperties.AutomationId="WifiOpenRouter" Content="路由器管理页" Click="Router_Click" ToolTipService.ToolTip="在浏览器中打开当前网关的路由器管理页"/>
                                <Button x:Name="ScanLanButton" AutomationProperties.AutomationId="WifiScanLan" Click="ScanLan_Click" ToolTipService.ToolTip="重新扫描局域网设备" AutomationProperties.Name="扫描局域网设备"><FontIcon Glyph="&#xE72C;" FontSize="16"/></Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock x:Name="LanCount" Text="局域网设备" FontWeight="SemiBold"/>
                        <ListView Grid.Row="1" x:Name="LanDevices" AutomationProperties.AutomationId="WifiLanDevices" SelectionMode="None" IsItemClickEnabled="True" ItemClick="LanDevice_Click" HorizontalContentAlignment="Stretch" AutomationProperties.Name="局域网设备">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="services:LanDevice">
                                    <Grid Padding="8,10" ColumnSpacing="14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{x:Bind IconGlyph, Mode=OneTime}" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind EndpointLabel, Mode=OneTime}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Grid.Row="1" x:Name="LanEmpty" Visibility="Collapsed" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE968;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="LanEmptyText" Text="没有发现局域网设备" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                        <ProgressRing Grid.Row="1" x:Name="LanLoading" IsActive="False" Visibility="Collapsed" Width="32" Height="32"/>
                    </Grid>
                    <InfoBar Grid.Row="2" x:Name="LanNotice" IsOpen="False" IsClosable="True"/>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</UserControl>
