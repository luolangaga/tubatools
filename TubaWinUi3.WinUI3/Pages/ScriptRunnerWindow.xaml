<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="TubaWinUi3.Pages.ScriptRunnerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Padding="24,16,24,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Width="40" Height="40">
                <!-- Idle icon -->
                <Border x:Name="IdleIcon" Width="40" Height="40" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="8">
                    <FontIcon FontSize="20" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Glyph="&#xE756;" />
                </Border>
                <!-- Running ring -->
                <Grid x:Name="RunningRing" Width="40" Height="40" Visibility="Collapsed">
                    <ProgressRing Width="40" Height="40" IsActive="True" />
                </Grid>
            </Grid>
            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" Text="脚本运行" />
                <TextBlock x:Name="SubtitleText" FontSize="12" FontFamily="Consolas" IsTextSelectionEnabled="True" />
            </StackPanel>
            <Button x:Name="CloseButton" Grid.Column="2" Click="CloseButton_Click" CornerRadius="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                    <TextBlock Text="关闭" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Command bar -->
        <Border Grid.Row="1" Padding="24,0,24,12">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="CmdBadge" Padding="8,4" CornerRadius="4" VerticalAlignment="Center">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="CMD" FontFamily="Cascadia Code, Consolas" />
                    </Border>

                    <TextBox x:Name="CommandBox"
                             Grid.Column="1"
                             PlaceholderText="输入命令，如: ping 127.0.0.1"
                             FontFamily="Cascadia Code, Consolas"
                             FontSize="14"
                             CornerRadius="4"
                             KeyDown="CommandBox_KeyDown" />

                    <Button x:Name="RunButton" Grid.Column="2" Click="RunButton_Click" CornerRadius="4"
                            Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="12" />
                            <TextBlock Text="运行" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="StopButton" Grid.Column="3" Click="StopButton_Click" CornerRadius="4"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE71A;" FontSize="12" />
                            <TextBlock Text="停止" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ClearButton" Grid.Column="4" Click="ClearButton_Click" CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="12" />
                            <TextBlock Text="清空" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Options row -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox x:Name="AdminCheck" Content="管理员权限" FontSize="12" VerticalAlignment="Center" />
                    <CheckBox x:Name="AutoScrollCheck" Content="自动滚动" FontSize="12" IsChecked="True" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="缓冲区" FontSize="12" VerticalAlignment="Center" />
                        <NumberBox x:Name="BufferLimitBox" Value="2000" Minimum="100" Maximum="50000"
                                   SpinButtonPlacementMode="Compact" FontSize="12" Width="80"
                                   FontFamily="Cascadia Code, Consolas" CornerRadius="4" />
                        <TextBlock Text="行" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBox x:Name="WorkDirBox"
                             Grid.Column="3"
                             PlaceholderText="工作目录（可选）"
                             FontSize="12"
                             FontFamily="Cascadia Code, Consolas"
                             CornerRadius="4" />

                    <DropDownButton x:Name="EncodingButton" Grid.Column="4" CornerRadius="4" FontSize="12">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE8BD;" FontSize="12" />
                            <TextBlock x:Name="EncodingLabel" Text="UTF-8" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <ToggleMenuFlyoutItem x:Name="EncUtf8" Text="UTF-8" IsChecked="True" Click="EncMenu_Click" />
                                <ToggleMenuFlyoutItem x:Name="EncGbk" Text="GBK" Click="EncMenu_Click" />
                                <ToggleMenuFlyoutItem x:Name="EncDefault" Text="Default" Click="EncMenu_Click" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Terminal output area -->
        <Border Grid.Row="2" Margin="24,0,24,0" Padding="0"
                Style="{StaticResource FluentCardStyle}">
            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Terminal header -->
                <Border Padding="12,8,12,8" CornerRadius="8,8,0,0"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="10" Height="10" CornerRadius="4" Background="{ThemeResource SystemFillColorCriticalBrush}" />
                        <Border Width="10" Height="10" CornerRadius="4" Background="{ThemeResource SystemFillColorCautionBrush}" />
                        <Border Width="10" Height="10" CornerRadius="4" Background="{ThemeResource SystemFillColorSuccessBrush}" />

                        <TextBlock x:Name="StatusText" Grid.Column="3"
                                   FontSize="12" FontFamily="Cascadia Code, Consolas"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />

                        <TextBlock x:Name="DurationText" Grid.Column="4"
                                   FontSize="12" FontFamily="Cascadia Code, Consolas"
                                   VerticalAlignment="Center" />

                        <Button x:Name="ScrollToBottomButton" Grid.Column="5" Click="ScrollToBottomButton_Click"
                                Padding="4,2" CornerRadius="4" ToolTipService.ToolTip="滚动到底部">
                            <FontIcon Glyph="&#xE74B;" FontSize="12" />
                        </Button>

                        <Button x:Name="CopyOutputButton" Grid.Column="6" Click="CopyOutputButton_Click"
                                Padding="4,2" CornerRadius="4" ToolTipService.ToolTip="复制输出">
                            <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Output content -->
                <ScrollViewer x:Name="OutputScroll" Grid.Row="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Padding="12,8,12,8">
                    <TextBlock x:Name="OutputText"
                               FontFamily="Cascadia Code, Consolas"
                               FontSize="12"
                               LineHeight="20"
                               IsTextSelectionEnabled="True"
                               TextWrapping="NoWrap" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Input area (for stdin) -->
        <Border x:Name="InputPanel" Grid.Row="3" Margin="24,8,24,0" Padding="12"
                Style="{StaticResource FluentCardStyle}" Visibility="Collapsed">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="STDIN" FontSize="12" FontWeight="SemiBold"
                           FontFamily="Cascadia Code, Consolas" VerticalAlignment="Center" />
                <TextBox x:Name="InputBox" Grid.Column="1"
                         PlaceholderText="输入内容后按回车发送到进程标准输入..."
                         FontFamily="Cascadia Code, Consolas" FontSize="12" CornerRadius="4"
                         KeyDown="InputBox_KeyDown" />
                <Button x:Name="SendInputButton" Grid.Column="2" Click="SendInputButton_Click" CornerRadius="4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE724;" FontSize="12" />
                        <TextBlock Text="发送" FontSize="12" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="4" Padding="24,8,24,12">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="ExitCodeBadge" Padding="8,2" CornerRadius="4" Visibility="Collapsed">
                    <TextBlock x:Name="ExitCodeText" FontSize="12" FontWeight="SemiBold"
                               FontFamily="Cascadia Code, Consolas" />
                </Border>

                <TextBlock x:Name="LineCountText" Grid.Column="1" FontSize="12"
                           FontFamily="Cascadia Code, Consolas" />

                <TextBlock x:Name="ProcessInfoText" Grid.Column="2" FontSize="12"
                           FontFamily="Cascadia Code, Consolas" />

                <InfoBar x:Name="ToastBar" Grid.Column="4" IsClosable="True" IsOpen="False" />
            </Grid>
        </Border>
    </Grid>
</Window>
