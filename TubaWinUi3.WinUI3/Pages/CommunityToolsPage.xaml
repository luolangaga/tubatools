<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TubaWinUi3.Pages.CommunityToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:TubaWinUi3.Controls"
    xmlns:local="using:TubaWinUi3.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Disabled"
    mc:Ignorable="d">

    <Page.Resources>
        <local:FavGlyphConverter x:Key="FavGlyphConverter" />
        <local:NullToVisibilityConverter x:Key="NullToCollapse" />
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid>
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="16" FromHorizontalOffset="0" IsStaggeringEnabled="False" />
            </TransitionCollection>
        </Grid.Transitions>

        <Grid Padding="24,4,24,32" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:ToolPageHeader ToolId="community-tools"
                x:Name="PageHeader"
                Grid.Row="0"
                HeaderPadding="0"
                Title="社区工具"
                Subtitle="来自社区贡献的工具插件，下载安装即可使用。"
                Glyph="&#xE9D5;">
                <controls:ToolPageHeader.Actions>
                    <ComboBox
                        x:Name="SourceSelector"
                        MinWidth="110"
                        SelectedIndex="0"
                        SelectionChanged="SourceSelector_SelectionChanged">
                        <ComboBoxItem Content="GitCode" />
                        <ComboBoxItem Content="GitHub" />
                    </ComboBox>
                    <Button
                        x:Name="RefreshButton"
                        Style="{StaticResource ToolHeaderActionButtonStyle}"
                        Click="RefreshButton_Click"
                        ToolTipService.ToolTip="刷新">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    </Button>
                    <Button
                        x:Name="SubmitButton"
                        Style="{StaticResource ToolHeaderActionButtonStyle}"
                        Click="SubmitButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="提交工具" />
                        </StackPanel>
                    </Button>
                </controls:ToolPageHeader.Actions>
            </controls:ToolPageHeader>

            <Border
                Grid.Row="1"
                Style="{StaticResource FluentCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Style="{StaticResource IconTileStyle}"
                        Width="44"
                        Height="44"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <FontIcon
                            FontSize="20"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Glyph="&#xE9D5;" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="社区工具" />
                        <TextBlock x:Name="StatusText" Text="加载中..." />
                    </StackPanel>

                    <AutoSuggestBox
                        x:Name="SearchBox"
                        Grid.Column="2"
                        MinWidth="200"
                        PlaceholderText="搜索社区工具..."
                        QueryIcon="Find"
                        TextChanged="SearchBox_TextChanged"
                        QuerySubmitted="SearchBox_QuerySubmitted" />

                    <ComboBox
                        x:Name="CategoryFilter"
                        Grid.Column="3"
                        MinWidth="140"
                        SelectionChanged="CategoryFilter_SelectionChanged" />
                </Grid>
            </Border>

            <ProgressBar
                x:Name="LoadingProgress"
                Grid.Row="2"
                IsIndeterminate="True"
                Visibility="Collapsed" />

            <Grid Grid.Row="3">
                <GridView
                    x:Name="ToolsGrid"
                    IsItemClickEnabled="True"
                    ItemClick="ToolsGrid_ItemClick"
                    DoubleTapped="ToolsGrid_DoubleTapped"
                    ItemContainerStyle="{StaticResource ToolCardItemStyle}"
                    SelectionMode="None"
                    SizeChanged="ToolsGrid_SizeChanged">
                    <GridView.Resources>
                        <MenuFlyout x:Key="CommunityItemFlyout">
                            <MenuFlyoutItem x:Name="MenuToggleFavorite" Text="收藏" Click="MenuToggleFavorite_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE734;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="MenuSendToDesktop" Text="发送到桌面快捷方式" Click="MenuSendToDesktop_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8AD;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="MenuRunAsAdmin" Text="以管理员身份运行" Click="MenuRunAsAdmin_Click" Icon="Admin" />
                            <MenuFlyoutItem x:Name="MenuOpenDirectory" Text="打开工具所在目录" Click="MenuOpenDirectory_Click" Icon="Folder" />
                            <MenuFlyoutItem x:Name="MenuCopySource" Text="复制下载链接" Click="MenuCopySource_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8C8;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator x:Name="MenuSeparator1" Visibility="Collapsed" />
                            <MenuFlyoutItem x:Name="MenuCancelInstall" Text="取消下载" Click="MenuCancelInstall_Click" Visibility="Collapsed">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE711;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator x:Name="MenuSeparator2" Visibility="Collapsed" />
                            <MenuFlyoutItem x:Name="MenuUninstall" Text="卸载工具" Click="MenuUninstall_Click" Visibility="Collapsed">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="MenuRemoveRequest" Text="申请下架" Click="MenuRemoveRequest_Click"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7BA;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </GridView.Resources>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="16"
                                MinHeight="220"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                RightTapped="Item_RightTapped">
                                <Grid RowSpacing="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="44" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="56"
                                            Height="56"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="8">
                                            <Grid>
                                                <Image
                                                    Width="40"
                                                    Height="40"
                                                    Source="{Binding IconPath}"
                                                    Stretch="Uniform"
                                                    Visibility="{Binding IconPath, Converter={StaticResource NullToCollapse}}" />
                                                <FontIcon
                                                    FontSize="28"
                                                    Glyph="{Binding IconGlyph}"
                                                    Visibility="{Binding IconPath, Converter={StaticResource NullToCollapse}, ConverterParameter=Invert}" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock
                                                Style="{StaticResource CardTitleStyle}"
                                                MaxLines="1"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding CategoryDisplay}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="2"
                                            Width="32"
                                            Height="32"
                                            Padding="0"
                                            VerticalAlignment="Top"
                                            Click="FavoriteButton_Click"
                                            ToolTipService.ToolTip="收藏"
                                            Visibility="{Binding FavoriteButtonVisibility}">
                                            <FontIcon
                                                FontSize="14"
                                                Glyph="{Binding IsFavorite, Converter={StaticResource FavGlyphConverter}}" />
                                        </Button>
                                    </Grid>

                                    <TextBlock
                                        Grid.Row="1"
                                        MaxLines="2"
                                        Text="{Binding Description}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="2"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        MaxLines="1"
                                        Text="{Binding TagsText}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{Binding TagsText, Converter={StaticResource NullToCollapse}}" />

                                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                                        <Border Style="{StaticResource StatusPillStyle}" VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="{Binding StatusText}" />
                                        </Border>
                                        <TextBlock
                                            FontSize="12"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Author}"
                                            Visibility="{Binding Author, Converter={StaticResource NullToCollapse}}" />
                                    </StackPanel>

                                    <Grid Grid.Row="4" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            Style="{StaticResource ToolCardActionButtonStyle}"
                                            Click="UninstallButton_Click"
                                            ToolTipService.ToolTip="卸载工具"
                                            Visibility="{Binding UninstallButtonVisibility}">
                                            <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                        </Button>
                                        <Button
                                            Grid.Column="1"
                                            Style="{StaticResource ToolCardActionButtonStyle}"
                                            Click="RemoveRequestButton_Click"
                                            ToolTipService.ToolTip="申请下架（仅作者）"
                                            Visibility="{Binding RemoveRequestButtonVisibility}">
                                            <FontIcon FontSize="12" Glyph="&#xE7BA;" />
                                        </Button>
                                        <Button
                                            Grid.Column="2"
                                            MinWidth="88"
                                            Padding="8,4"
                                            Style="{StaticResource ToolCardActionButtonStyle}"
                                            Click="PrimaryButton_Click"
                                            IsEnabled="{Binding CanPrimaryAct}">
                                            <TextBlock
                                                Text="{Binding LaunchButtonText}"
                                                TextAlignment="Center"
                                                TextTrimming="CharacterEllipsis" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <StackPanel
                    x:Name="EmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Visibility="Collapsed">
                    <FontIcon
                        HorizontalAlignment="Center"
                        FontSize="28"
                        Glyph="&#xE721;" />
                    <TextBlock
                        x:Name="EmptyStateTitle"
                        HorizontalAlignment="Center"
                        FontSize="18"
                        TextAlignment="Center"
                        Text="暂无社区工具" />
                    <TextBlock
                        x:Name="EmptyStateText"
                        HorizontalAlignment="Center"
                        MaxWidth="520"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <StackPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="12">
                        <HyperlinkButton
                            x:Name="EmptyRetryLink"
                            Content="重试"
                            Click="RefreshButton_Click"
                            Visibility="Collapsed" />
                        <HyperlinkButton
                            x:Name="EmptySubmitLink"
                            Content="提交第一个工具"
                            Click="SubmitButton_Click"
                            Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>

                <InfoBar
                    x:Name="StatusBar"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    IsClosable="True"
                    IsOpen="False" />
            </Grid>

            <TeachingTip
                x:Name="DetailTip"
                CloseButtonContent="关闭"
                PreferredPlacement="Right">
                <StackPanel MaxWidth="420" Spacing="8">
                    <TextBlock x:Name="DetailDescriptionText" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailPublisherText" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailVersionText" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailStatusText" TextWrapping="Wrap" />
                    <HyperlinkButton x:Name="DetailHomepageLink" Content="查看项目主页" Visibility="Collapsed" />
                </StackPanel>
            </TeachingTip>
        </Grid>
    </Grid>
</Page>
