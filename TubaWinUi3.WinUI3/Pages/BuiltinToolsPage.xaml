<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TubaWinUi3.Pages.BuiltinToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TubaWinUi3.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Page.Resources>
        <local:FavGlyphConverter x:Key="FavGlyphConverter" />

        <!-- 内置工具卡片右键菜单（与首页卡片同构，仅保留收藏/发送到桌面） -->
        <MenuFlyout x:Key="BuiltinNormalFlyout">
            <MenuFlyoutItem Text="收藏" Click="BuiltinMenu_ToggleFavorite">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE734;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="发送到桌面快捷方式" Click="BuiltinMenu_SendToDesktop">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8AD;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
        <MenuFlyout x:Key="BuiltinCompactFlyout">
            <MenuFlyoutItem Text="收藏" Click="BuiltinMenu_ToggleFavorite">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE734;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="发送到桌面快捷方式" Click="BuiltinMenu_SendToDesktop">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8AD;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
        <!-- 普通卡片容器样式（与首页工具卡一致） -->
        <Style x:Key="BuiltinToolCardStyle" TargetType="GridViewItem">
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewItem">
                        <Grid x:Name="RootGrid" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="ItemScale" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition To="PointerOver" GeneratedDuration="0:0:0.18">
                                            <VisualTransition.GeneratedEasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </VisualTransition.GeneratedEasingFunction>
                                        </VisualTransition>
                                        <VisualTransition To="Pressed" GeneratedDuration="0:0:0.08">
                                            <VisualTransition.GeneratedEasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </VisualTransition.GeneratedEasingFunction>
                                        </VisualTransition>
                                        <VisualTransition To="Normal" GeneratedDuration="0:0:0.25">
                                            <VisualTransition.GeneratedEasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </VisualTransition.GeneratedEasingFunction>
                                        </VisualTransition>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ItemScale.ScaleX" Value="1.03" />
                                            <Setter Target="ItemScale.ScaleY" Value="1.03" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ItemScale.ScaleX" Value="0.97" />
                                            <Setter Target="ItemScale.ScaleY" Value="0.97" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="SelectionStates">
                                    <VisualState x:Name="Unselected" />
                                    <VisualState x:Name="Selected" />
                                    <VisualState x:Name="SelectedUnfocused" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 简洁模式卡片容器样式（与首页简洁列表一致） -->
        <Style x:Key="BuiltinCompactCardStyle" TargetType="GridViewItem">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewItem">
                        <Grid x:Name="RootGrid" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="ItemScale" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition To="PointerOver" GeneratedDuration="0:0:0.18">
                                            <VisualTransition.GeneratedEasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </VisualTransition.GeneratedEasingFunction>
                                        </VisualTransition>
                                        <VisualTransition To="Pressed" GeneratedDuration="0:0:0.08">
                                            <VisualTransition.GeneratedEasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </VisualTransition.GeneratedEasingFunction>
                                        </VisualTransition>
                                        <VisualTransition To="Normal" GeneratedDuration="0:0:0.25">
                                            <VisualTransition.GeneratedEasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </VisualTransition.GeneratedEasingFunction>
                                        </VisualTransition>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ItemScale.ScaleX" Value="1.04" />
                                            <Setter Target="ItemScale.ScaleY" Value="1.04" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ItemScale.ScaleX" Value="0.96" />
                                            <Setter Target="ItemScale.ScaleY" Value="0.96" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="SelectionStates">
                                    <VisualState x:Name="Unselected" />
                                    <VisualState x:Name="Selected" />
                                    <VisualState x:Name="SelectedUnfocused" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 普通模式卡片模板（与首页工具卡同构，图标换成字形） -->
        <DataTemplate x:Key="BuiltinNormalCardTemplate">
            <Border
                Padding="16"
                MinHeight="220"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                RightTapped="BuiltinCard_RightTapped">
                <Grid RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="44" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="56"
                            Height="56"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8">
                            <FontIcon
                                FontSize="28"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Glyph="{Binding Glyph}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="18"
                                FontWeight="Bold"
                                MaxLines="1"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="12"
                                Opacity="1.0"
                                Text="{Binding Category}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            Width="32"
                            Height="32"
                            Padding="0"
                            VerticalAlignment="Top"
                            Click="BuiltinFavoriteButton_Click"
                            ToolTipService.ToolTip="收藏">
                            <FontIcon
                                FontSize="14"
                                Glyph="{Binding IsFavorite, Converter={StaticResource FavGlyphConverter}}" />
                        </Button>
                    </Grid>

                    <TextBlock
                        Grid.Row="1"
                        MaxLines="2"
                        Opacity="1.0"
                        Text="{Binding Description}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                        <Border
                            VerticalAlignment="Center"
                            Padding="8,3"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="6">
                            <TextBlock
                                FontSize="11"
                                FontWeight="Bold"
                                Text="{Binding KindText}" />
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="3" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Padding="0"
                            Click="BuiltinSendDesktopButton_Click"
                            ToolTipService.ToolTip="发送到桌面快捷方式">
                            <FontIcon FontSize="12" Glyph="&#xE8AD;" />
                        </Button>
                        <Button
                            Grid.Column="1"
                            MinWidth="88"
                            HorizontalAlignment="Stretch"
                            Padding="10,4"
                            Click="BuiltinOpenButton_Click">
                            <TextBlock Text="打开" TextAlignment="Center" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 简洁模式卡片模板（与首页简洁列表卡片一致） -->
        <DataTemplate x:Key="BuiltinCompactCardTemplate">
            <Border
                Padding="8,10,8,6"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                RightTapped="BuiltinCard_RightTapped"
                ToolTipService.ToolTip="{Binding Description}">
                <StackPanel HorizontalAlignment="Center" Spacing="6">
                    <Border
                        Width="52"
                        Height="52"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="10">
                        <FontIcon
                            FontSize="26"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Glyph="{Binding Glyph}" />
                    </Border>
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="13"
                        MaxLines="2"
                        Text="{Binding Name}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        Width="84" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="16" FromHorizontalOffset="0" IsStaggeringEnabled="False" />
            </TransitionCollection>
        </Grid.Transitions>
        <Grid Padding="28,18,28,24" RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            FontSize="30"
                            FontWeight="Bold"
                            Text="内置" />
                        <TextBlock
                            x:Name="ToolCountText"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,4"
                            FontSize="14"
                            Opacity="1.0" />
                    </StackPanel>
                    <TextBlock
                        Opacity="1.0"
                        Text="无需外部文件，直接使用的系统工具集。" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        FontSize="12"
                        Opacity="0.7"
                        Text="打开方式" />
                    <ComboBox
                        x:Name="BuiltinToolOpenModeComboBox"
                        MinWidth="120"
                        SelectionChanged="BuiltinToolOpenModeComboBox_SelectionChanged" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Pivot x:Name="BuiltinPivot" Margin="0,4,0,0" />

                <InfoBar
                    x:Name="StatusBar"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    IsClosable="True"
                    IsOpen="False" />
            </Grid>
        </Grid>
    </Grid>
</Page>