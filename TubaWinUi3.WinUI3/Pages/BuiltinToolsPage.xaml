<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TubaWinUi3.Pages.BuiltinToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="using:WinUI3Localizer"
    xmlns:local="using:TubaWinUi3.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Page.Resources>
        <local:FavGlyphConverter x:Key="FavGlyphConverter" />
        <local:NullToVisibilityConverter x:Key="NullToCollapse" />

        <!-- 内置工具卡片右键菜单（与首页卡片同构，仅保留收藏/发送到桌面） -->
        <MenuFlyout x:Key="BuiltinNormalFlyout">
            <MenuFlyoutItem Text="收藏" l:Uids.Uid="Common_Favorite" Click="BuiltinMenu_ToggleFavorite">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE734;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="发送到桌面快捷方式" l:Uids.Uid="Common_SendToDesktop" Click="BuiltinMenu_SendToDesktop">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8AD;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
        <MenuFlyout x:Key="BuiltinCompactFlyout">
            <MenuFlyoutItem Text="收藏" l:Uids.Uid="Common_Favorite" Click="BuiltinMenu_ToggleFavorite">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE734;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="发送到桌面快捷方式" l:Uids.Uid="Common_SendToDesktop" Click="BuiltinMenu_SendToDesktop">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8AD;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
        <!-- 普通模式卡片模板（与首页工具卡同构，图标换成字形） -->
        <!-- 卡片容器样式统一使用 Styles/ToolCardStyles.xaml 的 ToolCardItemStyle / CompactToolCardItemStyle（全局注册） -->
        <DataTemplate x:Key="BuiltinNormalCardTemplate">
            <Border
                Padding="16"
                MinHeight="220"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                RightTapped="BuiltinCard_RightTapped">
                <Grid RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="44" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="56"
                            Height="56"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8">
                            <Grid>
                                <Image
                                    Width="40"
                                    Height="40"
                                    Source="{Binding IconSource}"
                                    Stretch="Uniform"
                                    Visibility="{Binding IconSource, Converter={StaticResource NullToCollapse}}" />
                                <FontIcon
                                    FontSize="28"
                                    Glyph="{Binding Glyph}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding Glyph, Converter={StaticResource NullToCollapse}}" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock
                                Style="{StaticResource CardTitleStyle}"
                                MaxLines="1"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding Category}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            Width="32"
                            Height="32"
                            Padding="0"
                            VerticalAlignment="Top"
                            Click="BuiltinFavoriteButton_Click"
                            l:Uids.Uid="Builtin_FavoriteButton"
                            ToolTipService.ToolTip="收藏">
                            <FontIcon
                                FontSize="14"
                                Glyph="{Binding IsFavorite, Converter={StaticResource FavGlyphConverter}}" />
                        </Button>
                    </Grid>

                    <TextBlock
                        Grid.Row="1"
                        MaxLines="2"
                        Text="{Binding Description}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                        <Border Style="{StaticResource StatusPillStyle}" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="{Binding KindText}" />
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="3" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Style="{StaticResource ToolCardActionButtonStyle}"
                            Click="BuiltinSendDesktopButton_Click"
                            l:Uids.Uid="Builtin_SendDesktopButton"
                            ToolTipService.ToolTip="发送到桌面快捷方式">
                            <FontIcon FontSize="12" Glyph="&#xE8AD;" />
                        </Button>
                        <Button
                            Grid.Column="1"
                            MinWidth="88"
                            Padding="8,4"
                            Style="{StaticResource ToolCardActionButtonStyle}"
                            Click="BuiltinOpenButton_Click">
                            <TextBlock Text="打开" l:Uids.Uid="Common_Open" TextAlignment="Center" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 简洁模式卡片模板（与首页简洁列表卡片一致） -->
        <DataTemplate x:Key="BuiltinCompactCardTemplate">
            <Border
                Padding="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                RightTapped="BuiltinCard_RightTapped"
                ToolTipService.ToolTip="{Binding Description}">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <Border
                        Width="56"
                        Height="56"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="8">
                        <Grid>
                            <Image
                                Width="40"
                                Height="40"
                                Source="{Binding IconSource}"
                                Stretch="Uniform"
                                Visibility="{Binding IconSource, Converter={StaticResource NullToCollapse}}" />
                            <FontIcon
                                FontSize="28"
                                Glyph="{Binding Glyph}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding Glyph, Converter={StaticResource NullToCollapse}}" />
                        </Grid>
                    </Border>
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="14"
                        MaxLines="2"
                        Text="{Binding Name}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        Width="84" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="16" FromHorizontalOffset="0" IsStaggeringEnabled="False" />
            </TransitionCollection>
        </Grid.Transitions>
        <Grid Padding="24,8,24,24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            Style="{StaticResource PageTitleStyle}"
                            Text="内置"
                            l:Uids.Uid="Common_Builtin" />
                        <TextBlock
                            x:Name="ToolCountText"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,4"
                            FontSize="14" />
                    </StackPanel>
                    <TextBlock
                        Style="{StaticResource PageSubtitleStyle}"
                        Text="无需外部文件，直接使用的系统工具集。"
                        l:Uids.Uid="BuiltinPage_Subtitle" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="打开方式"
                        l:Uids.Uid="BuiltinPage_OpenModeLabel" />
                    <ComboBox
                        x:Name="BuiltinToolOpenModeComboBox"
                        MinWidth="120"
                        SelectionChanged="BuiltinToolOpenModeComboBox_SelectionChanged" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Pivot x:Name="BuiltinPivot" Margin="0,4,0,0" />

                <InfoBar
                    x:Name="StatusBar"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    IsClosable="True"
                    IsOpen="False" />
            </Grid>
        </Grid>
    </Grid>
</Page>