<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TubaWinUi3.Pages.HardwarePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="using:WinUI3Localizer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SettingsHardwareCaptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="SettingsHardwareCalloutStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
        </Style>

        <Storyboard x:Name="EntranceStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="HeaderPanel"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1" Duration="0:0:0.4"
                BeginTime="0:0:0">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="HeaderPanel"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                From="20" To="0" Duration="0:0:0.5"
                BeginTime="0:0:0">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation
                Storyboard.TargetName="MetricsPanel"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1" Duration="0:0:0.4"
                BeginTime="0:0:0.1">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="MetricsPanel"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                From="24" To="0" Duration="0:0:0.5"
                BeginTime="0:0:0.1">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation
                Storyboard.TargetName="Card1"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                From="0.94" To="1" Duration="0:0:0.4"
                BeginTime="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="Card1"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                From="0.94" To="1" Duration="0:0:0.4"
                BeginTime="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation
                Storyboard.TargetName="Card2"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                From="0.94" To="1" Duration="0:0:0.4"
                BeginTime="0:0:0.23">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="Card2"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                From="0.94" To="1" Duration="0:0:0.4"
                BeginTime="0:0:0.23">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation
                Storyboard.TargetName="Card3"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                From="0.94" To="1" Duration="0:0:0.4"
                BeginTime="0:0:0.31">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="Card3"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                From="0.94" To="1" Duration="0:0:0.4"
                BeginTime="0:0:0.31">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation
                Storyboard.TargetName="DetailsPanel"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1" Duration="0:0:0.4"
                BeginTime="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="DetailsPanel"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                From="20" To="0" Duration="0:0:0.5"
                BeginTime="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Name="ExitStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="HeaderPanel"
                Storyboard.TargetProperty="Opacity"
                To="0" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="HeaderPanel"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                To="-12" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="MetricsPanel"
                Storyboard.TargetProperty="Opacity"
                To="0" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="MetricsPanel"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                To="-12" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="DetailsPanel"
                Storyboard.TargetProperty="Opacity"
                To="0" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="DetailsPanel"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                To="-12" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Grid Background="Transparent">
        <Border x:Name="RootHost">
            <Grid
                x:Name="LayoutRoot"
                Width="1100"
                MaxWidth="1100"
                Padding="24,8,24,24"
                RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    x:Name="HeaderPanel"
                    ColumnSpacing="16"
                    Opacity="0"
                    RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TranslateTransform Y="20" />
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                x:Name="TitleText"
                                Style="{StaticResource PageTitleStyle}"
                                Text="硬件信息" l:Uids.Uid="Hw_Title"
                                IsTapEnabled="True"
                                Tapped="TitleText_Tapped" />
                            <Border
                                x:Name="CpuzBadge"
                                Visibility="Collapsed"
                                Style="{StaticResource StatusPillStyle}"
                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,4">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                    Text="CPU-Z" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Style="{StaticResource PageSubtitleStyle}"
                            Text="汇总本机型号、系统和关键硬件参数。" l:Uids.Uid="Hw_Subtitle" />
                        <TextBlock x:Name="HardwareSourceText" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="HeaderButtons" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <DropDownButton Content="视图" l:Uids.Uid="Hw_ViewMenu" AutomationProperties.AutomationId="HardwareClassicViewMenu">
                            <DropDownButton.Flyout><MenuFlyout>
                                <RadioMenuFlyoutItem x:Name="ClassicModeMenu" Text="经典样式" l:Uids.Uid="Hw_ClassicMode" Tag="classic" Click="HardwareMode_Click" />
                                <RadioMenuFlyoutItem x:Name="DiagramModeMenu" Text="3D 硬件全景" l:Uids.Uid="Hw_DiagramMode" Tag="diagram" Click="HardwareMode_Click" />
                            </MenuFlyout></DropDownButton.Flyout>
                        </DropDownButton>


                        <Button
                            Padding="16,8"
                            Click="DetailButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE946;" />
                                <TextBlock FontSize="14" Text="详细信息" l:Uids.Uid="Hw_DetailButton" />
                            </StackPanel>
                        </Button>
                        <Button
                            Padding="16,8"
                            Click="RefreshButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:Name="RefreshIcon" FontSize="16" Glyph="&#xE72C;" />
                                <TextBlock FontSize="14" Text="刷新" l:Uids.Uid="Hw_Refresh" />
                            </StackPanel>
                        </Button>
                        <DropDownButton
                            Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE8B9;" />
                                <TextBlock FontSize="14" Text="分享" l:Uids.Uid="Hw_Share" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuFlyoutItem Text="截图" l:Uids.Uid="Hw_Screenshot" Click="ScreenshotButton_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontSize="16" Glyph="&#xE8B9;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="复制纯文字" l:Uids.Uid="Hw_CopyPlainText" Click="CopyTextButton_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="复制 Markdown" l:Uids.Uid="Hw_CopyMarkdown" Click="CopyMarkdownButton_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontSize="16" Glyph="&#xE943;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>
                </Grid>

                <Grid
                    x:Name="MetricsPanel"
                    Grid.Row="1"
                    ColumnSpacing="16"
                    Opacity="0"
                    RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TranslateTransform Y="24" />
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="Card1" Style="{StaticResource MetricCardStyle}" PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited" Tapped="Card1_Tapped" IsTapEnabled="True">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="48"
                                Height="48"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8">
                                <Image Width="36" Height="36" Stretch="Uniform" AutomationProperties.AccessibilityView="Raw"><Image.Source><SvgImageSource UriSource="ms-appx:///Assets/HwIcons/computer.svg"/></Image.Source></Image>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="型号信息" l:Uids.Uid="Hw_ModelCard" />
                                <TextBlock
                                    x:Name="ModelText"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="Card2" Grid.Column="1" Style="{StaticResource MetricCardStyle}" PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited" Tapped="Card2_Tapped" IsTapEnabled="True">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="48"
                                Height="48"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8">
                                <Image Width="36" Height="36" Stretch="Uniform" AutomationProperties.AccessibilityView="Raw"><Image.Source><SvgImageSource UriSource="ms-appx:///Assets/HwIcons/system.svg"/></Image.Source></Image>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="系统信息" l:Uids.Uid="Hw_SystemCard" />
                                <TextBlock
                                    x:Name="SystemText"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="Card3" Grid.Column="2" Style="{StaticResource MetricCardStyle}" PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited" Tapped="Card3_Tapped" IsTapEnabled="True">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="48"
                                Height="48"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8">
                                <Grid Width="36" Height="36" AutomationProperties.AccessibilityView="Raw">
                                    <Image Stretch="Uniform"><Image.Source><SvgImageSource UriSource="ms-appx:///Assets/HwIcons/uptime.svg"/></Image.Source></Image>
                                    <Line X1="18" Y1="18" X2="18" Y2="12" Stroke="#478CB8" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                        <Line.RenderTransform><RotateTransform x:Name="UptimeHourHand" CenterX="18" CenterY="18"/></Line.RenderTransform>
                                    </Line>
                                    <Line X1="18" Y1="18" X2="18" Y2="9" Stroke="#478CB8" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                        <Line.RenderTransform><RotateTransform x:Name="UptimeMinuteHand" CenterX="18" CenterY="18"/></Line.RenderTransform>
                                    </Line>
                                    <Line X1="18" Y1="20" X2="18" Y2="7" Stroke="#E36F70" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                        <Line.RenderTransform><RotateTransform x:Name="UptimeSecondHand" CenterX="18" CenterY="18"/></Line.RenderTransform>
                                    </Line>
                                    <Ellipse Width="3" Height="3" Fill="#478CB8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="运行时间" l:Uids.Uid="Hw_UptimeCard" />
                                <TextBlock
                                    x:Name="UptimeText"
                                    Width="220"
                                    HorizontalAlignment="Left"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <StackPanel
                    x:Name="DetailsPanel"
                    Grid.Row="2"
                    Spacing="8"
                    Opacity="0"
                    RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <TranslateTransform Y="20" />
                    </StackPanel.RenderTransform>
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="详细信息" l:Uids.Uid="Hw_DetailsHeader" />

                    <Border Style="{StaticResource FluentCardStyle}">
                        <ItemsRepeater x:Name="DetailsRepeater" ElementPrepared="DetailsRepeater_ElementPrepared">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        Padding="16,8"
                                        ColumnSpacing="12"
                                        PointerPressed="DetailItem_PointerPressed"
                                        IsTapEnabled="True"
                                        Tapped="DetailItem_Tapped"
                                        ToolTipService.ToolTip="{Binding CopyHint}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Image Width="24" Height="24" Source="{Binding IconSource}" Stretch="Uniform" AutomationProperties.AccessibilityView="Raw"/>
                                            <TextBlock FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Text="{Binding DisplayLabel}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border
                                            Grid.Column="1"
                                            Width="1"
                                            Height="16"
                                            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            x:Name="ValueText"

                                            Grid.Column="2"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Text="{Binding Value}"
                                            TextWrapping="Wrap"
                                            VerticalAlignment="Center"
                                            RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                        <Image
                                            x:Name="HardwareBrandLogo"
                                            Grid.Column="3"
                                            Width="20"
                                            Height="20"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Stretch="Uniform"
                                            Visibility="Collapsed" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 硬件全景独立于经典版的一屏缩放布局，按可用宽度重排。 -->
        <Grid x:Name="SettingsStyleScroll" Visibility="Collapsed" Background="Transparent" SizeChanged="SettingsStyleScroll_SizeChanged"
              PointerPressed="HardwareFocusOutside_PointerPressed" KeyDown="HardwareFocus_KeyDown">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
            <!-- Width 由 FitSettingsStyleWidth() 按可用宽度反推：Viewbox 为「一屏放下」等比缩放，
                 高度受限时会缩出左右白边，这里把逻辑宽度补到「缩放后刚好铺满」。 -->
            <StackPanel x:Name="SettingsStyleRoot" Width="1180" Padding="24,8,24,20" Spacing="12"
                        HorizontalAlignment="Center" SizeChanged="SettingsStyleRoot_SizeChanged">
                <Grid x:Name="SettingsStyleHeader" ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="硬件信息" l:Uids.Uid="Hw_Title" Style="{StaticResource PageTitleStyle}" />
                    <StackPanel x:Name="SettingsStyleActions" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <DropDownButton Content="视图" l:Uids.Uid="Hw_ViewMenu" AutomationProperties.AutomationId="HardwareDiagramViewMenu">
                            <DropDownButton.Flyout><MenuFlyout>
                                <RadioMenuFlyoutItem x:Name="ModernClassicModeMenu" Text="经典样式" l:Uids.Uid="Hw_ClassicMode" Tag="classic" Click="HardwareMode_Click" />
                                <RadioMenuFlyoutItem x:Name="ModernDiagramModeMenu" Text="3D 硬件全景" l:Uids.Uid="Hw_DiagramMode" Tag="diagram" Click="HardwareMode_Click" />
                                <MenuFlyoutSeparator />
                                <ToggleMenuFlyoutItem x:Name="HardwareAutoRotate" Text="自动旋转" l:Uids.Uid="Hw_AutoRotate" Click="HardwareAutoRotate_Click" AutomationProperties.AutomationId="HardwareAutoRotate" />
                                <MenuFlyoutItem x:Name="HardwareReplayMenu" Text="重播开机" l:Uids.Uid="Hw_ReplayBoot" Click="HardwareReplay_Click" AutomationProperties.AutomationId="HardwareReplay" />
                            </MenuFlyout></DropDownButton.Flyout>
                        </DropDownButton>

                        <Button Content="详细信息" l:Uids.Uid="Hw_ModernDetail" Click="DetailButton_Click" AutomationProperties.AutomationId="HardwareModernDetails" />
                        <Button Content="刷新" l:Uids.Uid="Hw_ModernRefresh" Click="RefreshButton_Click" AutomationProperties.AutomationId="HardwareModernRefresh" />
                        <DropDownButton Content="分享" l:Uids.Uid="Hw_ModernShare" AutomationProperties.AutomationId="HardwareModernShare">
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="截图" l:Uids.Uid="Hw_Screenshot" Click="ScreenshotButton_Click" />
                                    <MenuFlyoutItem Text="复制纯文字" l:Uids.Uid="Hw_CopyPlainText" Click="CopyTextButton_Click" />
                                    <MenuFlyoutItem Text="复制 Markdown" l:Uids.Uid="Hw_CopyMarkdown" Click="CopyMarkdownButton_Click" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>
                </Grid>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="SettingsStyleDeviceName" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="SettingsStyleModel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="SettingsStyleUptime" Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
                <Grid x:Name="HardwareDiagram" Height="640" Background="Transparent" SizeChanged="HardwareDiagram_SizeChanged">
                    <Canvas x:Name="HardwareCalloutCanvas" Canvas.ZIndex="2" />
                    <Grid x:Name="HardwareDeviceStage">
                        <Grid x:Name="HardwareModelViewport">
                            <Image x:Name="HardwareModelImage" Stretch="Fill" Visibility="Collapsed" />
                            <ContentControl x:Name="HardwareSceneHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" AutomationProperties.AutomationId="HardwareInteractiveModel" />
                            <TextBlock x:Name="HardwareModelError" Visibility="Collapsed" Text="3D 预览暂不可用，硬件参数仍可查看" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>

                    <Canvas x:Name="HardwareConnectors" Canvas.ZIndex="1" IsHitTestVisible="False" />
                </Grid>
                <TextBlock x:Name="SettingsStyleSource" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            </Viewbox>
        </Grid>

        <ProgressRing
            x:Name="LoadingRing"
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="False"
            Visibility="Collapsed" />

        <InfoBar
            x:Name="StatusBar"
            Margin="24"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
