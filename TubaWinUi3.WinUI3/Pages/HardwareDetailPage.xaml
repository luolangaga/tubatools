<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TubaWinUi3.Pages.HardwareDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TubaWinUi3.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="using:WinUI3Localizer"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- 分区卡片：共享 FluentCardStyle（Padding 16 / 圆角 8 / 官方卡底卡描边） -->
        <Style x:Key="SectionCardStyle" TargetType="Border" BasedOn="{StaticResource FluentCardStyle}" />

        <!-- 分区标题：共享 SectionHeaderStyle（14 SemiBold） -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeaderStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DetailRowStyle" TargetType="Grid">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="ColumnSpacing" Value="8" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <DataTemplate x:Key="DetailRowTemplate">
            <Grid Style="{StaticResource DetailRowStyle}" Tapped="DetailItem_Tapped" IsTapEnabled="True" ToolTipService.ToolTip="{Binding CopyHint}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding DisplayLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Border Grid.Column="1" Width="1" Height="12" Background="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" FontSize="12" FontWeight="SemiBold" Text="{Binding Value}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="Transparent">
        <ScrollViewer x:Name="ContentScroller" Padding="24,8,24,24" VerticalScrollBarVisibility="Auto">
            <StackPanel
                x:Name="LayoutRoot"
                Spacing="16"
                HorizontalAlignment="Stretch">

                <!-- Header -->
                <Grid x:Name="HeaderPanel" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Padding="8,4"
                        Click="BackButton_Click"
                        VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE72B;" />
                            <TextBlock FontSize="14" Text="返回" l:Uids.Uid="HwDetail_Back" />
                        </StackPanel>
                    </Button>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="详细信息" l:Uids.Uid="HwDetail_Title" />
                            <Border
                                x:Name="CpuzBadge"
                                Visibility="Collapsed"
                                Style="{StaticResource StatusPillStyle}"
                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                VerticalAlignment="Center"
                                Margin="0,4,0,0">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                    Text="CPU-Z" />
                            </Border>
                        </StackPanel>
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="完整硬件参数一览" l:Uids.Uid="HwDetail_Subtitle" />
                    </StackPanel>
                    <Button
                        x:Name="ExportButton"
                        Grid.Column="2"
                        Click="ExportButton_Click"
                        Style="{StaticResource ToolHeaderActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xEDE1;" />
                            <TextBlock FontSize="14" Text="导出" l:Uids.Uid="HwDetail_Export" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="RefreshButton"
                        Grid.Column="3"
                        Click="RefreshButton_Click"
                        Style="{StaticResource ToolHeaderActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="RefreshIcon" FontSize="14" Glyph="&#xE72C;" />
                            <TextBlock FontSize="14" Text="刷新" l:Uids.Uid="HwDetail_Refresh" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 瀑布流参数卡片（代码动态生成；自适应列数 + 自动均衡分列 + 铺满对齐） -->
                <controls:CardBoard
                    x:Name="Board"
                    ColumnGap="14"
                    RowGap="14"
                    MaxColumns="6"
                    MinColumnWidth="336" />

                <!-- Real-time monitoring section -->
                <StackPanel x:Name="RealtimeSection" Spacing="8" Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="实时信息" l:Uids.Uid="HwDetail_Realtime" Margin="0,0,0,2" />

                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource SectionCardStyle}" Grid.Column="0" Padding="12">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="CPU" VerticalAlignment="Center" />
                                    <TextBlock x:Name="CpuLoadText" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" Text="--" VerticalAlignment="Center" />
                                </Grid>
                                <lvc:CartesianChart x:Name="CpuChart" Height="80" Background="Transparent" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCardStyle}" Grid.Column="1" Padding="12">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="GPU" VerticalAlignment="Center" />
                                    <TextBlock x:Name="GpuLoadText" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" Text="--" VerticalAlignment="Center" />
                                </Grid>
                                <lvc:CartesianChart x:Name="GpuChart" Height="80" Background="Transparent" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCardStyle}" Grid.Column="2" Padding="12">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="内存" l:Uids.Uid="HwDetail_RealtimeMem" VerticalAlignment="Center" />
                                    <TextBlock x:Name="MemLoadText" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" Text="--" VerticalAlignment="Center" />
                                </Grid>
                                <lvc:CartesianChart x:Name="MemChart" Height="80" Background="Transparent" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCardStyle}" Grid.Column="3" Padding="12">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="硬盘" l:Uids.Uid="HwDetail_RealtimeDisk" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="DiskReadText" FontSize="12" FontWeight="SemiBold" Text="--" />
                                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="/" VerticalAlignment="Center" />
                                        <TextBlock x:Name="DiskWriteText" FontSize="12" FontWeight="SemiBold" Text="--" />
                                    </StackPanel>
                                </Grid>
                                <lvc:CartesianChart x:Name="DiskChart" Height="80" Background="Transparent" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="BatteryCard" Style="{StaticResource SectionCardStyle}" Grid.Column="4" Padding="12" Visibility="Collapsed">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="电池" l:Uids.Uid="HwDetail_RealtimeBattery" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="BatPercentText" FontSize="18" FontWeight="SemiBold" Text="--" />
                                        <TextBlock x:Name="BatPowerText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <lvc:CartesianChart x:Name="BatChart" Height="80" Background="Transparent" />
                            </StackPanel>
                        </Border>

                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ProgressRing
            x:Name="LoadingRing"
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="False"
            Visibility="Collapsed" />

        <InfoBar
            x:Name="StatusBar"
            Margin="24"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            IsClosable="True"
            IsOpen="False" />
    </Grid>
</Page>
