<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="TubaWinUi3.Pages.ToolsBundleDownloadDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    PrimaryButtonText="开始下载"
    CloseButtonText="跳过"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <ContentDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <CornerRadius x:Key="DialogCornerRadius">12</CornerRadius>
        </ResourceDictionary>
    </ContentDialog.Resources>

    <Grid RowSpacing="14" MinWidth="480">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Padding="18,14"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="10">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="48"
                    Height="48"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="12">
                    <FontIcon
                        FontSize="24"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Glyph="&#xE896;" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <TextBlock
                        x:Name="TitleText"
                        FontSize="18"
                        FontWeight="Bold"
                        Text="下载内核" />
                    <TextBlock
                        x:Name="DescText"
                        FontSize="12"
                        Opacity="1.0"
                        TextWrapping="Wrap"
                        MaxLines="3"
                        Text="首次使用需要下载内核文件，下载完成后即可使用全部功能。" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel
            x:Name="ResolvingSection"
            Grid.Row="1"
            Spacing="8"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressRing Width="18" Height="18" IsActive="True" />
                <TextBlock x:Name="ResolvingLabel" FontSize="13" Opacity="1.0" Text="正在检查内核更新..." />
            </StackPanel>
        </StackPanel>

        <StackPanel
            x:Name="SourceSection"
            Grid.Row="2"
            Spacing="8"
            Visibility="Collapsed">
            <TextBlock
                FontSize="13"
                Opacity="1.0"
                Text="将优先使用 GitCode 下载，失败时自动切换 GitHub。" />
        </StackPanel>

        <StackPanel
            x:Name="VariantSection"
            Grid.Row="3"
            Spacing="6"
            Visibility="Collapsed">
            <TextBlock
                FontSize="13"
                Opacity="1.0"
                Text="请选择要下载的内核版本：" />
            <RadioButton
                x:Name="LiteRadio"
                GroupName="TubaBundleVariant"
                MinWidth="0"
                Padding="12,8"
                Checked="OnVariantChecked">
                <StackPanel Spacing="2">
                    <TextBlock FontWeight="SemiBold" Text="精简版" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="仅必要检测工具：CPU-Z、GPU-Z、HWiNFO、HWMonitor、FurMark、C2CLatency、DDU、CrystalDiskInfo、CrystalDiskMark" />
                    <TextBlock
                        x:Name="LiteRadioSub"
                        FontSize="11"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Text="" />
                </StackPanel>
            </RadioButton>
            <RadioButton
                x:Name="FullRadio"
                GroupName="TubaBundleVariant"
                MinWidth="0"
                Padding="12,8"
                Checked="OnVariantChecked">
                <StackPanel Spacing="2">
                    <TextBlock FontWeight="SemiBold" Text="完整版" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="全部分类工具，体积较大" />
                    <TextBlock
                        x:Name="FullRadioSub"
                        FontSize="11"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Text="" />
                </StackPanel>
            </RadioButton>
            <TextBlock
                x:Name="VariantHintText"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>

        <StackPanel
            x:Name="ProgressSection"
            Grid.Row="4"
            Spacing="10"
            Visibility="Collapsed">

            <TextBlock
                x:Name="ProgressLabel"
                FontSize="13"
                Opacity="1.0"
                    Text="正在下载内核..." />

            <ProgressBar
                x:Name="DownloadProgressBar"
                IsIndeterminate="False"
                ShowError="False"
                ShowPaused="False" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon FontSize="11" Glyph="&#xE921;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            x:Name="SpeedText"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="--" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon FontSize="11" Glyph="&#xE8B7;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            x:Name="SizeText"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="--" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon FontSize="11" Glyph="&#xE917;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            x:Name="TimeText"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="--" />
                    </StackPanel>
                </StackPanel>

                <TextBlock
                    x:Name="PercentText"
                    Grid.Column="1"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Text="0%" />
            </Grid>
        </StackPanel>

        <InfoBar
            x:Name="ErrorBar"
            Grid.Row="5"
            IsOpen="False"
            IsClosable="True"
            Severity="Error"
            Title="下载失败" />

    </Grid>
</ContentDialog>
