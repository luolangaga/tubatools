<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TubaWinUi3.Pages.GameMonitorRecordsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:TubaWinUi3.Controls"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:ToolPageHeader ToolId="game-monitor-records"
            Grid.Row="0"
            Title="记录查看"
            Subtitle="解析游戏监控导出的 JSON / CSV，图表化回放 FPS、温度、负载等历史数据（Beta 测试中，部分数据可能有偏差）"
            Glyph="&#xE9F5;">
            <controls:ToolPageHeader.Actions>
                <Border Style="{StaticResource StatusPillStyle}"
                        Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                        BorderBrush="{ThemeResource SystemFillColorCriticalBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                    <TextBlock FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="Beta" />
                </Border>
                <Button Click="Refresh_Click" Style="{StaticResource ToolHeaderActionButtonStyle}"
                        ToolTipService.ToolTip="重新扫描输出目录">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                        <TextBlock Text="刷新" />
                    </StackPanel>
                </Button>
                <Button Click="OpenFolder_Click" Style="{StaticResource ToolHeaderActionButtonStyle}"
                        ToolTipService.ToolTip="在资源管理器中打开记录目录">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE838;" FontSize="12" />
                        <TextBlock Text="打开文件夹" />
                    </StackPanel>
                </Button>
            </controls:ToolPageHeader.Actions>
        </controls:ToolPageHeader>

        <!-- Body -->
        <Grid Grid.Row="1" Padding="24,4,24,32" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="262" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: record files -->
            <Border Style="{StaticResource FluentCardStyle}" Padding="12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="记录文件" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock x:Name="TxtDir" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   TextWrapping="Wrap" Text="—" />
                    </StackPanel>
                    <ListView x:Name="FileList" Grid.Row="1" SelectionMode="Single"
                              SelectionChanged="FileList_SelectionChanged"
                              Background="Transparent" BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="2" Margin="0,4">
                                    <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Info}" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Right: charts（整列可滚动：窗口高度不够时不会把图表挤出可视区） -->
            <ScrollViewer x:Name="RightScroll" Grid.Column="1"
                          VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled"
                          HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
                          SizeChanged="RightScroll_SizeChanged" HorizontalContentAlignment="Stretch">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Meta chips -->
                    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Enabled" ZoomMode="Disabled">
                        <StackPanel x:Name="PnlMeta" Orientation="Horizontal" Spacing="8">
<StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromHorizontalOffset="0" FromVerticalOffset="24" IsStaggeringEnabled="True" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
</StackPanel>
                    </ScrollViewer>

                    <!-- Stat cards -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Enabled" ZoomMode="Disabled" HorizontalContentAlignment="Stretch">
                        <StackPanel x:Name="PnlCards" Orientation="Horizontal" Spacing="8" Padding="0,0,0,2" />
                    </ScrollViewer>

                    <!-- Group tabs -->
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Enabled" ZoomMode="Disabled">
                        <StackPanel x:Name="PnlTabs" Orientation="Horizontal" Spacing="8" />
                    </ScrollViewer>

                    <!-- 指标选择 + 区间裁剪（作用于下方所有图表） -->
                    <Border x:Name="ControlCard" Grid.Row="3" Style="{StaticResource FluentCardStyle}">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="1">
                                    <TextBlock x:Name="TxtChartTitle" Style="{StaticResource SectionHeaderStyle}" Text="图表" />
                                    <TextBlock x:Name="TxtChartHint" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <CheckBox x:Name="ChkFill" Content="面积" FontSize="12" MinWidth="0" IsChecked="True"
                                              Checked="ChartOption_Changed" Unchecked="ChartOption_Changed"
                                              ToolTipService.ToolTip="给每张图表的曲线填充面积色" />
                                    <Button Content="重置范围" FontSize="14" Padding="8,4" Click="ResetRange_Click" />
                                </StackPanel>
                            </Grid>

                            <!-- 指标标签：点击增删对应图表；每个指标一张图，各自拥有独立的纵轴量程 -->
                            <StackPanel x:Name="PnlLegend" Grid.Row="1" Spacing="8" SizeChanged="Legend_SizeChanged" />

                            <Grid Grid.Row="2" RowSpacing="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="起点" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Slider x:Name="SliderFrom" Grid.Column="1" Minimum="0" Maximum="1" StepFrequency="1"
                                            ValueChanged="Range_Changed" />
                                    <TextBlock x:Name="TxtFrom" Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                                               Width="60" TextAlignment="Right"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="—" />
                                </Grid>
                                <Grid Grid.Row="1" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="终点" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Slider x:Name="SliderTo" Grid.Column="1" Minimum="0" Maximum="1" StepFrequency="1"
                                            ValueChanged="Range_Changed" />
                                    <TextBlock x:Name="TxtTo" Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                                               Width="60" TextAlignment="Right"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="—" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 图表区：一个指标一张图，每条曲线都用自己的纵轴刻度尺（100 FPS 不会把 1 ms 压成直线） -->
                    <Grid Grid.Row="4">
                        <StackPanel x:Name="PnlCharts" Spacing="8" />
                        <StackPanel x:Name="PnlChartEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Spacing="8" Visibility="Collapsed">
                            <FontIcon x:Name="IcoEmpty" Glyph="&#xE9D2;" FontSize="28"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock x:Name="TxtEmpty" Text="没有可展示的数据" FontSize="14"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       TextAlignment="Center" MaxWidth="320" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <!-- 全量统计（基于全部样本，与图表显隐无关） -->
                    <Border x:Name="StatsCard" Grid.Row="5" Style="{StaticResource FluentCardStyle}">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" ColumnSpacing="8" Padding="4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="指标" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Grid.Column="1" Text="最小" FontSize="12" TextAlignment="Right" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Grid.Column="2" Text="平均" FontSize="12" TextAlignment="Right" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Grid.Column="3" Text="最大" FontSize="12" TextAlignment="Right" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Grid.Column="4" Text="P1" FontSize="12" TextAlignment="Right" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Grid.Column="5" Text="P99" FontSize="12" TextAlignment="Right" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Grid.Column="6" Text="样本" FontSize="12" TextAlignment="Right" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </Grid>
                            <ListView x:Name="StatsList" Grid.Row="1" MaxHeight="168" SelectionMode="None"
                                      Background="Transparent" BorderThickness="0" IsItemClickEnabled="False">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="8" Padding="4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="76" />
                                                <ColumnDefinition Width="76" />
                                                <ColumnDefinition Width="76" />
                                                <ColumnDefinition Width="76" />
                                                <ColumnDefinition Width="76" />
                                                <ColumnDefinition Width="70" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Metric}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Min}" FontSize="12" TextAlignment="Right" />
                                            <TextBlock Grid.Column="2" Text="{Binding Avg}" FontSize="12" TextAlignment="Right" />
                                            <TextBlock Grid.Column="3" Text="{Binding Max}" FontSize="12" TextAlignment="Right" />
                                            <TextBlock Grid.Column="4" Text="{Binding P1}" FontSize="12" TextAlignment="Right" />
                                            <TextBlock Grid.Column="5" Text="{Binding P99}" FontSize="12" TextAlignment="Right" />
                                            <TextBlock Grid.Column="6" Text="{Binding Count}" FontSize="12" TextAlignment="Right"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Status -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16" Padding="24,8,24,16">
            <TextBlock x:Name="TxtStatus" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="就绪" />
            <TextBlock x:Name="TxtRecordedCount" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="" />
        </StackPanel>

        <!-- Loading -->
        <Grid x:Name="LoadingOverlay" Grid.RowSpan="3" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
              Canvas.ZIndex="99">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <ProgressRing IsActive="True" Width="36" Height="36" />
                <TextBlock x:Name="TxtLoading" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="正在解析…" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
