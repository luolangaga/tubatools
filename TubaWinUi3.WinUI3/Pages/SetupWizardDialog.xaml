<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="TubaWinUi3.Pages.SetupWizardDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    PrimaryButtonClick="OnPrimaryButtonClick"
    SecondaryButtonClick="OnSecondaryButtonClick"
    CloseButtonClick="OnCloseButtonClick">

    <ContentDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <CornerRadius x:Key="DialogCornerRadius">12</CornerRadius>
        </ResourceDictionary>
    </ContentDialog.Resources>

    <Grid RowSpacing="16" MinWidth="480">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock
                x:Name="StepTitleText"
                FontSize="20"
                FontWeight="SemiBold" />
            <TextBlock
                x:Name="StepSubtitleText"
                FontSize="14"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <PipsPager
            x:Name="StepPager"
            Grid.Row="1"
            HorizontalAlignment="Left"
            NumberOfPages="4"
            SelectedPageIndex="0"
            Visibility="Visible" />

        <Grid Grid.Row="2" MinHeight="220">
            <StackPanel
                x:Name="Step0Content"
                Spacing="16"
                Visibility="Visible"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <FontIcon
                    FontSize="28"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Glyph="&#xE946;"
                    HorizontalAlignment="Center" />

                <TextBlock
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    HorizontalAlignment="Center">
                    <Run Text="官网：" /><Underline><Run x:Name="WebsiteRun" Text="tubawinui3.cn" /></Underline>
                </TextBlock>

                <HyperlinkButton
                    x:Name="VisitWebsiteButton"
                    Content="访问官网"
                    NavigateUri="https://tubawinui3.cn"
                    HorizontalAlignment="Center"
                    FontSize="14" />

                <Border
                    Padding="16,12"
                    Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                    BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    HorizontalAlignment="Center">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            HorizontalAlignment="Center"
                            Text="⚠ 该软件开源免费！" />
                        <TextBlock
                            FontSize="14"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            TextWrapping="Wrap"
                            TextAlignment="Center"
                            HorizontalAlignment="Center"
                            Text="如果你是付费获得的，说明你被骗了！！！" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel
                x:Name="Step1Content"
                Spacing="16"
                Visibility="Collapsed">

                <TextBlock
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="选择您喜欢的工具显示方式：" />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="CardModeOption"
                        Tag="Card"
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Tapped="LayoutOption_Tapped"
                        AutomationProperties.Name="新卡牌模式">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <Border
                                Width="56"
                                Height="56"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="12"
                                HorizontalAlignment="Center">
                                <FontIcon
                                    FontSize="28"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE8B7;" />
                            </Border>
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                Text="新卡牌模式" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                HorizontalAlignment="Center"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Text="卡片式布局，显示图标与详细信息" />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="CompactModeOption"
                        Grid.Column="1"
                        Tag="Compact"
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Tapped="LayoutOption_Tapped"
                        AutomationProperties.Name="简洁模式">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <Border
                                Width="56"
                                Height="56"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="12"
                                HorizontalAlignment="Center">
                                <FontIcon
                                    FontSize="28"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE8FD;" />
                            </Border>
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                Text="简洁模式" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                HorizontalAlignment="Center"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Text="紧凑排列，一屏显示更多工具" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <StackPanel
                x:Name="Step2Content"
                Spacing="16"
                Visibility="Collapsed">

                <TextBlock
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="选择窗口背景材质效果：" />

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="BackdropMicaOption"
                        Tag="Mica"
                        Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Tapped="BackdropOption_Tapped"
                        AutomationProperties.Name="Mica">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <Border
                                Width="80"
                                Height="52"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                HorizontalAlignment="Center">
                                <Border
                                    Margin="8"
                                    Padding="4"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    CornerRadius="4">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        HorizontalAlignment="Center"
                                        Text="Mica" />
                                </Border>
                            </Border>
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                Text="Mica" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                HorizontalAlignment="Center"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Text="柔和云母效果" />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="BackdropMicaAltOption"
                        Grid.Column="1"
                        Tag="MicaAlt"
                        Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Tapped="BackdropOption_Tapped"
                        AutomationProperties.Name="Mica Alt">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <Border
                                Width="80"
                                Height="52"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                HorizontalAlignment="Center">
                                <Border
                                    Margin="8"
                                    Padding="4"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    CornerRadius="4">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        HorizontalAlignment="Center"
                                        Text="Mica Alt" />
                                </Border>
                            </Border>
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                Text="Mica Alt" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                HorizontalAlignment="Center"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Text="层次更丰富的云母" />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="BackdropAcrylicOption"
                        Grid.Column="2"
                        Tag="Acrylic"
                        Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Tapped="BackdropOption_Tapped"
                        AutomationProperties.Name="亚克力">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <Border
                                Width="80"
                                Height="52"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                HorizontalAlignment="Center">
                                <Border
                                    Margin="8"
                                    Padding="4"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    CornerRadius="4">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        HorizontalAlignment="Center"
                                        Text="Acrylic" />
                                </Border>
                            </Border>
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                Text="亚克力" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                HorizontalAlignment="Center"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Text="磨砂玻璃模糊效果" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <StackPanel
                x:Name="Step3Content"
                Spacing="16"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <FontIcon
                    FontSize="28"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Glyph="&#xE721;"
                    HorizontalAlignment="Center" />

                <TextBlock
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="400"
                    Text="开启后，工具箱会为每个工具在开始菜单创建快捷方式。&#x0a;你可以直接按 Win 键搜索工具名称（如「CPU-Z」「GPU-Z」）来快速启动，无需先打开工具箱。&#x0a;支持多版本自动去重，卸载工具箱时会自动清理。" />

                <Border
                    Padding="16,12"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconBorderStyle}">
                            <FontIcon FontSize="18" Glyph="&#xE721;" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="注册到 Windows 搜索" />
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="按 Win 键搜索工具名直接启动，无需先打开工具箱" />
                        </StackPanel>
                        <ToggleSwitch x:Name="WizardSearchIndexToggle" Grid.Column="2" VerticalAlignment="Center" IsOn="False" />
                    </Grid>
                </Border>
                <Border
                    Padding="16,12"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconBorderStyle}">
                            <FontIcon FontSize="18" Glyph="&#xE921;" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="关闭主窗口时最小化到系统托盘" />
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="点关闭按钮不退出程序，留在托盘继续运行；默认关闭" />
                        </StackPanel>
                        <ToggleSwitch x:Name="WizardCloseToTrayToggle" Grid.Column="2" VerticalAlignment="Center" IsOn="False" />
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</ContentDialog>
