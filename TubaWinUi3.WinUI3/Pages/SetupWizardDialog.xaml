<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="TubaWinUi3.Pages.SetupWizardDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TubaWinUi3.Controls"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    SecondaryButtonClick="OnSecondaryButtonClick"
    CloseButtonClick="OnCloseButtonClick"
    Opened="OnOpened" Closed="OnClosed">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">680</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">280</x:Double>
    </ContentDialog.Resources>
    <Grid x:Name="WizardRoot" Width="560" Height="540" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Width="48" Height="48" Source="ms-appx:///Assets/BuiltinIcons/quick-device-check.svg" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock x:Name="StepTitleText" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="StepSubtitleText" Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock x:Name="StepCountText" Grid.Column="2" VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    AutomationProperties.LiveSetting="Polite" />
            </Grid>
            <ProgressBar x:Name="StepProgress" Maximum="2" Value="1" IsTabStop="False" />
        </StackPanel>
        <Grid x:Name="StepHost" Grid.Row="1">
            <Grid.RenderTransform><TranslateTransform x:Name="StepSlide" /></Grid.RenderTransform>
            <ScrollViewer x:Name="PreferencesPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                <StackPanel Spacing="16" Padding="0,0,8,4">
                    <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Image Width="40" Height="40" Source="ms-appx:///Assets/BuiltinIcons/official-websites.svg" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="开源免费，放心使用" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="两步完成初始设置，以后随时可以调整。" TextWrapping="Wrap"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <HyperlinkButton Content="官方网站 · tubawinui3.cn" NavigateUri="https://tubawinui3.cn"
                                    Padding="0" HorizontalAlignment="Left" AutomationProperties.AutomationId="WizardWebsite" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Image Width="32" Height="32" VerticalAlignment="Top" Source="ms-appx:///Assets/BuiltinIcons/display-tools.svg" />
                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock Text="工具显示方式" FontWeight="SemiBold" />
                            <RadioButtons x:Name="LayoutChoices" MaxColumns="1"
                                AutomationProperties.AutomationId="WizardLayout">
                                <RadioButton Tag="Card" AutomationProperties.AutomationId="WizardCardMode"
                                    AutomationProperties.Name="默认模式（卡片），推荐新手使用">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="默认模式（卡片）" FontWeight="SemiBold" />
                                        <TextBlock Text="推荐新手使用，工具信息更直观。" TextWrapping="Wrap"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Tag="Compact" AutomationProperties.AutomationId="WizardCompactMode"
                                    AutomationProperties.Name="简洁模式，与原版图吧工具箱一致">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="简洁模式" FontWeight="SemiBold" />
                                        <TextBlock Text="与原版图吧工具箱一致，适合习惯原版界面的用户。" TextWrapping="Wrap"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </RadioButton>
                            </RadioButtons>

                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Image Width="32" Height="32" VerticalAlignment="Top" Source="ms-appx:///Assets/BuiltinIcons/windows-feature.svg" />
                        <ComboBox x:Name="BackdropChoices" Grid.Column="1" Header="窗口背景" HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="WizardBackdrop">
                            <ComboBoxItem Content="云母 · 柔和自然" Tag="Mica" />
                            <ComboBoxItem Content="云母 Alt · 层次更丰富" Tag="MicaAlt" />
                            <ComboBoxItem Content="亚克力 · 磨砂玻璃" Tag="Acrylic" />
                            <ComboBoxItem Content="轻亚克力 · 更通透" Tag="AcrylicThin" />
                        </ComboBox>
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Image Width="32" Height="32" VerticalAlignment="Top" Source="ms-appx:///Assets/BuiltinIcons/energy-star.svg" />
                        <ToggleSwitch x:Name="WizardCloseToTrayToggle" Grid.Column="1" Header="关闭窗口后留在系统托盘"
                            OnContent="关闭后继续在后台运行" OffContent="关闭窗口时退出程序（默认）"
                            AutomationProperties.AutomationId="WizardCloseToTray" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
            <controls:SearchToolPicker x:Name="SearchPicker" Visibility="Collapsed" StateChanged="SearchPicker_StateChanged" />
        </Grid>
    </Grid>
</ContentDialog>
