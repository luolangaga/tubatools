<?xml version="1.0" encoding="utf-8" ?>
<Page
    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
    x:Class="TubaWinUi3.Pages.WingetStorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TubaWinUi3.Controls"
    xmlns:models="using:TubaWinUi3.Models"
    NavigationCacheMode="Enabled">
    <Page.Resources>
        <CollectionViewSource x:Name="StoreGroups" IsSourceGrouped="True" />
        <!-- Keep the platform item presenter: keyboard focus, pointer and contrast states. -->
        <Style x:Key="StoreCardItemStyle" TargetType="GridViewItem">
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <DataTemplate x:Key="PackageTemplate" x:DataType="models:StorePackage">
            <Grid Padding="16" RowSpacing="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"
                  AutomationProperties.Name="{x:Bind AccessibleName}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <TextBlock Text="{x:Bind Monogram}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Category}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
                <TextBlock Grid.Row="1" Text="{x:Bind Description}" TextWrapping="Wrap" MaxLines="2"
                           TextTrimming="CharacterEllipsis" LineHeight="20"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Grid Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind SourceLabel}" Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <Button Grid.Column="1" Content="{x:Bind ActionLabel}" IsEnabled="{x:Bind CanInstall}" Tag="{x:Bind}" Click="InstallButton_Click"
                            Loaded="InstallButton_Loaded" MinWidth="80" AutomationProperties.Name="{x:Bind Name}" />
                </Grid>
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <Grid x:Name="LayoutRoot" Padding="24,4,24,24" RowSpacing="16">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                    <VisualState.Setters><Setter Target="LayoutRoot.Padding" Value="12,4,12,16" /></VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="800" /></VisualState.StateTriggers>
                    <VisualState.Setters><Setter Target="LayoutRoot.Padding" Value="24,4,24,24" /></VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:ToolPageHeader x:Name="PageHeader" ToolId="winget-store" HeaderPadding="0"
            Title="正版应用商店" Subtitle="精选日常应用与 AI Agent，从官方渠道开始。" Glyph="&#xE719;" />
        <AutoSuggestBox x:Name="SearchBox" Grid.Row="1" Header="搜索应用" PlaceholderText="搜索名称、用途或 WinGet 包 ID"
            QueryIcon="Find" TextChanged="SearchBox_TextChanged" QuerySubmitted="SearchBox_QuerySubmitted"
            KeyDown="SearchBox_KeyDown" AutomationProperties.AutomationId="StoreSearch" />
        <NavigationView x:Name="CategoryNavigation" Grid.Row="2" PaneDisplayMode="Top" IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False" IsPaneToggleButtonVisible="False" IsTitleBarAutoPaddingEnabled="False"
            SelectionChanged="CategoryNavigation_SelectionChanged" AutomationProperties.AutomationId="StoreCategories">
            <Grid Margin="0,12,0,0" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <InfoBar x:Name="SearchErrorBar" IsClosable="True" IsOpen="False" Severity="Warning" Title="在线搜索不可用" />
                <Grid Grid.Row="1">
                    <!-- One scrolling, virtualized collection for the whole storefront. -->
                    <GridView x:Name="PackageGrid" ItemsSource="{Binding Source={StaticResource StoreGroups}}"
                        ItemTemplate="{StaticResource PackageTemplate}" ItemContainerStyle="{StaticResource StoreCardItemStyle}"
                        SelectionMode="None" IsItemClickEnabled="True" ItemClick="PackageGrid_ItemClick"
                        SizeChanged="PackageGrid_SizeChanged" Padding="0,0,0,12"
                        ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        AutomationProperties.AutomationId="StorePackages">
                        <GridView.Header>
                            <Border x:Name="HomeIntro" Padding="20" Margin="0,0,12,20" CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="为下一件事，找到趁手的应用。" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="CatalogSummary" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="点击“安装”直接安装应用；DeepSeek Harness 使用官方安装包，可在下载中心查看进度。"
                                        TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </GridView.Header>
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="280" ItemHeight="204" /></ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.GroupStyle>
                            <GroupStyle HidesIfEmpty="True">
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate x:DataType="models:StoreSection">
                                        <StackPanel Spacing="4" Margin="0,0,12,12">
                                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                                            <TextBlock Text="{x:Bind Description}" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </GridView.GroupStyle>
                    </GridView>
                    <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="Collapsed">
                        <ProgressRing Width="32" Height="32" IsActive="True" HorizontalAlignment="Center" />
                        <TextBlock x:Name="LoadingText" Text="正在加载软件目录…" />
                    </StackPanel>
                    <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="420" Visibility="Collapsed">
                        <FontIcon Glyph="&#xE721;" FontSize="32" HorizontalAlignment="Center" />
                        <TextBlock x:Name="EmptyText" TextWrapping="Wrap" TextAlignment="Center" />
                        <Button Content="返回精选" Click="ResetButton_Click" HorizontalAlignment="Center" />
                        <Button Content="重新加载目录" Click="ReloadButton_Click" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Page>
