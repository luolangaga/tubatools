<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TubaWinUi3.Pages.DiskHealthPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:TubaWinUi3.Pages"
    xmlns:controls="using:TubaWinUi3.Controls"
    mc:Ignorable="d"
    Loaded="DiskHealthPage_Loaded"
    Unloaded="DiskHealthPage_Unloaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Padding="28,18,28,8" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 品牌渐变图标块 -->
            <Border Width="44" Height="44" CornerRadius="13">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#7C6CF0" />
                        <GradientStop Offset="1" Color="#5B8DEF" />
                    </LinearGradientBrush>
                </Border.Background>
                <FontIcon FontSize="20" Foreground="White" Glyph="&#xEDA8;" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <TextBlock FontSize="21" FontWeight="SemiBold" Text="磁盘健康" />
                <TextBlock FontSize="12" Opacity="0.65" Text="SMART 健康度检测 · CrystalDiskInfo 判定方案 · 环形图仪表盘" />
            </StackPanel>
            <Button x:Name="BackButton" Grid.Column="2" Click="BackButton_Click" Padding="10,5" VerticalAlignment="Center" Margin="0,0,8,0" Background="Transparent" BorderBrush="#26000000">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="12" />
                    <TextBlock Text="返回" FontSize="13" />
                </StackPanel>
            </Button>
            <Button x:Name="RefreshButton" Grid.Column="3" Click="RefreshButton_Click" Padding="12,5" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon x:Name="RefreshIcon" Glyph="&#xE72C;" FontSize="12" />
                    <TextBlock x:Name="RefreshText" Text="重新检测" FontSize="13" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 正文 -->
        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto" Padding="28,6,28,28">
            <StackPanel Spacing="16">

                <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True" Title="磁盘健康检测失败" />
                <InfoBar x:Name="SuccessBar" Severity="Success" IsOpen="False" IsClosable="True" />

                <!-- 加载中 -->
                <StackPanel x:Name="LoadingPanel" Visibility="Collapsed" Spacing="12" Padding="0,64">
                    <ProgressRing Width="42" Height="42" IsActive="True" HorizontalAlignment="Center" Foreground="#7C6CF0" />
                    <TextBlock FontSize="13" Opacity="0.7" HorizontalAlignment="Center" Text="正在扫描磁盘 SMART 信息…" />
                </StackPanel>

                <!-- 加载失败 / 空结果 -->
                <Border x:Name="ErrorPanel" Visibility="Collapsed" CornerRadius="22" Padding="24" BorderThickness="1" BorderBrush="#26F2503B">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#14F2503B" />
                            <GradientStop Offset="1" Color="#00000000" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Spacing="8" HorizontalAlignment="Center" Padding="0,18">
                        <FontIcon Glyph="&#xE7BA;" FontSize="30" Foreground="#F2503B" HorizontalAlignment="Center" />
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="磁盘健康信息加载失败" HorizontalAlignment="Center" />
                        <TextBlock x:Name="ErrorText" FontSize="12" Opacity="0.7" TextWrapping="Wrap" MaxWidth="520" TextAlignment="Center" />
                        <Button x:Name="RetryButton" Click="RetryButton_Click" Margin="0,8,0,0" HorizontalAlignment="Center" Content="重试" />
                    </StackPanel>
                </Border>

                <!-- 检测结果 -->
                <StackPanel x:Name="ContentPanel" Visibility="Collapsed" Spacing="16">

                    <!-- ═════════ 概览统计（4 枚小圆角芯片） ═════════ -->
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="#0D000000" BorderBrush="#1F000000" BorderThickness="1" CornerRadius="10" Padding="14,10">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#7C6CF0" VerticalAlignment="Center" />
                                <StackPanel Spacing="0">
                                    <TextBlock x:Name="TotalValue" FontSize="25" FontWeight="Bold" Text="--" Foreground="#7C6CF0" />
                                    <TextBlock FontSize="12" Opacity="0.6" Text="磁盘总数" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#0D000000" BorderBrush="#1F000000" BorderThickness="1" CornerRadius="10" Padding="14,10">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#2BB673" VerticalAlignment="Center" />
                                <StackPanel Spacing="0">
                                    <TextBlock x:Name="HealthyValue" FontSize="25" FontWeight="Bold" Text="--" Foreground="#2BB673" />
                                    <TextBlock FontSize="12" Opacity="0.6" Text="健康" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#0D000000" BorderBrush="#1F000000" BorderThickness="1" CornerRadius="10" Padding="14,10">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#F5A623" VerticalAlignment="Center" />
                                <StackPanel Spacing="0">
                                    <TextBlock x:Name="WarningValue" FontSize="25" FontWeight="Bold" Text="--" Foreground="#F5A623" />
                                    <TextBlock FontSize="12" Opacity="0.6" Text="警告" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Background="#0D000000" BorderBrush="#1F000000" BorderThickness="1" CornerRadius="10" Padding="14,10">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#F2503B" VerticalAlignment="Center" />
                                <StackPanel Spacing="0">
                                    <TextBlock x:Name="UnhealthyValue" FontSize="25" FontWeight="Bold" Text="--" Foreground="#F2503B" />
                                    <TextBlock FontSize="12" Opacity="0.6" Text="异常" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ═════════ 整体容量总览（大环图 + 分段条形图） ═════════ -->
                    <Border x:Name="CapacityPanel" Visibility="Collapsed" CornerRadius="24" Padding="22,20" BorderThickness="1" BorderBrush="#267C6CF0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#147C6CF0" />
                                <GradientStop Offset="1" Color="#00000000" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid ColumnSpacing="26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 总空间环图 -->
                            <Grid Width="148" Height="148">
                                <controls:RingGauge x:Name="OverviewRing" GaugeSize="148" StrokeThickness="14"
                                                    TrackBrush="#12000000" Stroke="#7C6CF0" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="-1">
                                    <TextBlock x:Name="OverviewPctText" FontSize="31" FontWeight="Bold" Foreground="#7C6CF0" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="OverviewUsedText" FontSize="12" Opacity="0.65" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="OverviewTotalText" FontSize="12" Opacity="0.65" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <!-- 分盘容量占用条形图 -->
                            <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Center">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Text="各分区容量占用" />
                                <StackPanel x:Name="OverviewDiskList" Spacing="12" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ═════════ 每块磁盘仪表盘 ═════════ -->
                    <ItemsControl x:Name="DiskList" ItemsSource="{x:Bind DiskCards}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:DiskCardVm">
                                <Border CornerRadius="24" Padding="22,20" BorderThickness="1" BorderBrush="#267C6CF0" Margin="0,0,0,2">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Offset="0" Color="#147C6CF0" />
                                            <GradientStop Offset="0.6" Color="#0A5B8DEF" />
                                            <GradientStop Offset="1" Color="#00000000" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel Spacing="18">

                                        <!-- 行 1：健康环 + 身份信息 + 温度环 -->
                                        <Grid ColumnSpacing="22">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 健康度环图 -->
                                            <Grid Width="106" Height="106" VerticalAlignment="Center">
                                                <controls:RingGauge GaugeSize="106" StrokeThickness="11"
                                                                    Value="{x:Bind HealthRingValue}" Stroke="{x:Bind HealthRingBrush}"
                                                                    TrackBrush="#12000000" />
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="-2">
                                                    <TextBlock FontSize="29" FontWeight="Bold" Text="{x:Bind HealthText}"
                                                               Foreground="{x:Bind HealthTextBrush}" HorizontalAlignment="Center" />
                                                    <TextBlock FontSize="11" Opacity="0.55" Text="健康度" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- 模型 + 小圆角提示框 -->
                                            <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
                                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="{x:Bind Model}"
                                                           TextTrimming="CharacterEllipsis" MaxLines="1" ToolTipService.ToolTip="{x:Bind Model}" />
                                                <TextBlock FontSize="13" Opacity="0.6" Text="{x:Bind SizeText}" />
                                                <ItemsControl ItemsSource="{x:Bind Tags}" Margin="0,2,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="6" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="local:DiskTagVm">
                                                            <Border Background="{x:Bind Background}" BorderBrush="#26000000"
                                                                    BorderThickness="1" CornerRadius="6" Padding="8,3">
                                                                <Grid ColumnSpacing="5">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="10" Foreground="{x:Bind Foreground}"
                                                                              Visibility="{x:Bind GlyphVisibility}" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold"
                                                                               Text="{x:Bind Text}" Foreground="{x:Bind Foreground}" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
</ItemsControl>
                                                <!-- 单项读取失败：在卡片上标记该盘错误，不拖垮整页 -->
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#F2503B"
                                                           TextWrapping="Wrap" MaxLines="2" Text="{x:Bind ErrorDetail}"
                                                           Visibility="{x:Bind ErrorDetailVisibility}"
                                                           ToolTipService.ToolTip="{x:Bind ErrorDetail}" />
                                        </StackPanel>

                                        <!-- 温度环图 -->
                                            <Grid Grid.Column="2" Width="64" Height="64" VerticalAlignment="Center">
                                                <controls:RingGauge GaugeSize="64" StrokeThickness="7"
                                                                    Value="{x:Bind TempRingValue}" Stroke="{x:Bind TempRingBrush}"
                                                                    TrackBrush="#12000000" />
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="-2">
                                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{x:Bind TempText}"
                                                               Foreground="{x:Bind TempRingBrush}" HorizontalAlignment="Center" />
                                                    <TextBlock FontSize="10" Opacity="0.55" Text="温度" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>

                                        <!-- 行 2：分区（占用环图 + 优化按钮） -->
                                        <ItemsControl ItemsSource="{x:Bind Partitions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="196" ItemHeight="116" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:PartitionVm">
                                                    <Border Background="#0D000000" BorderBrush="#1F000000" BorderThickness="1"
                                                            CornerRadius="14" Padding="14,12" Margin="0,0,10,10">
                                                        <StackPanel Spacing="10">
                                                            <Grid ColumnSpacing="10">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <controls:RingGauge GaugeSize="46" StrokeThickness="5"
                                                                                    Value="{x:Bind UsagePercent}" Stroke="{x:Bind UsageRingBrush}"
                                                                                    TrackBrush="#12000000" />
                                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{x:Bind DriveLetter}" />
                                                                        <TextBlock FontSize="11" Opacity="0.55" Text="{x:Bind Filesystem}" VerticalAlignment="Bottom" />
                                                                    </StackPanel>
                                                                    <TextBlock FontSize="12" Opacity="0.7" Text="{x:Bind UsageText}" />
                                                                </StackPanel>
                                                            </Grid>
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock FontSize="15" FontWeight="Bold" Text="{x:Bind PercentText}"
                                                                           Foreground="{x:Bind UsageRingBrush}" VerticalAlignment="Center" />
                                                                <Button Grid.Column="1" Padding="10,4" CornerRadius="7" Tag="{x:Bind Self}"
                                                                        Background="#14FFFFFF" BorderBrush="#33FFFFFF" FontSize="12">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <FontIcon Glyph="{x:Bind OptimizeGlyph}" FontSize="11" />
                                                                        <TextBlock Text="{x:Bind OptimizeText}" FontSize="12" />
                                                                    </StackPanel>
                                                                    <Button.Flyout>
                                                                        <Flyout Placement="BottomEdgeAlignedRight">
                                                                            <StackPanel Spacing="14" MaxWidth="300">
                                                                                <StackPanel Spacing="5">
                                                                                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="{x:Bind FlyoutTitle}" />
                                                                                    <TextBlock FontSize="12" Opacity="0.75" TextWrapping="Wrap" Text="{x:Bind FlyoutDesc}" />
                                                                                </StackPanel>
                                                                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                                                    <Button Content="取消" Click="CancelFlyout_Click" MinWidth="68" />
                                                                                    <Button Content="确认执行" Click="ConfirmOptimize_Click" Tag="{x:Bind Self}"
                                                                                            Style="{StaticResource AccentButtonStyle}" MinWidth="68" />
                                                                                </StackPanel>
                                                                            </StackPanel>
                                                                        </Flyout>
                                                                    </Button.Flyout>
                                                                </Button>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- 行 3：指标条（时间 / 次数 / 读写对比图 / 运行状态） -->
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Background="#0D000000" BorderBrush="#1F000000" BorderThickness="1" CornerRadius="12" Padding="13,11">
                                                <StackPanel Spacing="6">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE823;" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                                                        <TextBlock FontSize="12" Opacity="0.6" Text="通电时间" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock FontSize="19" FontWeight="SemiBold" Text="{x:Bind PowerOnHoursText}" />
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="1" Background="#0D000000" BorderBrush="#1F000000" BorderThickness="1" CornerRadius="12" Padding="13,11">
                                                <StackPanel Spacing="6">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE7E8;" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                                                        <TextBlock FontSize="12" Opacity="0.6" Text="通电次数" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock FontSize="19" FontWeight="SemiBold" Text="{x:Bind PowerOnCountText}" />
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="2" Background="#0D000000" BorderBrush="#1F000000" BorderThickness="1" CornerRadius="12" Padding="13,11">
                                                <StackPanel Spacing="7">
                                                    <TextBlock FontSize="12" Opacity="0.6" Text="数据读写对比" />
                                                    <StackPanel Spacing="5">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock FontSize="12" Opacity="0.75" Text="{x:Bind DataReadText}" TextTrimming="CharacterEllipsis" />
                                                            <ProgressBar Grid.Column="1" Height="6" VerticalAlignment="Center" Minimum="0"
                                                                         Maximum="{x:Bind ReadWriteMax}" Value="{x:Bind DataReadGb}"
                                                                         Foreground="{x:Bind ReadBarBrush}" />
                                                        </Grid>
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock FontSize="12" Opacity="0.75" Text="{x:Bind DataWrittenText}" TextTrimming="CharacterEllipsis" />
                                                            <ProgressBar Grid.Column="1" Height="6" VerticalAlignment="Center" Minimum="0"
                                                                         Maximum="{x:Bind ReadWriteMax}" Value="{x:Bind DataWriteGb}"
                                                                         Foreground="{x:Bind WriteBarBrush}" />
                                                        </Grid>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="3" Background="#0D000000" BorderBrush="#1F000000" BorderThickness="1" CornerRadius="12" Padding="13,11">
                                                <StackPanel Spacing="6">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE80F;" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                                                        <TextBlock FontSize="12" Opacity="0.6" Text="运行状态" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock FontSize="19" FontWeight="SemiBold" Text="{x:Bind OperationalText}"
                                                               Foreground="{x:Bind OperationalBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock FontSize="12" Opacity="0.6"
                               Text="SSD 执行 TRIM 优化（前台快速完成），机械盘碎片整理在后台低优先级运行，可继续正常使用电脑。" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>