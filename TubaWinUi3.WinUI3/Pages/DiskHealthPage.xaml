<?xml version="1.0" encoding="utf-8" ?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:l="using:WinUI3Localizer" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="using:TubaWinUi3.Pages" xmlns:controls="using:TubaWinUi3.Controls" x:Class="TubaWinUi3.Pages.DiskHealthPage" mc:Ignorable="d" Loaded="DiskHealthPage_Loaded" Unloaded="DiskHealthPage_Unloaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <controls:ToolPageHeader ToolId="disk-health" Grid.Row="0" Title="磁盘健康" Subtitle="SMART 健康度检测 · CrystalDiskInfo 判定方案 · 环形图仪表盘" Glyph="&#xEDA8;" l:Uids.Uid="DiskHealth_PageHeader">
            <controls:ToolPageHeader.Actions>
                <Button x:Name="RefreshButton" Click="RefreshButton_Click" Style="{StaticResource ToolHeaderActionButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:Name="RefreshIcon" Glyph="&#xE72C;" FontSize="12"/>
                        <TextBlock x:Name="RefreshText" Text="重新检测" l:Uids.Uid="DiskHealth_Refresh"/>
                    </StackPanel>
                </Button>
            </controls:ToolPageHeader.Actions>
        </controls:ToolPageHeader>
        <!-- 正文 -->
        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="24,4,24,32" HorizontalContentAlignment="Stretch" controls:ToolViewport.ConstrainContent="True">
            <StackPanel Spacing="24" MaxWidth="1120">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromHorizontalOffset="0" FromVerticalOffset="24" IsStaggeringEnabled="True"/>
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True" Title="磁盘健康检测失败" l:Uids.Uid="DiskHealth_ErrorTitle"/>
                <InfoBar x:Name="SuccessBar" Severity="Success" IsOpen="False" IsClosable="True"/>
                <!-- 加载中 -->
                <StackPanel x:Name="LoadingPanel" Visibility="Collapsed" Spacing="12" Padding="0,64">
                    <ProgressRing Width="42" Height="42" IsActive="True" HorizontalAlignment="Center"/>
                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Text="正在扫描磁盘 SMART 信息…" l:Uids.Uid="DiskHealth_Scanning"/>
                </StackPanel>
                <!-- 加载失败 / 空结果 -->
                <Border x:Name="ErrorPanel" Visibility="Collapsed" CornerRadius="8" Padding="24" BorderThickness="1" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" BorderBrush="{ThemeResource SystemFillColorCriticalBrush}">
                    <StackPanel Spacing="8" HorizontalAlignment="Center" Padding="0,18">
                        <FontIcon Glyph="&#xE7BA;" FontSize="28" Foreground="{ThemeResource SystemFillColorCriticalBrush}" HorizontalAlignment="Center"/>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="磁盘健康信息加载失败" l:Uids.Uid="DiskHealth_LoadFailed" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ErrorText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxWidth="520" TextAlignment="Center"/>
                        <Button x:Name="RetryButton" Click="RetryButton_Click" Margin="0,8,0,0" HorizontalAlignment="Center" Content="重试" l:Uids.Uid="DiskHealth_Retry"/>
                    </StackPanel>
                </Border>
                <!-- 检测结果 -->
                <StackPanel x:Name="ContentPanel" Visibility="Collapsed" Spacing="16">
                    <!-- ═════════ 概览统计（4 枚小圆角芯片） ═════════ -->
                    <Grid ColumnSpacing="24" Style="{StaticResource ToolSummaryStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border>
                            <StackPanel Spacing="0">
                                <TextBlock x:Name="TotalValue" FontSize="20" FontWeight="SemiBold" Text="--" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="磁盘总数" l:Uids.Uid="DiskHealth_TotalDisks"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1">
                            <StackPanel Spacing="0">
                                <TextBlock x:Name="HealthyValue" FontSize="20" FontWeight="SemiBold" Text="--" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="健康" l:Uids.Uid="DiskHealth_Healthy"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2">
                            <StackPanel Spacing="0">
                                <TextBlock x:Name="WarningValue" FontSize="20" FontWeight="SemiBold" Text="--" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="警告" l:Uids.Uid="DiskHealth_Warning"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3">
                            <StackPanel Spacing="0">
                                <TextBlock x:Name="UnhealthyValue" FontSize="20" FontWeight="SemiBold" Text="--" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="异常" l:Uids.Uid="DiskHealth_Critical"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <!-- ═════════ 整体容量总览（大环图 + 分段条形图） ═════════ -->
                    <Border x:Name="CapacityPanel" Visibility="Collapsed" CornerRadius="8" Padding="16" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- 总空间环图 -->
                            <Grid Width="148" Height="148">
                                <controls:RingGauge x:Name="OverviewRing" GaugeSize="148" StrokeThickness="14" Stroke="{ThemeResource AccentFillColorDefaultBrush}"/>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="-1">
                                    <TextBlock x:Name="OverviewPctText" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="OverviewUsedText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="OverviewTotalText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <!-- 分盘容量占用条形图 -->
                            <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="各分区容量占用" l:Uids.Uid="DiskHealth_PartitionUsage"/>
                                <StackPanel x:Name="OverviewDiskList" Spacing="12"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- ═════════ 每块磁盘仪表盘 ═════════ -->
                    <ItemsControl x:Name="DiskList" ItemsSource="{x:Bind DiskCards}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:DiskCardVm">
                                <Border CornerRadius="8" Padding="16" BorderThickness="1" Margin="0,0,0,2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <StackPanel Spacing="16">
                                        <!-- 行 1：健康环 + 身份信息 + 温度环 -->
                                        <Grid ColumnSpacing="24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- 健康度环图 -->
                                            <Grid Width="76" Height="76" VerticalAlignment="Center">
                                                <controls:RingGauge GaugeSize="76" StrokeThickness="7" Value="{x:Bind HealthRingValue}" Stroke="{x:Bind HealthRingBrush}"/>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="-2">
                                                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="{x:Bind HealthText}" Foreground="{x:Bind HealthTextBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="健康度" l:Uids.Uid="DiskHealth_HealthLabel" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                            <!-- 模型 + 小圆角提示框 -->
                                            <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="{x:Bind Model}" TextTrimming="CharacterEllipsis" MaxLines="2" ToolTipService.ToolTip="{x:Bind Model}" TextWrapping="Wrap"/>
                                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind SizeText}"/>
                                                <ItemsControl ItemsSource="{x:Bind Tags}" Margin="0,2,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="6"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="local:DiskTagVm">
                                                            <Border Background="{x:Bind Background}" Style="{StaticResource StatusPillStyle}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                                <Grid ColumnSpacing="5">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="12" Foreground="{x:Bind Foreground}" Visibility="{x:Bind GlyphVisibility}" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Text="{x:Bind Text}" Foreground="{x:Bind Foreground}"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <!-- 单项读取失败：在卡片上标记该盘错误，不拖垮整页 -->
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" MaxLines="2" Text="{x:Bind ErrorDetail}" Visibility="{x:Bind ErrorDetailVisibility}" ToolTipService.ToolTip="{x:Bind ErrorDetail}"/>
                                            </StackPanel>
                                            <!-- 温度环图 -->
                                            <Grid Grid.Column="2" Width="64" Height="64" VerticalAlignment="Center">
                                                <controls:RingGauge GaugeSize="64" StrokeThickness="7" Value="{x:Bind TempRingValue}" Stroke="{x:Bind TempRingBrush}"/>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="-2">
                                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{x:Bind TempText}" Foreground="{x:Bind TempRingBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="温度" l:Uids.Uid="DiskHealth_TempLabel" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                        <!-- 行 2：分区（占用环图 + 优化按钮） -->
                                        <ItemsControl ItemsSource="{x:Bind Partitions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="8"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:PartitionVm">
                                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0">
                                                        <Grid ColumnSpacing="16">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <controls:RingGauge GaugeSize="46" StrokeThickness="5" Value="{x:Bind UsagePercent}" Stroke="{x:Bind UsageRingBrush}"/>
                                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="{x:Bind DriveLetter}"/>
                                                                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind Filesystem}" VerticalAlignment="Bottom"/>
                                                                    </StackPanel>
                                                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind UsageText}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                            <Grid ColumnSpacing="8" Grid.Column="1">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock FontSize="14" FontWeight="SemiBold" Text="{x:Bind PercentText}" Foreground="{x:Bind UsageRingBrush}" VerticalAlignment="Center"/>
                                                                <Button Grid.Column="1" Padding="10,4" Tag="{x:Bind Self}" FontSize="14">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <FontIcon Glyph="{x:Bind OptimizeGlyph}" FontSize="12"/>
                                                                        <TextBlock Text="{x:Bind OptimizeText}" FontSize="12"/>
                                                                    </StackPanel>
                                                                    <Button.Flyout>
                                                                        <Flyout Placement="BottomEdgeAlignedRight">
                                                                            <StackPanel Spacing="14" MaxWidth="300">
                                                                                <StackPanel Spacing="5">
                                                                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="{x:Bind FlyoutTitle}"/>
                                                                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="{x:Bind FlyoutDesc}"/>
                                                                                </StackPanel>
                                                                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                                                    <Button Content="取消" l:Uids.Uid="DiskHealth_Cancel" Click="CancelFlyout_Click" MinWidth="68"/>
                                                                                    <Button Content="确认执行" l:Uids.Uid="DiskHealth_Confirm" Click="ConfirmOptimize_Click" Tag="{x:Bind Self}" Style="{StaticResource AccentButtonStyle}" MinWidth="68"/>
                                                                                </StackPanel>
                                                                            </StackPanel>
                                                                        </Flyout>
                                                                    </Button.Flyout>
                                                                </Button>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- 行 3：指标条（时间 / 次数 / 读写对比图 / 运行状态） -->
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                                <StackPanel Spacing="6">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE823;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="通电时间" l:Uids.Uid="DiskHealth_PowerOnHours" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{x:Bind PowerOnHoursText}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                                <StackPanel Spacing="6">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE7E8;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="通电次数" l:Uids.Uid="DiskHealth_PowerOnCount" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{x:Bind PowerOnCountText}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                                <StackPanel Spacing="7">
                                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="数据读写对比" l:Uids.Uid="DiskHealth_RwCompare"/>
                                                    <StackPanel Spacing="5">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind DataReadText}" TextTrimming="CharacterEllipsis"/>
                                                            <ProgressBar Grid.Column="1" Height="6" VerticalAlignment="Center" Minimum="0" Maximum="{x:Bind ReadWriteMax}" Value="{x:Bind DataReadGb}" Foreground="{x:Bind ReadBarBrush}"/>
                                                        </Grid>
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind DataWrittenText}" TextTrimming="CharacterEllipsis"/>
                                                            <ProgressBar Grid.Column="1" Height="6" VerticalAlignment="Center" Minimum="0" Maximum="{x:Bind ReadWriteMax}" Value="{x:Bind DataWriteGb}" Foreground="{x:Bind WriteBarBrush}"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="3" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                                <StackPanel Spacing="6">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE80F;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="运行状态" l:Uids.Uid="DiskHealth_OperationalStatus" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{x:Bind OperationalText}" Foreground="{x:Bind OperationalBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="SSD 执行 TRIM 优化（前台快速完成），机械盘碎片整理在后台低优先级运行，可继续正常使用电脑。"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
