<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TubaWinUi3.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="using:WinUI3Localizer"
    xmlns:local="using:TubaWinUi3.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Page.Resources>
        <local:FavGlyphConverter x:Key="FavGlyphConverter" />
        <local:InvertBoolToVisibilityConverter x:Key="InvertBoolToVis" />
        <local:NullToVisibilityConverter x:Key="NullToCollapse" />
        <local:HasAlternatesToVisibilityConverter x:Key="HasAlternatesToVis" />
        <local:NoAlternatesToVisibilityConverter x:Key="NoAlternatesToVis" />

        <local:ZeroToIndeterminateConverter x:Key="ZeroIsIndeterminate" />
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
        <local:InvertBoolToVisibilityConverter x:Key="InvertBoolToVis2" />
        <Style x:Key="CompactSearchBoxStyle" TargetType="AutoSuggestBox">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MaxHeight" Value="32" />
            <Setter Property="Padding" Value="8,2,8,2" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="ToolCardStyle" TargetType="GridViewItem">
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewItem">
                        <Grid x:Name="RootGrid" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="ItemScale" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition To="PointerOver" GeneratedDuration="0:0:0.18">
                                            <VisualTransition.GeneratedEasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </VisualTransition.GeneratedEasingFunction>
                                        </VisualTransition>
                                        <VisualTransition To="Pressed" GeneratedDuration="0:0:0.08">
                                            <VisualTransition.GeneratedEasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </VisualTransition.GeneratedEasingFunction>
                                        </VisualTransition>
                                        <VisualTransition To="Normal" GeneratedDuration="0:0:0.25">
                                            <VisualTransition.GeneratedEasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </VisualTransition.GeneratedEasingFunction>
                                        </VisualTransition>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ItemScale.ScaleX" Value="1.03" />
                                            <Setter Target="ItemScale.ScaleY" Value="1.03" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ItemScale.ScaleX" Value="0.97" />
                                            <Setter Target="ItemScale.ScaleY" Value="0.97" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="SelectionStates">
                                    <VisualState x:Name="Unselected" />
                                    <VisualState x:Name="Selected" />
                                    <VisualState x:Name="SelectedUnfocused" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CompactCardStyle" TargetType="GridViewItem">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewItem">
                        <Grid x:Name="RootGrid" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="ItemScale" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition To="PointerOver" GeneratedDuration="0:0:0.18">
                                            <VisualTransition.GeneratedEasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </VisualTransition.GeneratedEasingFunction>
                                        </VisualTransition>
                                        <VisualTransition To="Pressed" GeneratedDuration="0:0:0.08">
                                            <VisualTransition.GeneratedEasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </VisualTransition.GeneratedEasingFunction>
                                        </VisualTransition>
                                        <VisualTransition To="Normal" GeneratedDuration="0:0:0.25">
                                            <VisualTransition.GeneratedEasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </VisualTransition.GeneratedEasingFunction>
                                        </VisualTransition>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ItemScale.ScaleX" Value="1.04" />
                                            <Setter Target="ItemScale.ScaleY" Value="1.04" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ItemScale.ScaleX" Value="0.96" />
                                            <Setter Target="ItemScale.ScaleY" Value="0.96" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="SelectionStates">
                                    <VisualState x:Name="Unselected" />
                                    <VisualState x:Name="Selected" />
                                    <VisualState x:Name="SelectedUnfocused" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid x:Name="RootLayout" AllowDrop="True">
        <Grid Padding="28,18,28,24" RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        x:Name="CategoryTitle"
                        FontSize="30"
                        FontWeight="Bold" />
                    <TextBlock
                        x:Name="ToolCountText"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,4"
                        FontSize="14"
                        Opacity="1.0" />
                </StackPanel>
                <TextBlock
                    x:Name="CategorySubtitle"
                    Opacity="1.0" />
            </StackPanel>

            <Button
                x:Name="EditOrderButton"
                Grid.Column="1"
                VerticalAlignment="Center"
                Padding="12,6"
                Click="EditOrderButton_Click"
                ToolTipService.ToolTip="进入排序模式，按住卡片上下拖动调整顺序"
                l:Uids.Uid="HomePage_EditOrderButton"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon x:Name="EditOrderIcon" FontSize="12" Glyph="&#xE70F;" />
                    <TextBlock x:Name="EditOrderButtonText" Text="编辑排序" l:Uids.Uid="HomePage_EditOrderButtonText" />
                </StackPanel>
            </Button>

        </Grid>

        <Grid
            x:Name="TagBarArea"
            Grid.Row="1"
            Visibility="Collapsed">

            <!-- 分类标签：CommandBar 放不下的标签自动折叠进溢出菜单 -->
            <CommandBar
                x:Name="TagBarCommandBar"
                Background="Transparent"
                BorderBrush="Transparent"
                DefaultLabelPosition="Right" />
        </Grid>

        <Grid Grid.Row="2">
            <GridView
                x:Name="ToolsGrid"
                IsItemClickEnabled="True"
                ItemClick="ToolsGrid_ItemClick"
                DoubleTapped="ToolsGrid_DoubleTapped"
                DragItemsCompleted="Grid_DragItemsCompleted"
                ItemContainerStyle="{StaticResource ToolCardStyle}"
                Footer=""
                SelectionMode="None"
                SizeChanged="ToolsGrid_SizeChanged"
                Visibility="Collapsed"
                RenderTransformOrigin="0.5,0.5">
                    <GridView.RenderTransform>
                        <TranslateTransform x:Name="GridTranslate" />
                    </GridView.RenderTransform>
                    <GridView.Transitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="24" FromHorizontalOffset="0" IsStaggeringEnabled="True" />
                        </TransitionCollection>
                    </GridView.Transitions>
                    <GridView.Resources>
                        <MenuFlyout x:Key="NormalItemFlyout">
                            <MenuFlyoutItem x:Name="NormalMenuToggleFavorite" Text="收藏" Click="NormalMenu_ToggleFavorite">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE734;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="NormalMenuSendToDesktop" Text="发送到桌面快捷方式" Click="NormalMenu_SendToDesktop" l:Uids.Uid="Common_SendToDesktop">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8AD;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="NormalMenuRunAsAdmin" Text="以管理员身份运行" Click="NormalMenu_RunAsAdmin" Icon="Admin" l:Uids.Uid="Common_RunAsAdmin" />
                            <MenuFlyoutItem x:Name="NormalMenuOpenDirectory" Text="打开工具所在目录" Click="NormalMenu_OpenDirectory" Icon="Folder" l:Uids.Uid="Common_OpenLocation" />
                            <MenuFlyoutItem x:Name="NormalMenuOpenTutorial" Text="打开教程" Click="NormalMenu_OpenTutorial" Visibility="Collapsed" l:Uids.Uid="Common_OpenTutorial">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8A1;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSubItem x:Name="NormalArchSubmenu" Text="选择架构" Visibility="Collapsed" l:Uids.Uid="Common_SelectArch">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon Glyph="&#xE912;" />
                                </MenuFlyoutSubItem.Icon>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="NormalMenuDeleteTool" Text="删除工具" Click="NormalMenu_DeleteTool" Foreground="{ThemeResource SystemFillColorCriticalBrush}" l:Uids.Uid="Common_DeleteTool">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </GridView.Resources>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="16"
                                MinHeight="220"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                RightTapped="NormalItem_RightTapped">
                                    <Grid RowSpacing="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="44" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid ColumnSpacing="12">
                                         <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="56" />
                                             <ColumnDefinition Width="*" />
                                             <ColumnDefinition Width="Auto" />
                                         </Grid.ColumnDefinitions>
                                         <Border
                                             Width="56"
                                             Height="56"
                                             Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                             CornerRadius="8">
                                             <Grid>
                                                 <Image
                                                     Width="40"
                                                     Height="40"
                                                     Source="{Binding IconPath}"
                                                     Stretch="Uniform"
                                                     Visibility="{Binding IconPath, Converter={StaticResource NullToCollapse}}" />
                                                 <Image
                                                     Width="40"
                                                     Height="40"
                                                     Source="{Binding IconSource}"
                                                     Stretch="Uniform"
                                                     Visibility="{Binding IconSource, Converter={StaticResource NullToCollapse}}" />
                                                 <FontIcon
                                                     FontSize="28"
                                                     Glyph="{Binding IconGlyph}"
                                                     Visibility="{Binding IconGlyph, Converter={StaticResource NullToCollapse}}" />
                                             </Grid>
                                         </Border>
                                         <StackPanel Grid.Column="1" Spacing="3">
                                             <TextBlock

                                                 FontSize="18"
                                                 FontWeight="Bold"
                                                 MaxLines="1"
                                                 Text="{Binding Name}"
                                                 TextTrimming="CharacterEllipsis" />
                                             <StackPanel Orientation="Horizontal" Spacing="4">
                                                 <TextBlock

                                                     FontSize="12"
                                                     Opacity="1.0"
                                                     Text="{Binding CategoryDisplay}"
                                                     TextTrimming="CharacterEllipsis" />
                                                 <TextBlock

                                                     FontSize="12"
                                                     Opacity="1.0"
                                                     Text="{Binding CategoriesDisplay}"
                                                     TextTrimming="CharacterEllipsis"
                                                     Visibility="{Binding CategoriesDisplay, Converter={StaticResource NullToCollapse}}" />
                                             </StackPanel>
                                         </StackPanel>
                                        <Button
                                            Grid.Column="2"
                                            Width="32"
                                            Height="32"
                                            Padding="0"
                                            VerticalAlignment="Top"
                                            Click="FavoriteButton_Click"
                                            ToolTipService.ToolTip="收藏"
                                            l:Uids.Uid="HomePage_FavoriteButton">
                                            <FontIcon
                                                FontSize="14"
                                                Glyph="{Binding IsFavorite, Converter={StaticResource FavGlyphConverter}}" />
                                        </Button>
                                    </Grid>

                                    <TextBlock
                                        Grid.Row="1"

                                        MaxLines="2"
                                        Opacity="1.0"
                                        Text="{Binding Description}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="2"

                                        FontSize="10"
                                        MaxLines="1"
                                        Opacity="1.0"
                                        Text="{Binding TagsText}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{Binding TagsText, Converter={StaticResource NullToCollapse}}" />

                                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6">
                                        <Border
                                            VerticalAlignment="Center"
                                            Padding="8,3"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="6">
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Text="{Binding Extension}" />
                                        </Border>

                                    </StackPanel>

                                    <Grid Grid.Row="4" ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Padding="0"
                                            Click="SendToDesktopButton_Click"
                                            ToolTipService.ToolTip="发送到桌面快捷方式"
                                            l:Uids.Uid="HomePage_SendToDesktopButton"
                                            Visibility="{Binding CanSendToDesktop, Converter={StaticResource BoolToVis}}">
                                            <FontIcon FontSize="12" Glyph="&#xE8AD;" />
                                        </Button>
                                        <Button
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Padding="0"
                                            Click="RunAsAdminButton_Click"
                                            ToolTipService.ToolTip="以管理员身份运行"
                                            l:Uids.Uid="HomePage_RunAsAdminButton"
                                            Visibility="{Binding NeedsDownload, Converter={StaticResource InvertBoolToVis}}">
                                            <FontIcon FontSize="12" Glyph="&#xE7EF;" />
                                        </Button>
                                        <Button
                                            Grid.Column="2"
                                            MinWidth="88"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Padding="10,4"
                                            Click="LaunchButton_Click"
                                            IsEnabled="{Binding CanLaunch}">
                                            <TextBlock

                                                Text="{Binding LaunchButtonText}"
                                                TextAlignment="Center"
                                                TextTrimming="CharacterEllipsis" />
                                        </Button>
                                    </Grid>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                    <GridView.FooterTemplate>
                        <DataTemplate>
                            <TextBlock
                                Margin="0,20,0,12"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                l:Uids.Uid="HomePage_DropHintFooter"
                                Text="拖入 zip/exe/ps1/bat 可添加自己的工具，右键可以对工具执行更多操作" />
                        </DataTemplate>
                    </GridView.FooterTemplate>
                </GridView>

            <GridView
                x:Name="CompactGrid"
                IsItemClickEnabled="True"
                ItemClick="CompactGrid_ItemClick"
                DoubleTapped="CompactGrid_DoubleTapped"
                DragItemsCompleted="Grid_DragItemsCompleted"
                ItemContainerStyle="{StaticResource CompactCardStyle}"
                Footer=""
                SelectionMode="None"
                SizeChanged="CompactGrid_SizeChanged"
                Visibility="Collapsed"
                RenderTransformOrigin="0.5,0.5">
                    <GridView.RenderTransform>
                        <TranslateTransform x:Name="CompactGridTranslate" />
                    </GridView.RenderTransform>
                    <GridView.Transitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="20" FromHorizontalOffset="0" IsStaggeringEnabled="True" />
                        </TransitionCollection>
                    </GridView.Transitions>
                    <GridView.Resources>
                        <MenuFlyout x:Key="CompactItemFlyout">
                            <MenuFlyoutItem x:Name="CompactMenuToggleFavorite" Text="收藏" Click="CompactMenu_ToggleFavorite">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE734;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="CompactMenuSendToDesktop" Text="发送到桌面快捷方式" Click="CompactMenu_SendToDesktop" l:Uids.Uid="Common_SendToDesktop">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8AD;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="CompactMenuRunAsAdmin" Text="以管理员身份运行" Click="CompactMenu_RunAsAdmin" Icon="Admin" l:Uids.Uid="Common_RunAsAdmin" />
                            <MenuFlyoutItem x:Name="CompactMenuOpenDirectory" Text="打开工具所在目录" Click="CompactMenu_OpenDirectory" Icon="Folder" l:Uids.Uid="Common_OpenLocation" />
                            <MenuFlyoutItem x:Name="CompactMenuOpenTutorial" Text="打开教程" Click="CompactMenu_OpenTutorial" Visibility="Collapsed" l:Uids.Uid="Common_OpenTutorial">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8A1;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSubItem x:Name="CompactArchSubmenu" Text="选择架构" Visibility="Collapsed" l:Uids.Uid="Common_SelectArch">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon Glyph="&#xE912;" />
                                </MenuFlyoutSubItem.Icon>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="CompactMenuDeleteTool" Text="删除工具" Click="CompactMenu_DeleteTool" Foreground="{ThemeResource SystemFillColorCriticalBrush}" l:Uids.Uid="Common_DeleteTool">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </GridView.Resources>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="8,10,8,6"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                RightTapped="CompactItem_RightTapped"
                                ToolTipService.ToolTip="{Binding Description}">
                                <StackPanel HorizontalAlignment="Center" Spacing="6">
                                    <Border
                                        Width="52"
                                        Height="52"
                                        HorizontalAlignment="Center"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="10">
                                        <Grid>
                                            <Image
                                                Width="38"
                                                Height="38"
                                                Source="{Binding IconPath}"
                                                Stretch="Uniform"
                                                Visibility="{Binding IconPath, Converter={StaticResource NullToCollapse}}" />
                                            <Image
                                                Width="38"
                                                Height="38"
                                                Source="{Binding IconSource}"
                                                Stretch="Uniform"
                                                Visibility="{Binding IconSource, Converter={StaticResource NullToCollapse}}" />
                                            <FontIcon
                                                FontSize="26"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Glyph="{Binding IconGlyph}"
                                                Visibility="{Binding IconGlyph, Converter={StaticResource NullToCollapse}}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock

                                        HorizontalAlignment="Center"
                                        FontSize="13"
                                        MaxLines="2"
                                        Text="{Binding Name}"
                                        TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap"
                                        Width="84" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                    <GridView.FooterTemplate>
                        <DataTemplate>
                            <TextBlock
                                Margin="0,16,0,12"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                l:Uids.Uid="HomePage_DropHintFooter"
                                Text="拖入 zip/exe/ps1/bat 可添加自己的工具，右键可以对工具执行更多操作" />
                        </DataTemplate>
                    </GridView.FooterTemplate>
                </GridView>

            <!-- 编辑排序模式：专用纵向列表，整行自实现拖拽（与收藏页同模式） -->
            <ScrollViewer
                x:Name="EditModeScroll"
                Visibility="Collapsed">
                <StackPanel Spacing="12" Margin="0,4,0,0">
                    <Border
                        Padding="12,10"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontSize="14"
                                Glyph="&#xE700;"
                                VerticalAlignment="Center"
                                Opacity="1.0" />
                            <TextBlock
                                Opacity="1.0"
                                Text="按住任意行上下拖动即可调整顺序，完成后点击右上角“完成”。"
                                l:Uids.Uid="HomePage_EditModeHint"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <StackPanel
                        x:Name="EditRowsPanel"
                        Spacing="8"
                        MaxWidth="720"
                        HorizontalAlignment="Center" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel
                x:Name="EmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="Collapsed">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="48"
                    Glyph="&#xE721;"
                    Opacity="1.0" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="18"
                    Opacity="1.0"
                    l:Uids.Uid="HomePage_EmptyStateTitle"
                    Text="没有找到匹配的工具" />
                <TextBlock
                    x:Name="EmptyStateText"
                    HorizontalAlignment="Center"
                    Opacity="1.0"
                    Text="" />
                <Button
                    x:Name="DownloadToolsButton"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed"
                    Click="DownloadToolsButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE896;" FontSize="14" />
                        <TextBlock Text="下载工具包" l:Uids.Uid="HomePage_DownloadToolsButton" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <TeachingTip
                x:Name="ToolDetailTip"
                CloseButtonContent="关闭"
                l:Uids.Uid="HomePage_ToolDetailTip"
                PreferredPlacement="Right">
                <StackPanel MaxWidth="420" Spacing="8">
                    <TextBlock x:Name="DetailDescriptionText" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailPublisherText" Opacity="1.0" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailVersionText" Opacity="1.0" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailPathText" Opacity="1.0" TextWrapping="Wrap" />
                </StackPanel>
            </TeachingTip>

            <InfoBar
