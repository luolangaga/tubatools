<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TubaWinUi3.Pages.PortViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="using:WinUI3Localizer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:TubaWinUi3.Controls"
    mc:Ignorable="d">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:ToolPageHeader
            Grid.Row="0"
            Title="端口占用"
            Subtitle="通过 iphlpapi 扫描系统 TCP/UDP 连接，定位端口占用进程"
            Glyph="&#xE774;"
            l:Uids.Uid="PortViewer_PageHeader" />

        <!-- Main content -->
        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto" Padding="24,8,24,24">
            <StackPanel Spacing="16">
                <InfoBar x:Name="ErrorBar" IsClosable="True" IsOpen="False" Severity="Error" />

                <!-- Action bar -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox x:Name="SearchBox" PlaceholderText="搜索端口、进程名、PID、tcp6、地址..." l:Uids.Uid="PortViewer_SearchPlaceholder" MinWidth="240" QueryIcon="Find" TextChanged="SearchBox_TextChanged" QuerySubmitted="SearchBox_QuerySubmitted" />
                    <ComboBox x:Name="ProtoCombo" Grid.Column="1" MinWidth="100" SelectedIndex="0" SelectionChanged="ProtoCombo_SelectionChanged">
                        <ComboBoxItem Content="全部" l:Uids.Uid="PortViewer_FilterAll" Tag="全部" />
                        <ComboBoxItem Content="TCP" Tag="TCP" />
                        <ComboBoxItem Content="UDP" Tag="UDP" />
                        <ComboBoxItem Content="TCP6" Tag="TCP6" />
                        <ComboBoxItem Content="UDP6" Tag="UDP6" />
                    </ComboBox>
                    <Button x:Name="RefreshBtn" Grid.Column="2" Click="RefreshBtn_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                            <TextBlock Text="刷新" l:Uids.Uid="PortViewer_Refresh" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="CountText" Grid.Column="3" FontSize="12" VerticalAlignment="Center" />
                </Grid>

                <!-- Column headers -->
                <Border x:Name="HeaderBorder" Padding="12,6,12,6" CornerRadius="8,8,0,0">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontSize="12" FontWeight="SemiBold" Text="协议" l:Uids.Uid="PortViewer_ColProtocol" />
                        <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Text="端口" l:Uids.Uid="PortViewer_ColPort" />
                        <TextBlock Grid.Column="2" FontSize="12" FontWeight="SemiBold" Text="本地地址" l:Uids.Uid="PortViewer_ColLocalAddress" />
                        <TextBlock Grid.Column="3" FontSize="12" FontWeight="SemiBold" Text="状态" l:Uids.Uid="PortViewer_ColState" />
                        <TextBlock Grid.Column="4" FontSize="12" FontWeight="SemiBold" Text="进程" l:Uids.Uid="PortViewer_ColProcess" />
                        <TextBlock Grid.Column="5" FontSize="12" FontWeight="SemiBold" Text="PID" />
                        <TextBlock Grid.Column="6" FontSize="12" FontWeight="SemiBold" Text="操作" l:Uids.Uid="PortViewer_ColAction" />
                    </Grid>
                </Border>

                <!-- List -->
                <Border x:Name="ListBorder" BorderThickness="1" CornerRadius="0,0,8,8">
                    <StackPanel x:Name="ListContainer" />
                </Border>

                <!-- Loading -->
                <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" Spacing="8" Padding="0,40,0,40" Visibility="Collapsed">
                    <ProgressRing x:Name="LoadingRing" Width="36" Height="36" IsActive="True" />
                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="正在扫描端口..." l:Uids.Uid="PortViewer_Scanning" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
    </Page>

