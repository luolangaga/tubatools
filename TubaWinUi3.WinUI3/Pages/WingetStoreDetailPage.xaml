<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TubaWinUi3.Pages.WingetStoreDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="16" FromHorizontalOffset="0" IsStaggeringEnabled="False" />
            </TransitionCollection>
        </Grid.Transitions>

        <ScrollViewer Padding="24,8,24,24">
            <StackPanel
                MaxWidth="860"
                HorizontalAlignment="Center"
                Spacing="16">

                <!-- 返回 -->
                <Button
                    HorizontalAlignment="Left"
                    Padding="12,8,12,8"
                    Click="BackButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            FontSize="14"
                            Glyph="&#xE72B;"
                            VerticalAlignment="Center" />
                        <TextBlock
                            FontSize="14"
                            Text="返回商店"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- 头部：名称 + 元信息 + 获取按钮 -->
                <StackPanel Spacing="8">
                    <TextBlock
                        x:Name="NameText"
                        Style="{StaticResource PageTitleStyle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="MetaText"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button
                        x:Name="InstallButton"
                        Height="40"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Left"
                        Padding="24,0,24,0"
                        CornerRadius="8"
                        Click="InstallButton_Click"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>

                <!-- 简介 -->
                <StackPanel Spacing="12">
                    <TextBlock
                        Style="{StaticResource SectionHeaderStyle}"
                        Text="简介" />
                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <TextBlock
                            x:Name="DescText"
                            FontSize="14"
                            LineHeight="24"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <!-- 包信息 -->
                <StackPanel Spacing="12">
                    <TextBlock
                        Style="{StaticResource SectionHeaderStyle}"
                        Text="包信息" />
                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="0">
                            <!-- 包 ID -->
                            <Grid Padding="0,12" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="包 ID" />
                                <TextBlock
                                    x:Name="IdText"
                                    Grid.Column="1"
                                    FontSize="14"
                                    TextWrapping="Wrap" />
                            </Grid>
                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <!-- 分类 -->
                            <Grid Padding="0,12" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="分类" />
                                <TextBlock
                                    x:Name="CategoryText"
                                    Grid.Column="1"
                                    FontSize="14" />
                            </Grid>
                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <!-- 来源 -->
                            <Grid Padding="0,12" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="来源" />
                                <TextBlock
                                    x:Name="SourceText"
                                    Grid.Column="1"
                                    FontSize="14"
                                    Text="WinGet 官方源 · 正版直链下载" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>