<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="TubaWinUi3.Pages.GameTunnelJoinDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="我要加入"
    PrimaryButtonText="下一步"
    SecondaryButtonText="上一步"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    SecondaryButtonClick="OnSecondaryButtonClick">

    <ContentDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <CornerRadius x:Key="DialogCornerRadius">12</CornerRadius>
        </ResourceDictionary>
    </ContentDialog.Resources>

    <ScrollViewer
        MaxHeight="450"
        MinWidth="540"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">

        <StackPanel Spacing="12">

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="StepText" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="第 1 步 / 共 2 步" />
                <TextBlock x:Name="StepNameText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="· 粘贴房间码" />
            </StackPanel>

            <!-- ══════════ 第 1 步：邀请码 / 房间码 ══════════ -->
            <StackPanel x:Name="Step1Panel" Spacing="8">
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Text="把对方发来的邀请码整段粘进来就行（连说明文字一起粘也可以）；只有房间码 U/XXXX-… 也能加入。" />

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="InviteBox"
                        PlaceholderText="TBG2:… 或 U/XXXX-XXXX-XXXX-XXXX"
                        TextChanged="InviteBox_TextChanged"
                        FontFamily="Consolas"
                        FontSize="12" />
                    <Button x:Name="PasteButton" Grid.Column="1" Click="Paste_Click" Padding="12,8" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="12" Glyph="&#xE77F;" />
                            <TextBlock FontSize="14" Text="粘贴" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border
                    x:Name="PreviewCard"
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="PreviewTitle" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock x:Name="PreviewAddress" Style="{StaticResource CardTitleStyle}" FontFamily="Consolas" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="PreviewNote" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ══════════ 第 2 步：连接 ══════════ -->
            <StackPanel x:Name="Step2Panel" Spacing="12" Visibility="Collapsed">

                <Border Style="{StaticResource FluentCardStyle}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="JoinIcon" FontSize="14" Glyph="&#xE9F5;" VerticalAlignment="Center" />
                            <TextBlock x:Name="JoinText" Grid.Column="1" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" Text="等待开始" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="AddressIcon" FontSize="14" Glyph="&#xE9F5;" VerticalAlignment="Center" />
                            <TextBlock x:Name="AddressText" Grid.Column="1" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" Text="加入虚拟网络" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="PingIcon" FontSize="14" Glyph="&#xE9F5;" VerticalAlignment="Center" />
                            <TextBlock x:Name="PingText" Grid.Column="1" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" Text="找到房主并建立端口转发" />
                        </Grid>
                    </StackPanel>
                </Border>

                <ProgressBar x:Name="JoinProgress" Visibility="Collapsed" />
            </StackPanel>

            <!-- ══════════ 第 3 步：就绪 ══════════ -->
            <StackPanel x:Name="Step3Panel" Spacing="12" Visibility="Collapsed">

                <Border
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE73E;" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="连上了，现在打开游戏" />
                        </StackPanel>
                        <TextBlock x:Name="FinalHintText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="在游戏里连接这个地址：" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                x:Name="FinalAddressText"
                                VerticalAlignment="Center"
                                FontFamily="Consolas"
                                Style="{StaticResource StatValueStyle}"
                                IsTextSelectionEnabled="True"
                                Text="--" />
                            <Button x:Name="CopyFinalAddressButton" Click="CopyFinalAddress_Click" CornerRadius="8" Padding="12,8" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                                    <TextBlock FontSize="14" Text="复制" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="FinalNoteText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Expander Header="在游戏里怎么进？" HorizontalAlignment="Stretch" IsExpanded="True">
                    <ItemsControl x:Name="GuestStepsList" Padding="0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Top" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="•" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <Expander Header="连不上？" HorizontalAlignment="Stretch">
                    <StackPanel Padding="0,8" Spacing="8">
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Text="· 提示「未知主机 / 服务器无响应」：先回游戏主菜单重进一次，或者让对方确认游戏还开着。" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Text="· 一直连不上：回主页点「网络检测」，看和房主是直连还是中转、有没有告警。" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Text="· 玩完想断开：回主页点「停止联机」；本机不会留下虚拟网卡或后台服务。" />
                    </StackPanel>
                </Expander>
            </StackPanel>

            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" Severity="Informational" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
