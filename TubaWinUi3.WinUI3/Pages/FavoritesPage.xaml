<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TubaWinUi3.Pages.FavoritesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="using:WinUI3Localizer"
    xmlns:local="using:TubaWinUi3.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Page.Resources>
        <local:NullToVisibilityConverter x:Key="NullToCollapse" />
        <local:HasAlternatesToVisibilityConverter x:Key="HasAlternatesToVis" />
        <local:NoAlternatesToVisibilityConverter x:Key="NoAlternatesToVis" />

        <MenuFlyout x:Key="FavItemFlyout">
            <MenuFlyoutItem x:Name="FavMenuToggleFavorite" Text="取消收藏" Click="FavMenu_ToggleFavorite">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE735;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="FavMenuSendToDesktop" Text="发送到桌面快捷方式" Click="FavMenu_SendToDesktop" l:Uids.Uid="Common_SendToDesktop">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8AD;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="FavMenuRunAsAdmin" Text="以管理员身份运行" Click="FavMenu_RunAsAdmin" Icon="Admin" l:Uids.Uid="Common_RunAsAdmin" />
            <MenuFlyoutItem x:Name="FavMenuOpenDirectory" Text="打开工具所在目录" Click="FavMenu_OpenDirectory" Icon="Folder" l:Uids.Uid="Common_OpenLocation" />
            <MenuFlyoutItem x:Name="FavMenuOpenTutorial" Text="打开教程" Click="FavMenu_OpenTutorial" Visibility="Collapsed" l:Uids.Uid="Common_OpenTutorial">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8A1;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSubItem x:Name="FavArchSubmenu" Text="选择架构" Visibility="Collapsed" l:Uids.Uid="Common_SelectArch">
                <MenuFlyoutSubItem.Icon>
                    <FontIcon Glyph="&#xE912;" />
                </MenuFlyoutSubItem.Icon>
            </MenuFlyoutSubItem>
        </MenuFlyout>
    </Page.Resources>

    <!--
        单滚动面结构：页头 / 常用推荐 / 收藏统计条各自占一行（Auto），工具卡 GridView 独占 * 行并由自身滚动。
        页面级 ScrollViewer 会给 GridView 无限高度、令虚拟化失效（WinUI 反模式）；
        这里让 GridView 拿到确定高度，虚拟化恢复，同时编辑排序面板与空状态在 * 行内与网格互斥显示。
    -->
    <Grid Padding="24,16,24,24" RowSpacing="16">
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="16" FromHorizontalOffset="0" IsStaggeringEnabled="False" />
            </TransitionCollection>
        </Grid.Transitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock
                Style="{StaticResource PageTitleStyle}"
                Text="常用"
                l:Uids.Uid="Favorites_Title" />
            <TextBlock
                x:Name="SubtitleText"
                Style="{StaticResource PageSubtitleStyle}"
                Text="你收藏的工具会显示在这里,可拖拽调整顺序。"
                l:Uids.Uid="Favorites_Subtitle" />
        </StackPanel>

        <StackPanel
            x:Name="FrequentSection"
            Grid.Row="1"
            Spacing="8"
            Visibility="Collapsed">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border
                        Width="28"
                        Height="28"
                        VerticalAlignment="Center"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="8">
                        <FontIcon
                            FontSize="14"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Glyph="&#xE734;"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <TextBlock
                        Style="{StaticResource CardTitleStyle}"
                        VerticalAlignment="Center"
                        Text="常用推荐"
                        l:Uids.Uid="Favorites_FrequentTitle" />
                    <TextBlock
                        x:Name="FrequentSubtitle"
                        Style="{StaticResource CaptionTextStyle}"
                        VerticalAlignment="Center"
                        Text="基于使用频率智能排序"
                        l:Uids.Uid="Favorites_FrequentSubtitle" />
                </StackPanel>
                <Button
                    x:Name="HideFrequentButton"
                    Grid.Column="1"
                    Width="28"
                    Height="28"
                    Padding="0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="HideFrequentButton_Click"
                    ToolTipService.ToolTip="不再显示常用推荐"
                    l:Uids.Uid="Favorites_HideFrequentButton">
                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                </Button>
            </Grid>
            <ScrollViewer
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Enabled"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled">
                <StackPanel x:Name="FrequentPanel" Orientation="Horizontal" Spacing="8" />
            </ScrollViewer>
        </StackPanel>

        <Border
            Grid.Row="2"
            Style="{StaticResource FluentCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Style="{StaticResource IconTileStyle}"
                    Width="44"
                    Height="44"
                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon
                        FontSize="20"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Glyph="&#xE735;" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock
                        Style="{StaticResource CardTitleStyle}"
                        Text="我的收藏"
                        l:Uids.Uid="Favorites_MyFavorites" />
                    <TextBlock x:Name="ToolCountText" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="EditOrderButton"
                        Style="{StaticResource ToolHeaderActionButtonStyle}"
                        Click="EditOrderButton_Click"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="EditOrderIcon" FontSize="12" Glyph="&#xE70F;" />
                            <TextBlock x:Name="EditOrderButtonText" Text="编辑排序" l:Uids.Uid="Favorites_EditOrderButtonText" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="ClearAllButton"
                        Style="{StaticResource ToolHeaderActionButtonStyle}"
                        Click="ClearAllButton_Click"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE74D;" />
                            <TextBlock Text="清空全部" l:Uids.Uid="Favorites_ClearAll" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <GridView
                x:Name="ToolsGrid"
                IsItemClickEnabled="True"
                ItemClick="ToolsGrid_ItemClick"
                ItemContainerStyle="{StaticResource ToolCardItemStyle}"
                SelectionMode="None"
                SizeChanged="ToolsGrid_SizeChanged">
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="16"
                            MinHeight="220"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            RightTapped="FavItem_RightTapped">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="52" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTileStyle}" Width="56" Height="56">
                                        <Grid>
                                            <Image
                                                Width="40"
                                                Height="40"
                                                Source="{Binding IconPath}"
                                                Stretch="Uniform"
                                                Visibility="{Binding IconPath, Converter={StaticResource NullToCollapse}}" />
                                            <Image
                                                Width="40"
                                                Height="40"
                                                Source="{Binding IconSource}"
                                                Stretch="Uniform"
                                                Visibility="{Binding IconSource, Converter={StaticResource NullToCollapse}}" />
                                            <FontIcon
                                                FontSize="28"
                                                Glyph="{Binding IconGlyph}"
                                                Visibility="{Binding IconGlyph, Converter={StaticResource NullToCollapse}}" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock
                                            Style="{StaticResource CardTitleStyle}"
                                            MaxLines="1"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="12"
                                            Text="{Binding CategoryDisplay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock
                                    Grid.Row="1"
                                    MaxLines="2"
                                    Text="{Binding Description}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />

                                <Grid Grid.Row="2" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource StatusPillStyle}">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Text="{Binding Extension}" />
                                    </Border>

                                </Grid>

                                <Grid Grid.Row="3" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Style="{StaticResource ToolCardActionButtonStyle}"
                                        Click="SendToDesktopButton_Click"
                                        ToolTipService.ToolTip="发送到桌面快捷方式"
                                        l:Uids.Uid="Favorites_SendToDesktopButton">
                                        <FontIcon FontSize="12" Glyph="&#xE8AD;" />
                                    </Button>
                                    <Button
                                        Grid.Column="1"
                                        Style="{StaticResource ToolCardActionButtonStyle}"
                                        Click="RunAsAdminButton_Click"
                                        ToolTipService.ToolTip="以管理员身份运行"
                                        l:Uids.Uid="Favorites_RunAsAdminButton">
                                        <FontIcon FontSize="12" Glyph="&#xE7EF;" />
                                    </Button>
                                    <Button
                                        Grid.Column="2"
                                        MinWidth="88"
                                        Padding="8,4"
                                        Style="{StaticResource ToolCardActionButtonStyle}"
                                        Click="LaunchButton_Click">
                                        <TextBlock
                                            Text="{Binding LaunchButtonText}"
                                            TextAlignment="Center"
                                            TextTrimming="CharacterEllipsis" />
                                    </Button>
                                    <Button
                                        Grid.Column="3"
                                        Style="{StaticResource ToolCardActionButtonStyle}"
                                        Click="RemoveFavoriteButton_Click"
                                        ToolTipService.ToolTip="取消收藏"
                                        l:Uids.Uid="Favorites_RemoveFavoriteButton">
                                        <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <!-- 编辑排序模式:专用纵向列表,整行自实现拖拽,不依赖 GridView 原生拖拽 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Visibility, ElementName=EditModePanel}">
                <StackPanel
                    x:Name="EditModePanel"
                    Spacing="12"
                    Visibility="Collapsed">
                    <Border
                        Padding="12,8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontSize="14"
                                Glyph="&#xE700;"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Text="按住任意卡片上下拖动即可调整顺序，完成后点击右上角“完成”。"
                                l:Uids.Uid="Favorites_EditModeHint"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="EditRowsPanel" Spacing="8" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel
                x:Name="EmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="Collapsed">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="28"
                    Glyph="&#xE735;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="18"
                    Text="还没有收藏的工具"
                    l:Uids.Uid="Favorites_EmptyTitle" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Text="在全部页面点击星标按钮即可收藏"
                    l:Uids.Uid="Favorites_EmptyHint" />
            </StackPanel>

            <TeachingTip
                x:Name="ToolDetailTip"
                CloseButtonContent="关闭"
                l:Uids.Uid="Favorites_ToolDetailTip"
                PreferredPlacement="Right">
                <StackPanel MaxWidth="420" Spacing="8">
                    <TextBlock x:Name="DetailDescriptionText" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailPublisherText" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailVersionText" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailPathText" TextWrapping="Wrap" />
                </StackPanel>
            </TeachingTip>

            <InfoBar
                x:Name="StatusBar"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                IsClosable="True"
                IsOpen="False" />
        </Grid>
    </Grid>
</Page>
