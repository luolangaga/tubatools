<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TubaWinUi3.Pages.AiAgentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="OnPageLoaded">

    <UserControl.Resources>
        <Flyout x:Key="SkillsFlyout">
            <StackPanel x:Name="SkillsPanel" Width="320" Spacing="4" Padding="4" />
        </Flyout>
    </UserControl.Resources>

    <Grid x:Name="RootLayout" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="HeaderBar" Padding="16,12"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="42" Height="42" VerticalAlignment="Center">
                    <Border CornerRadius="12" Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xE946;" FontSize="20"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <InfoBadge x:Name="StateBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Background="{ThemeResource SystemFillColorSuccessBrush}">
                        <InfoBadge.IconSource>
                            <FontIconSource Glyph="&#xE73E;" />
                        </InfoBadge.IconSource>
                    </InfoBadge>
                </Grid>

                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="TitleText" Text="新对话" Style="{StaticResource CardTitleStyle}"
                                   TextTrimming="CharacterEllipsis" />
                        <Border Style="{StaticResource StatusPillStyle}"
                                Background="{ThemeResource ControlFillColorDefaultBrush}">
                            <TextBlock Text="本机智能代理" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="ModelStatusText" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="·" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="RunStateText" Text="就绪" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="·" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="HeaderTokenText" Text="0 tokens" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="HeaderActions" Grid.Column="2" Orientation="Horizontal"
                            Spacing="8" VerticalAlignment="Center">
                    <ComboBox x:Name="ProviderCombo" MinWidth="118" MaxWidth="160" FontSize="12"
                              DisplayMemberPath="Name" SelectionChanged="ProviderCombo_SelectionChanged"
                              ToolTipService.ToolTip="AI 服务提供商" />
                    <ComboBox x:Name="ModelCombo" MinWidth="140" MaxWidth="190" FontSize="12"
                              DisplayMemberPath="DisplayText" SelectionChanged="ModelCombo_SelectionChanged"
                              ToolTipService.ToolTip="当前模型，下一条消息生效" />
                    <Button x:Name="ManageProvidersButton" Width="36" Height="36" Padding="0"
                            Click="ManageProvidersButton_Click" ToolTipService.ToolTip="管理 AI 提供商">
                        <FontIcon Glyph="&#xE774;" FontSize="14" />
                    </Button>
                    <ToggleSwitch x:Name="FullAccessToggle" MinWidth="0" Padding="0"
                                  OnContent="完全访问" OffContent="受控执行" FontSize="12"
                                  ToolTipService.ToolTip="危险操作在受控执行模式下需要逐项确认"
                                  Toggled="FullAccessToggle_Toggled" />
                    <Button x:Name="SkillsButton" Width="36" Height="36" Padding="0"
                            Click="SkillsButton_Click" ToolTipService.ToolTip="技能">
                        <FontIcon Glyph="&#xE7C0;" FontSize="14" />
                    </Button>
                    <Button x:Name="NewChatButton" Width="36" Height="36" Padding="0"
                            Click="NewChatButton_Click" ToolTipService.ToolTip="新对话">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                    </Button>
                    <Button x:Name="HistoryButton" Width="36" Height="36" Padding="0"
                            Click="HistoryButton_Click" ToolTipService.ToolTip="历史对话">
                        <FontIcon Glyph="&#xE81C;" FontSize="14" />
                    </Button>
                    <Button x:Name="AiSettingsButton" Width="36" Height="36" Padding="0"
                            Click="AiSettingsButton_Click" ToolTipService.ToolTip="AI 服务设置">
                        <FontIcon Glyph="&#xE713;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="MsgScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Disabled" ViewChanged="MsgScroll_ViewChanged">
                <StackPanel x:Name="MsgPanel" MaxWidth="960" HorizontalAlignment="Center"
                            Padding="24,8,24,24" />
            </ScrollViewer>
            <Button x:Name="ScrollToBottomButton" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,12" Padding="12,8" CornerRadius="12" Visibility="Collapsed"
                    Click="ScrollToBottomButton_Click" ToolTipService.ToolTip="回到最新消息">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74B;" FontSize="12" />
                    <TextBlock Text="回到最新" FontSize="12" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="2" Padding="16,8,16,16"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <StackPanel MaxWidth="960" HorizontalAlignment="Center" Spacing="8">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Enabled"
                              VerticalScrollMode="Disabled">
                    <StackPanel x:Name="QuickPillPanel" Orientation="Horizontal" Spacing="8" />
                </ScrollViewer>
                <Border CornerRadius="12" Padding="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InputBox" MinHeight="44" MaxHeight="140"
                                 PlaceholderText="描述目标，或直接要求助手诊断、执行操作…（Enter 发送，Shift+Enter 换行）"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 BorderThickness="0" Background="Transparent"
                                 Padding="8" KeyDown="InputBox_KeyDown"
                                 AutomationProperties.Name="向 AI 助手发送消息" />
                        <Border x:Name="TokenUsageBubble" Grid.Column="1" CornerRadius="12"
                                Padding="8" Background="{ThemeResource ControlFillColorDefaultBrush}"
                                VerticalAlignment="Center" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE823;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock x:Name="TokenUsageText" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="SendButton" Grid.Column="2" Width="42" Height="42" Padding="0"
                                CornerRadius="8" Click="SendButton_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                AutomationProperties.Name="发送消息">
                            <FontIcon Glyph="&#xE72A;" FontSize="14" />
                        </Button>
                        <Button x:Name="StopButton" Grid.Column="2" Width="42" Height="42" Padding="0"
                                CornerRadius="8" Visibility="Collapsed" Click="StopButton_Click"
                                AutomationProperties.Name="停止生成">
                            <FontIcon Glyph="&#xE71A;" FontSize="14" />
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1000" /></VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="CompactState">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ProviderCombo.Visibility" Value="Collapsed" />
                        <Setter Target="ModelCombo.Visibility" Value="Collapsed" />
                        <Setter Target="FullAccessToggle.Visibility" Value="Collapsed" />
                        <Setter Target="HeaderBar.Padding" Value="12,8" />
                        <Setter Target="MsgPanel.Padding" Value="12,8,12,16" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
