<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="TubaWinUi3.Pages.PhoneLinkChatDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TubaWinUi3.Pages"
    Title="聊天与文件"
    CloseButtonText="关闭">

    <Grid Width="580" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <InfoBar x:Name="StatusBar" Grid.Row="0" IsOpen="False" IsClosable="True"/>

        <Grid Grid.Row="1" Height="400">
            <ListView x:Name="MessageList" SelectionMode="None"
                      Background="Transparent" BorderThickness="0" Padding="4">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="2"/>
                        <Setter Property="MinHeight" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:PhoneChatBubbleVm">
                        <Grid HorizontalAlignment="{x:Bind Align}" MaxWidth="420" Margin="0,2">
                            <Border Background="{x:Bind BubbleBrush}" CornerRadius="8" Padding="12,8">
                                <StackPanel Spacing="8">
                                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Visibility="{x:Bind ThumbnailVisibility, Mode=OneWay}"
                                           MaxHeight="200" Stretch="Uniform" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" Visibility="{x:Bind TextVisibility}"
                                               IsTextSelectionEnabled="True"/>
                                    <StackPanel Visibility="{x:Bind FileVisibility}" Spacing="2">
                                        <TextBlock Text="{x:Bind FileName}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind FileMeta}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                        <Button Content="另存为" Tag="{x:Bind MessageId}" Click="SaveAs_Click"
                                                Padding="8,2" Margin="0,4,0,0" Visibility="{x:Bind SaveVisibility}"/>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind TimeText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                       MaxWidth="320" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14"
                       Text="还没有消息。手机连接后，这里可以互发文字、图片和文件。"/>
        </Grid>

        <TextBlock x:Name="TransferText" Grid.Row="2" TextWrapping="Wrap" FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Visibility="Collapsed" Text=""/>

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" Grid.Column="0" PlaceholderText="发送给手机的文字…" MaxLength="4000"
                     KeyDown="InputBox_KeyDown"/>
            <Button x:Name="SendButton" Grid.Column="1" Content="发送" Click="Send_Click"/>
            <Button x:Name="SendFileButton" Grid.Column="2" Content="发送文件…" Click="SendFile_Click"/>
        </Grid>
    </Grid>
</ContentDialog>
