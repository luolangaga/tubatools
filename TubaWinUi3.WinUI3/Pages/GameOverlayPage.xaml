<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TubaWinUi3.Pages.GameOverlayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Admin Required Overlay -->
        <Grid x:Name="AdminOverlay" Visibility="Collapsed"
              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
              Canvas.ZIndex="9999">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                <FontIcon Glyph="&#xE72E;" FontSize="64"
                          Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="请在管理员模式下运行"
                           FontSize="28" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="游戏监控的 FPS 检测和硬件数据采集需要管理员权限才能正常工作。&#x0a;请右键以管理员身份运行本程序。"
                           FontSize="14" TextAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="480"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="BtnRestartAsAdmin" Click="RestartAsAdmin_Click"
                        Style="{ThemeResource AccentButtonStyle}" Padding="20,10"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7EF;" FontSize="16" />
                        <TextBlock Text="以管理员身份重新启动" FontSize="14" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid x:Name="MainContent" Padding="24,16,24,16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="8">
                    <FontIcon FontSize="20" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Glyph="&#xE9F5;" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock FontSize="22" FontWeight="Bold" Text="游戏监控" />
                    <TextBlock Opacity="0.8" FontSize="12" Text="拖拽组件设计覆盖层布局，叠加到游戏窗口实时显示硬件参数" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Click="ScanWindows_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                            <TextBlock Text="扫描窗口" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ToggleOverlayBtn" Click="ToggleOverlay_Click" Style="{ThemeResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="ToggleOverlayIcon" Glyph="&#xE768;" FontSize="12" />
                            <TextBlock x:Name="ToggleOverlayText" Text="启动覆盖层" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Body: Palette | Canvas | Properties -->
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="250" />
                </Grid.ColumnDefinitions>

                <!-- Left: Presets + Component Palette -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Presets -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="10" Margin="0,0,0,8">
                        <StackPanel Spacing="8">
                            <TextBlock Text="布局预设" FontWeight="SemiBold" FontSize="13" />
                            <ComboBox x:Name="CmbPreset" FontSize="12" HorizontalAlignment="Stretch"
                                      SelectionChanged="Preset_SelectionChanged" />
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Click="ApplyPreset_Click" Padding="4,5" FontSize="12"
                                        HorizontalAlignment="Stretch"
                                        ToolTipService.ToolTip="用所选预设替换当前画布布局">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE768;" FontSize="11" />
                                        <TextBlock Text="应用" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Click="SavePreset_Click" Padding="4,5" FontSize="12"
                                        HorizontalAlignment="Stretch"
                                        ToolTipService.ToolTip="将当前画布布局保存为自定义预设">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE74E;" FontSize="11" />
                                        <TextBlock Text="保存" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnDeletePreset" Grid.Column="2" Click="DeletePreset_Click"
                                        Padding="4,5" FontSize="12" IsEnabled="False"
                                        HorizontalAlignment="Stretch"
                                        ToolTipService.ToolTip="删除所选自定义预设">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE74D;" FontSize="11" />
                                        <TextBlock Text="删除" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Component Palette -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="组件列表" FontWeight="SemiBold" FontSize="13" Margin="6,4,6,8" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="PalettePanel" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Center: Canvas Designer -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- Settings Bar (窄窗口时允许左右滚动) -->
                    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Enabled" ZoomMode="Disabled"
                                  Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="画布:" VerticalAlignment="Center" FontSize="12" />
                        <NumberBox x:Name="NbCanvasW" Minimum="200" Maximum="2000"
                                   SpinButtonPlacementMode="Compact" Width="85" FontSize="12"
                                   ValueChanged="CanvasSize_Changed" />
                        <TextBlock Text="×" VerticalAlignment="Center" />
                        <NumberBox x:Name="NbCanvasH" Minimum="100" Maximum="1500"
                                   SpinButtonPlacementMode="Compact" Width="85" FontSize="12"
                                   ValueChanged="CanvasSize_Changed" />
                        <ComboBox x:Name="CmbPosition" SelectedIndex="0" Width="110" FontSize="12"
                                  SelectionChanged="Position_Changed">
                            <ComboBoxItem>左上</ComboBoxItem>
                            <ComboBoxItem>中上</ComboBoxItem>
                            <ComboBoxItem>右上</ComboBoxItem>
                            <ComboBoxItem>左中</ComboBoxItem>
                            <ComboBoxItem>居中</ComboBoxItem>
                            <ComboBoxItem>右中</ComboBoxItem>
                            <ComboBoxItem>左下</ComboBoxItem>
                            <ComboBoxItem>中下</ComboBoxItem>
                            <ComboBoxItem>右下</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Text="刷新:" VerticalAlignment="Center" FontSize="12" />
                        <NumberBox x:Name="NbRefresh" Minimum="200" Maximum="5000"
                                   SpinButtonPlacementMode="Compact" Width="85" FontSize="12"
                                   ValueChanged="RefreshInterval_Changed" />
                        <TextBlock Text="ms" VerticalAlignment="Center" FontSize="12" />
                        <TextBlock Text="缩放:" VerticalAlignment="Center" FontSize="12" />
                        <NumberBox x:Name="NbScale" Minimum="50" Maximum="200" SmallChange="5"
                                   SpinButtonPlacementMode="Compact" Width="85" FontSize="12"
                                   ValueChanged="Scale_Changed"
                                   ToolTipService.ToolTip="整体缩放画布与全部组件（50%–200%）" />
                        <TextBlock Text="%" VerticalAlignment="Center" FontSize="12" />
                        <TextBlock Text="字体:" VerticalAlignment="Center" FontSize="12" />
                        <ComboBox x:Name="CmbFont" Width="140" FontSize="12"
                                  SelectionChanged="Font_Changed" />
                    </StackPanel>
                    </ScrollViewer>
                    <!-- Canvas -->
                    <Border Grid.Row="1" Padding="4" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled">
                            <Canvas x:Name="DesignCanvas" Width="600" Height="300"
                                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                    AllowDrop="True"
                                    DragOver="Canvas_DragOver"
                                    Drop="Canvas_Drop"
                                    PointerPressed="Canvas_PointerPressed">
                                <!-- Canvas border (visual) -->
                                <Rectangle x:Name="CanvasBorderRect" Stroke="{ThemeResource ControlStrokeColorDefaultBrush}"
                                           StrokeThickness="1.5" StrokeDashArray="4,3" IsHitTestVisible="False" />
                                <!-- Canvas size display -->
                                <TextBlock x:Name="TxtCanvasSize" Text="600 × 300"
                                           FontSize="11" Opacity="0.7"
                                           Margin="0,0,6,4" IsHitTestVisible="False" />
                                <!-- Canvas resize thumb (bottom-right corner of canvas) -->
                                <Thumb x:Name="CanvasResizeThumb" Width="16" Height="16"
                                       Background="{ThemeResource AccentFillColorDefaultBrush}"
                                       CornerRadius="2"
                                       DragDelta="CanvasResize_DragDelta"
                                       ToolTipService.ToolTip="拖拽调整画布大小" />
                            </Canvas>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Right: Properties + Windows -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <!-- Game Window -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="游戏窗口" FontWeight="SemiBold" FontSize="13" />
                                <ComboBox x:Name="CmbGameWindow" PlaceholderText="选择或自动检测"
                                          FontSize="12" SelectionChanged="GameWindow_Changed" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Click="AddCustomWindow_Click" Padding="8,4" FontSize="12">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE710;" FontSize="11" />
                                            <TextBlock Text="添加自定义" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnRemoveCustom" Click="RemoveCustomWindow_Click"
                                            Padding="8,4" FontSize="12" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE74D;" FontSize="11" />
                                            <TextBlock Text="移除" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock x:Name="TxtWindowStatus" Opacity="0.6" FontSize="11" Text="未扫描" />
                            </StackPanel>
                        </Border>

                        <!-- Data Recording -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="数据记录" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock FontSize="11" Opacity="0.65" TextWrapping="Wrap"
                                           Text="勾选要记录的指标；记录期间数据只缓存在内存，结束（或停止）后一次性写入 JSON / Markdown / CSV 文件，不会边采边写拖慢游戏。单次最长 2 小时，到点自动停止并保存。" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Click="RecordSelectAll_Click" Padding="8,3" FontSize="12" Content="全选" />
                                    <Button Click="RecordClearAll_Click" Padding="8,3" FontSize="12" Content="清空" />
                                    <TextBlock x:Name="TxtRecordMetricCount" FontSize="11" VerticalAlignment="Center"
                                               Opacity="0.7" Text="已选 0 项" />
                                </StackPanel>
                                <Grid x:Name="RecordMetricPanel" ColumnSpacing="4" />
                                <StackPanel Spacing="2">
                                    <TextBlock Text="导出格式（可多选）" FontSize="12" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <CheckBox x:Name="ChkOutJson" Content="JSON" FontSize="11" MinWidth="0"
                                                  IsChecked="True" Tag="json"
                                                  Checked="RecordOutput_Changed" Unchecked="RecordOutput_Changed"
                                                  ToolTipService.ToolTip="原始数据，适合脚本 / 程序分析" />
                                        <CheckBox x:Name="ChkOutMarkdown" Content="Markdown" FontSize="11" MinWidth="0"
                                                  IsChecked="True" Tag="markdown"
                                                  Checked="RecordOutput_Changed" Unchecked="RecordOutput_Changed"
                                                  ToolTipService.ToolTip="可读报告，含统计摘要与采样明细" />
                                        <CheckBox x:Name="ChkOutCsv" Content="CSV" FontSize="11" MinWidth="0"
                                                  Tag="csv"
                                                  Checked="RecordOutput_Changed" Unchecked="RecordOutput_Changed"
                                                  ToolTipService.ToolTip="表格数据，可直接用 Excel 作图" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="TxtRecordDir" FontSize="11" Opacity="0.65" TextWrapping="Wrap"
                                           Text="输出目录：--" />
                                <Button Click="PickRecordDir_Click" Padding="8,4" FontSize="12"
                                        HorizontalAlignment="Stretch"
                                        ToolTipService.ToolTip="选择记录文件的输出目录">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="11" />
                                        <TextBlock Text="选择输出目录" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnRecord" Click="ToggleRecord_Click" Padding="8,6"
                                        Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon x:Name="RecordIcon" Glyph="&#xE768;" FontSize="12" />
                                        <TextBlock x:Name="RecordText" Text="开始记录" />
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="TxtRecordStatus" FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                                           Text="未开始" />
                                <Button x:Name="BtnOpenRecordDir" Click="OpenRecordDir_Click" Padding="8,4"
                                        FontSize="12" HorizontalAlignment="Stretch" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE838;" FontSize="11" />
                                        <TextBlock Text="打开输出文件夹" />
                                    </StackPanel>
                                </Button>
                                <Button Click="ViewRecords_Click" Padding="8,4" FontSize="12"
                                        HorizontalAlignment="Stretch"
                                        ToolTipService.ToolTip="打开「记录查看」：解析 JSON / CSV，图表化回放历史数据">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE9F5;" FontSize="11" />
                                        <TextBlock Text="查看记录图表" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Background -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="背景" FontWeight="SemiBold" FontSize="13" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="透明度" VerticalAlignment="Center" FontSize="12" />
                                    <Slider x:Name="SliderBgOpacity" Minimum="0" Maximum="100"
                                            Width="110" ValueChanged="BgOpacity_Changed" />
                                    <TextBlock x:Name="TxtBgOpacity" VerticalAlignment="Center" FontSize="12"
                                               Width="36" Text="70%" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Component Props -->
                        <Border x:Name="CardProps" Style="{StaticResource CardBorder}" Visibility="Collapsed">
                            <StackPanel Spacing="8">
                                <TextBlock Text="组件属性" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock x:Name="TxtCompLabel" FontSize="12" Opacity="0.8" />
                                <StackPanel Spacing="4">
                                    <TextBlock Text="X" FontSize="11" Opacity="0.6" />
                                    <NumberBox x:Name="PropX" Minimum="0" SpinButtonPlacementMode="Compact"
                                               FontSize="12" ValueChanged="PropPos_Changed" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Y" FontSize="11" Opacity="0.6" />
                                    <NumberBox x:Name="PropY" Minimum="0" SpinButtonPlacementMode="Compact"
                                               FontSize="12" ValueChanged="PropPos_Changed" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="宽度" FontSize="11" Opacity="0.6" />
                                    <NumberBox x:Name="PropW" Minimum="30" Maximum="2000"
                                               SpinButtonPlacementMode="Compact" FontSize="12"
                                               ValueChanged="PropSize_Changed" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="高度" FontSize="11" Opacity="0.6" />
                                    <NumberBox x:Name="PropH" Minimum="16" Maximum="500"
                                               SpinButtonPlacementMode="Compact" FontSize="12"
                                               ValueChanged="PropSize_Changed" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="字号" FontSize="11" Opacity="0.6" />
                                    <NumberBox x:Name="PropFS" Minimum="8" Maximum="72"
                                               SpinButtonPlacementMode="Compact" FontSize="12"
                                               ValueChanged="PropFS_Changed" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="前缀" FontSize="11" Opacity="0.6" />
                                    <TextBox x:Name="PropPrefix" FontSize="12"
                                             TextChanged="PropPrefix_Changed" />
                                </StackPanel>
                                <ToggleSwitch x:Name="PropShowPrefix" Header="显示前缀" OnContent="开" OffContent="关"
                                              IsOn="True" Toggled="PropShowPrefix_Toggled" FontSize="12" />

                                <!-- Custom text content (only for 自定义文字 widget) -->
                                <StackPanel x:Name="CardCustomText" Spacing="4" Visibility="Collapsed">
                                    <TextBlock Text="文字内容" FontSize="11" Opacity="0.6" />
                                    <TextBox x:Name="PropCustomText" FontSize="12"
                                             TextChanged="PropCustomText_Changed" />
                                </StackPanel>

                                <!-- Custom image picker (only for 自定义图片 widget) -->
                                <StackPanel x:Name="CardCustomImage" Spacing="4" Visibility="Collapsed">
                                    <TextBlock Text="图片文件" FontSize="11" Opacity="0.6" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBox x:Name="PropImagePath" FontSize="12" Width="150"
                                                 IsReadOnly="True" PlaceholderText="未选择" />
                                        <Button x:Name="BtnPickImage" Click="PickImage_Click"
                                                Padding="8,4" FontSize="12">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE838;" FontSize="11" />
                                                <TextBlock Text="选择" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Color picker (only for 自定义色块 widget) -->
                                <StackPanel x:Name="CardCustomColor" Spacing="4" Visibility="Collapsed">
                                    <TextBlock Text="颜色" FontSize="11" Opacity="0.6" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border x:Name="ColorPreview" Width="28" Height="24" CornerRadius="4"
                                                Background="#FF00A0FF" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1" />
                                <Button x:Name="BtnPickColor" Click="PickColor_Click"
                                        Padding="8,4" FontSize="12">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE790;" FontSize="11" />
                                        <TextBlock Text="选择颜色" />
                                    </StackPanel>
                                </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Text color (for text widgets & 自定义文字) -->
                                <StackPanel x:Name="CardTextColor" Spacing="4" Visibility="Collapsed">
                                    <TextBlock Text="文字颜色" FontSize="11" Opacity="0.6" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border x:Name="TextColorPreview" Width="28" Height="24" CornerRadius="4"
                                                Background="#FFFFFFFF" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1" />
                                        <Button x:Name="BtnPickTextColor" Click="PickTextColor_Click"
                                                Padding="8,4" FontSize="12">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE790;" FontSize="11" />
                                                <TextBlock Text="选择颜色" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Layer (z-order) -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="图层 (大在上)" FontSize="11" Opacity="0.6" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button x:Name="BtnLayerDown" Click="LayerDown_Click"
                                                Padding="8,4" FontSize="12">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE74B;" FontSize="11" />
                                                <TextBlock Text="下移" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnLayerUp" Click="LayerUp_Click"
                                                Padding="8,4" FontSize="12">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE74A;" FontSize="11" />
                                                <TextBlock Text="上移" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock x:Name="TxtLayer" Text="图层 0" FontSize="12"
                                                   VerticalAlignment="Center" Opacity="0.8" />
                                    </StackPanel>
                                </StackPanel>

                                <Button Click="DeleteComp_Click" Padding="8,4" FontSize="12"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE74D;" FontSize="11" />
                                        <TextBlock Text="删除组件" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Status -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
                <TextBlock x:Name="TxtStatus" FontSize="12" Opacity="0.6" Text="就绪" />
                <TextBlock x:Name="TxtCompCount" FontSize="12" Opacity="0.6" Text="组件: 0" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
