<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TubaWinUi3.Pages.FormatConverterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:TubaWinUi3.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="QueueItemTemplate">
            <Grid ColumnSpacing="8" Padding="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="{Binding CategoryGlyph}" FontSize="16"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                          VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionHeaderStyle}"
                               TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding FullPath}" />
                    <TextBlock Text="{Binding StatusText}" FontSize="12"
                               Foreground="{Binding StatusBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap" MaxLines="3" Visibility="{Binding DetailVisibility}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SizeText}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center" />
                    <Button Click="RemoveItemBtn_Click" FontSize="12" Padding="8,4" VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:ToolPageHeader
            Grid.Row="0"
            Title="格式转换"
            Subtitle="图片 · 音视频 · 文档 · 表格 · 演示 · PDF · 文本 · 任意文件打包，拖入即用"
            Glyph="&#xE8B2;"
            ShowDivider="True" />

        <!-- Body -->
        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto" Padding="24,8,24,24">
            <StackPanel x:Name="MainPanel" Spacing="16">

                <InfoBar x:Name="ToastBar" IsClosable="True" IsOpen="False" />

                <!-- ══════ 拖入框 ══════ -->
                <Border x:Name="DropZone" MinHeight="150" Padding="16" CornerRadius="8"
                        BorderThickness="2" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8A5;" FontSize="28" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="把文件拖到这里（支持多选）" Style="{StaticResource CardTitleStyle}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="DropHintText" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" TextAlignment="Center"
                                   Text="图片 / 视频 / 音频 / Word / Excel / PPT / PDF / Markdown / TXT / HTML / JSON&#x0a;旧版 .doc / .ppt / .wps / .et / .dps 需要本机安装 Office 或 WPS；任意文件均可打包为 ZIP" />
                        <Button Click="BrowseBtn_Click" Style="{StaticResource AccentButtonStyle}" FontSize="12" Padding="12,8"
                                HorizontalAlignment="Center" Content="&#xE8E5; 浏览文件" />
                    </StackPanel>
                </Border>

                <!-- ══════ 文件队列 ══════ -->
                <Border x:Name="QueuePanel" Style="{StaticResource FluentCardStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8FD;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="QueueTitleText" Style="{StaticResource SectionHeaderStyle}" Text="文件队列" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button x:Name="ConvertBtn" Grid.Column="1" Click="ConvertBtn_Click"
                                    Style="{StaticResource AccentButtonStyle}" Content="转换为…" MinWidth="110" />
                            <Button Grid.Column="2" Click="BrowseBtn_Click" Content="添加文件" />
                            <Button Grid.Column="3" Click="ClearQueueBtn_Click" Content="清空" />
                        </Grid>
                        <ListView x:Name="QueueList" ItemTemplate="{StaticResource QueueItemTemplate}"
                                  SelectionMode="None" MaxHeight="340"
                                  Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" />
                    </StackPanel>
                </Border>

                <!-- ══════ 进度 ══════ -->
                <Border x:Name="ProgressPanel" Style="{StaticResource FluentCardStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <ProgressBar x:Name="TaskProgress" IsIndeterminate="True" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ProgressText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="准备中..." TextWrapping="Wrap" />
                            <Button Grid.Column="1" x:Name="CancelBtn" Click="CancelBtn_Click" Content="取消" FontSize="12" Padding="8,4" />
                        </Grid>
                        <ProgressBar x:Name="DownloadProgress" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- ══════ 结果 ══════ -->
                <Border x:Name="ResultPanel" Style="{StaticResource FluentCardStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="ResultIcon" Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            <TextBlock x:Name="ResultTitleText" Style="{StaticResource SectionHeaderStyle}" Text="转换完成" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="ResultText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" MaxLines="8" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="OpenFolderBtn_Click" Content="打开输出文件夹" />
                            <Button Click="ResetBtn_Click" Content="继续转换" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ══════ 转换引擎 ══════ -->
                <Expander Header="转换引擎（按需下载 / 系统组件）" HorizontalAlignment="Stretch" IsExpanded="False">
                    <StackPanel Spacing="8" Padding="0,8,0,0">
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"
                                   Text="FFmpeg 处理视频/音频，ImageMagick 处理图片，两者首次使用时自动下载；文档渲染引擎 OfficeCLI（单文件 33MB）负责文档真实渲染（图片/表格/复选框/页眉页脚全保留，未下载时自动回退内置引擎）；OCR 使用系统自带的 Windows OCR 引擎（本地识别）；旧版 Office 格式也可通过本机 Office / WPS 转换。" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- FFmpeg -->
                            <Border Style="{StaticResource FluentCardStyle}">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8B2;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="FFmpeg" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="视频 / 音频 / 图片转视频" />
                                    <TextBlock x:Name="FfmpegStatusText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="检查中..." TextWrapping="Wrap" />
                                    <Button x:Name="FfmpegActionBtn" Click="EngineActionBtn_Click" FontSize="12" Padding="8,4" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>

                            <!-- ImageMagick -->
                            <Border Grid.Column="1" Style="{StaticResource FluentCardStyle}">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE91B;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="ImageMagick" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="图片格式互转" />
                                    <TextBlock x:Name="MagickStatusText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="检查中..." TextWrapping="Wrap" />
                                    <Button x:Name="MagickActionBtn" Grid.Column="1" Click="EngineActionBtn_Click" FontSize="12" Padding="8,4" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>

                            <!-- 文档渲染引擎 -->
                            <Border Grid.Row="1" Style="{StaticResource FluentCardStyle}">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="文档渲染引擎" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="OfficeCLI · Word/Excel/PPT 真实渲染（33MB）" />
                                    <TextBlock x:Name="OfficeCliStatusText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                               Text="检查中..." />
                                    <Button x:Name="OfficeCliActionBtn" Click="EngineActionBtn_Click" FontSize="12" Padding="8,4" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>

                            <!-- 系统组件 -->
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource FluentCardStyle}">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE945;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="系统组件" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="OCR 识别 · Office / WPS" />
                                    <TextBlock x:Name="SystemStatusText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                               Text="检查中..." />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- ══════ 隐藏 WebView2 宿主（文档引擎） ══════ -->
                <WebView2 x:Name="DocWeb" Width="1" Height="1" HorizontalAlignment="Left" VerticalAlignment="Top"
                          IsHitTestVisible="False" Opacity="0.02" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
