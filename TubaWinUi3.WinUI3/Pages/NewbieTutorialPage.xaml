<Page
    x:Class="TubaWinUi3.Pages.NewbieTutorialPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <NavigationView
        x:Name="TutorialNav"
        OpenPaneLength="248"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        SelectionChanged="TutorialNav_SelectionChanged">
        <NavigationView.MenuItems>
            <!-- 菜单项在代码中按工具分类动态构建 -->
        </NavigationView.MenuItems>

        <Grid Padding="24,8,24,24">
            <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ContentHost" MaxWidth="880" HorizontalAlignment="Left" Spacing="16" />
            </ScrollViewer>
        </Grid>
    </NavigationView>
</Page>
