<?xml version="1.0" encoding="utf-8" ?>
<Page xmlns:local="using:TubaWinUi3.Pages" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="using:TubaWinUi3.Controls" xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI" xmlns:toolkit="using:CommunityToolkit.WinUI.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TubaWinUi3.Pages.TrafficMonitorPage">
    <Page.Resources>
        <DataTemplate x:Key="TrafficRowTemplate" x:DataType="local:TrafficMonitorRow">
            <Grid Padding="4,8" ColumnSpacing="12" MinHeight="60" ToolTipService.ToolTip="{x:Bind Description, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="100" />
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{x:Bind Download, Mode=OneWay}" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind DownloadTotal, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{x:Bind Upload, Mode=OneWay}" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind UploadTotal, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource SubtleButtonStyle}" Tag="{x:Bind}" Click="RowDetails_Click" Padding="8" ToolTipService.ToolTip="查看详情与操作" AutomationProperties.Name="查看网络活动详情" AutomationProperties.AutomationId="TrafficRowDetails">
                    <FontIcon Glyph="" FontSize="16" />
                </Button>
            </Grid>
        </DataTemplate>
        <Style x:Key="TrafficListItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
    </Page.Resources>
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" SizeChanged="PageLayout_SizeChanged" AutomationProperties.AutomationId="TrafficPageScroll">
        <StackPanel x:Name="PageLayout" Padding="24,4,24,24" Spacing="12">
            <controls:ToolPageHeader ToolId="traffic-monitor" HeaderPadding="0" Title="流量监控器" Subtitle="看清谁在占用网络，追踪每一次流量变化" Glyph="">
            </controls:ToolPageHeader>
            <Grid RowSpacing="4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ComboBox x:Name="AdapterCombo" HorizontalAlignment="Stretch" SelectionChanged="AdapterCombo_SelectionChanged" AutomationProperties.Name="监控网卡" AutomationProperties.AutomationId="TrafficAdapter" PlaceholderText="选择监控网卡" />
                <Button Grid.Column="1" x:Name="RefreshAdaptersBtn" Click="RefreshAdapters_Click" Padding="9" ToolTipService.ToolTip="刷新网卡列表" AutomationProperties.Name="刷新网卡" AutomationProperties.AutomationId="TrafficRefresh">
                    <FontIcon Glyph="" FontSize="14" />
                </Button>
                <Button Grid.Column="2" x:Name="PauseButton" Content="暂停显示" Click="Pause_Click" ToolTipService.ToolTip="冻结当前画面，后台采集与记录继续运行" AutomationProperties.AutomationId="TrafficPause" />
                <DropDownButton Grid.Column="3" Content="导出" AutomationProperties.AutomationId="TrafficExport" ToolTipService.ToolTip="导出为可用 Excel 打开的 CSV 文件">
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Name="ExportViewItem" Text="导出当前视图（连接明细）" Click="ExportView_Click" AutomationProperties.AutomationId="TrafficExportView" />
                            <MenuFlyoutItem x:Name="ExportRecordItem" Text="导出记录（整卡流量）" Click="ExportRecord_Click" IsEnabled="False" AutomationProperties.AutomationId="TrafficExportRecording" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <TextBlock x:Name="AdapterStatusText" Grid.Row="1" Grid.ColumnSpan="5" Text="正在启动监控…" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                <Button x:Name="MinimizeToTrayButton" Click="MinimizeToTrayButton_Click" ToolTipService.ToolTip="隐藏主窗口并继续后台监控" AutomationProperties.AutomationId="TrafficTray" AutomationProperties.Name="后台监控" Padding="9" Grid.Column="4">
                    <FontIcon Glyph="" FontSize="14" />
                </Button>
            </Grid>
            <toolkit:SettingsExpander x:Name="OverviewSection" Header="流量概览" Description="当前网卡的下载、上传速率与本次累计流量" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Expanded="Section_StateChanged" Collapsed="Section_StateChanged" AutomationProperties.AutomationId="TrafficOverviewSection">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="" />
                </toolkit:SettingsExpander.HeaderIcon>
                <TextBlock x:Name="OverviewSummary" Text="等待采样" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard ContentAlignment="Vertical" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,12">
                        <Grid x:Name="StatsGrid" RowSpacing="8" ColumnSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="UploadColumn" Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="DownloadStats" RowSpacing="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="↓  下载" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="1" x:Name="SpeedInText" Text="—" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource DataSeries3Brush}" />
                                <TextBlock Grid.Row="2" x:Name="TotalInText" Text="本次累计 0 B" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <Grid x:Name="UploadStats" Grid.Row="0" RowSpacing="2" Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="↑  上传" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="1" x:Name="SpeedOutText" Text="—" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource DataSeries1Brush}" />
                                <TextBlock Grid.Row="2" x:Name="TotalOutText" Text="本次累计 0 B" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Grid>
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>
            <toolkit:SettingsExpander x:Name="ConnectionsSection" Header="网络活动" Description="按进程汇总，或展开查看每条连接" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Expanded="Section_StateChanged" Collapsed="Section_StateChanged" AutomationProperties.AutomationId="TrafficConnectionsSection">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="" />
                </toolkit:SettingsExpander.HeaderIcon>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard ContentAlignment="Vertical" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,12">
                        <Grid RowSpacing="8" x:Name="ConnectionsBody">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="300" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ConnCountText" Grid.Column="0" Text="等待连接…" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Grid.ColumnSpan="2" />
                                <Button x:Name="BackLiveBtn" Grid.Column="2" Content="返回实时" Click="BackLive_Click" Visibility="Collapsed" AutomationProperties.AutomationId="TrafficBackLive" />
                                <Button x:Name="ConnPopOutBtn" Grid.Column="3" Click="ConnPopOut_Click" Style="{StaticResource SubtleButtonStyle}" Padding="8" ToolTipService.ToolTip="独立窗口查看网络活动" AutomationProperties.Name="弹出网络活动" AutomationProperties.AutomationId="TrafficConnectionsPopout">
                                    <FontIcon Glyph="" FontSize="14" />
                                </Button>
                            </Grid>
                            <Grid Grid.Row="1" x:Name="FiltersGrid" ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="132" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ComboBox x:Name="ViewCombo" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="Filter_Changed" AutomationProperties.Name="网络活动视图" AutomationProperties.AutomationId="TrafficViewMode">
                                    <ComboBoxItem Content="按进程汇总" />
                                    <ComboBoxItem Content="连接明细" />
                                </ComboBox>
                                <TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="搜索进程、PID、域名或 IP" TextChanged="Search_TextChanged" AutomationProperties.Name="搜索网络活动" AutomationProperties.AutomationId="TrafficSearch" />
                                <ComboBox x:Name="SortCombo" Grid.Column="2" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="Filter_Changed" AutomationProperties.Name="排序方式" AutomationProperties.AutomationId="TrafficSort">
                                    <ComboBoxItem Content="按实时流量" />
                                    <ComboBoxItem Content="按下载速度" />
                                    <ComboBoxItem Content="按上传速度" />
                                    <ComboBoxItem Content="按累计流量" />
                                    <ComboBoxItem Content="按进程名称" />
                                </ComboBox>
                                <CheckBox x:Name="ActiveOnlyBox" Grid.Column="3" Content="仅活跃" Checked="ActiveOnly_Changed" Unchecked="ActiveOnly_Changed" ToolTipService.ToolTip="只显示本次采样中有下载或上传的连接" AutomationProperties.AutomationId="TrafficActiveOnly" />
                            </Grid>
                            <Grid Grid.Row="2" Padding="12,0,48,0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="104" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="进程 / 远程地址" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="↓ 速度 / 累计" FontSize="12" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="2" Text="↑ 速度 / 累计" FontSize="12" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <Grid Grid.Row="3">
                                <ListView x:Name="ConnectionList" ItemsSource="{x:Bind Rows, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Connection_ItemClick" ItemTemplate="{StaticResource TrafficRowTemplate}" ItemContainerStyle="{StaticResource TrafficListItemStyle}" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="网络活动列表" AutomationProperties.AutomationId="TrafficConnections" />
                                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsHitTestVisible="False">
                                    <FontIcon Glyph="" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="EmptyText" Text="正在获取网络活动…" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                    <TextBlock Text="整卡速率仍会独立显示" FontSize="12" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Grid.Row="4" x:Name="ScopeText" Text="明细统计已建立的 TCP 连接；与整卡流量的统计范围不同。点击任意行查看详情。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </Grid>
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>
            <toolkit:SettingsExpander x:Name="TrendSection" Header="实时趋势" Description="下载与上传曲线，支持近 1 / 2 / 5 分钟" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Expanded="Section_StateChanged" Collapsed="Section_StateChanged" AutomationProperties.AutomationId="TrafficTrendSection">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="" />
                </toolkit:SettingsExpander.HeaderIcon>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard ContentAlignment="Vertical" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,12">
                        <Grid RowSpacing="4" Height="220">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <TextBlock Text="流量趋势" FontWeight="SemiBold" />
                                    <TextBlock Text="↓ 下载" FontSize="12" Foreground="{ThemeResource DataSeries3Brush}" />
                                    <TextBlock Text="↑ 上传" FontSize="12" Foreground="{ThemeResource DataSeries1Brush}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" x:Name="ChartRangeCombo" SelectedIndex="1" SelectionChanged="ChartRange_Changed" MinWidth="96" AutomationProperties.Name="趋势时间范围" AutomationProperties.AutomationId="TrafficChartRange">
                                    <ComboBoxItem Content="近 1 分钟" Tag="60" />
                                    <ComboBoxItem Content="近 2 分钟" Tag="120" />
                                    <ComboBoxItem Content="近 5 分钟" Tag="300" />
                                </ComboBox>
                                <Button Grid.Column="2" x:Name="ChartPopOutBtn" Click="ChartPopOut_Click" Padding="8" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="独立窗口查看趋势" AutomationProperties.Name="弹出趋势图" AutomationProperties.AutomationId="TrafficChartPopout">
                                    <FontIcon Glyph="" FontSize="14" />
                                </Button>
                            </Grid>
                            <lvc:CartesianChart x:Name="TrafficChart" Grid.Row="1" Background="Transparent" />
                            <TextBlock Grid.Row="2" x:Name="ChartStatusText" Text="等待采样 · 整卡流量包含所有协议" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>
            <toolkit:SettingsExpander x:Name="RecordingSection" Header="记录与回放" Description="保留最近 3600 次采样，支持时间轴回放与 CSV 导出" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Expanded="Section_StateChanged" Collapsed="Section_StateChanged" AutomationProperties.AutomationId="TrafficRecordingSection">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="" />
                </toolkit:SettingsExpander.HeaderIcon>
                <Button x:Name="RecordButton" Content="开始记录" Click="Record_Click" AutomationProperties.AutomationId="TrafficRecord" ToolTipService.ToolTip="记录最近 3600 次采样，可拖动时间轴回看或导出" />
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard ContentAlignment="Vertical" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,12">
                        <Grid ColumnSpacing="8" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Slider x:Name="SnapshotSlider" Grid.Column="1" Minimum="0" Maximum="1" StepFrequency="1" IsEnabled="False" ValueChanged="SnapshotSlider_ValueChanged" AutomationProperties.Name="记录回放时间轴" AutomationProperties.AutomationId="TrafficTimeline" />
                            <Button Grid.Column="2" x:Name="ClearRecordBtn" Click="ClearRecord_Click" IsEnabled="False" Padding="9" ToolTipService.ToolTip="清除记录" AutomationProperties.Name="清除记录" AutomationProperties.AutomationId="TrafficClearRecording">
                                <FontIcon Glyph="" FontSize="14" />
                            </Button>
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="3" x:Name="RecStatusText" Text="尚未记录 · 后台约每秒采样一次，支持时间轴回放" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>
            <InfoBar x:Name="NoticeBar" IsOpen="False" IsClosable="True" />
        </StackPanel>
    </ScrollViewer>
</Page>
