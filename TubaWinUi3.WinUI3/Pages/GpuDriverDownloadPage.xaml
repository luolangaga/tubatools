<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TubaWinUi3.Pages.GpuDriverDownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TubaWinUi3.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:ToolPageHeader
            Grid.Row="0"
            Title="显卡驱动下载"
            Subtitle="从 NVIDIA、AMD、Intel 官方驱动目录选择型号和版本"
            Glyph="&#xE950;">
            <controls:ToolPageHeader.Actions>
                <Button Click="OpenDownloadFolder_Click" Padding="10,5" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE8B7;" />
                        <TextBlock Text="下载目录" />
                    </StackPanel>
                </Button>
            </controls:ToolPageHeader.Actions>
        </controls:ToolPageHeader>

        <Grid Grid.Row="1" RowSpacing="8" Padding="24,4,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="厂商" VerticalAlignment="Center" />
                <ComboBox
                    x:Name="VendorCombo"
                    Grid.Column="1"
                    SelectedIndex="0"
                    SelectionChanged="VendorCombo_SelectionChanged" />
                <Button Grid.Column="2" Click="BackButton_Click" ToolTipService.ToolTip="后退">
                    <FontIcon Glyph="&#xE72B;" />
                </Button>
                <Button Grid.Column="3" Click="RefreshButton_Click" ToolTipService.ToolTip="刷新">
                    <FontIcon Glyph="&#xE72C;" />
                </Button>
                <Button Grid.Column="4" Click="OpenInBrowserButton_Click" ToolTipService.ToolTip="在浏览器中打开官方页面">
                    <FontIcon Glyph="&#xE774;" />
                </Button>
                <ProgressRing
                    x:Name="LoadingRing"
                    Grid.Column="5"
                    Width="20"
                    Height="20"
                    HorizontalAlignment="Right"
                    IsActive="False" />
            </Grid>

            <TextBlock
                Grid.Row="1"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="在官方页面选择显卡型号和驱动版本；下载的 .exe / .zip 安装包会保存到「下载」下的「图吧工具箱\显卡驱动」目录。" />

            <WebView2
                x:Name="DriverWebView"
                Grid.Row="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />

            <TextBlock
                x:Name="StatusText"
                Grid.Row="3"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="仅从 NVIDIA、AMD、Intel 官方域名下载驱动安装包；下载完成后请自行确认并安装。" />
        </Grid>
    </Grid>
</Page>
