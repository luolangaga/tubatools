<?xml version='1.0' encoding='utf-8'?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:controls="using:TubaWinUi3.Controls" xmlns:toolkit="using:CommunityToolkit.WinUI.Controls" x:Class="TubaWinUi3.Pages.RuntimeRepairPage" mc:Ignorable="d" Loaded="RuntimeRepairPage_Loaded" Unloaded="RuntimeRepairPage_Unloaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <controls:ToolPageHeader ToolId="runtime-repair" Grid.Row="0" Title="运行库修复" Subtitle="检测系统运行库与游戏常用 DLL，仅修复缺失或不完整的项目" Glyph=""/>
        <!-- 正文 -->
        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="24,4,24,32" HorizontalContentAlignment="Stretch" controls:ToolViewport.ConstrainContent="True">
            <StackPanel Spacing="8" MaxWidth="1120">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromHorizontalOffset="0" FromVerticalOffset="24" IsStaggeringEnabled="True"/>
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True" Title="运行库修复失败"/>
                <InfoBar x:Name="SuccessBar" Severity="Success" IsOpen="False" IsClosable="True" Title="运行库修复完成"/>
                <!-- ═════════ Visual C++ 2008-2026 ═════════ -->
                <toolkit:SettingsExpander IsExpanded="True">
                    <toolkit:SettingsExpander.Header>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="VcIconBg" Style="{StaticResource IconTileStyle}" VerticalAlignment="Top">
                                <FontIcon x:Name="VcIcon" FontSize="20" Glyph="" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </Border>
                            <TextBlock Text="Microsoft Visual C++ 2008-2026" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        </Grid>
                    </toolkit:SettingsExpander.Header>
                    <toolkit:SettingsExpander.Description>
                        <TextBlock x:Name="VcDesc" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="检测并修复游戏常用 VC++ x86 和 x64 运行库" TextWrapping="Wrap"/>
                    </toolkit:SettingsExpander.Description>
                    <StackPanel Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <FontIcon x:Name="VcStatusIcon" FontSize="12" Glyph="" Visibility="Collapsed"/>
                            <TextBlock x:Name="VcStatusText" FontSize="12" FontWeight="SemiBold" Text="检测中…"/>
                        </StackPanel>
                        <Button x:Name="VcRepairButton" Tag="visual-cpp" Click="RepairButton_Click" MinWidth="112" MinHeight="34" Padding="12,0" IsEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing x:Name="VcBtnSpinner" Width="14" Height="14" IsActive="True" Visibility="Collapsed" VerticalAlignment="Center"/>
                                <TextBlock x:Name="VcBtnText" FontSize="14" Text="修复缺失项" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                            <toolkit:SettingsCard.Header>
                                <TextBlock x:Name="VcDetail" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="覆盖 2008、2010、2012、2013 及当前 v14 (2015-2026)；v14 同时校验完整运行时 DLL。" TextWrapping="Wrap"/>
                            </toolkit:SettingsCard.Header>
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="VcMissing" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                                <StackPanel x:Name="VcProgressPanel" Visibility="Collapsed" Spacing="4" Margin="0,8,0,0">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="VcPhaseText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock x:Name="VcPctText" Grid.Column="1" FontSize="12" FontWeight="SemiBold" Text="0%"/>
                                    </Grid>
                                    <ProgressBar x:Name="VcBar" Height="5" Minimum="0" Maximum="100" Value="0"/>
                                </StackPanel>
                            </StackPanel>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
                <!-- ═════════ .NET Framework ═════════ -->
                <toolkit:SettingsExpander IsExpanded="True">
                    <toolkit:SettingsExpander.Header>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="DotNetIconBg" Style="{StaticResource IconTileStyle}" VerticalAlignment="Top">
                                <FontIcon x:Name="DotNetIcon" FontSize="20" Glyph="" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </Border>
                            <TextBlock Text=".NET Framework 4.8.1" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        </Grid>
                    </toolkit:SettingsExpander.Header>
                    <toolkit:SettingsExpander.Description>
                        <TextBlock x:Name="DotNetDesc" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="修复 Microsoft .NET Framework 4.8.1 Runtime" TextWrapping="Wrap"/>
                    </toolkit:SettingsExpander.Description>
                    <StackPanel Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <FontIcon x:Name="DotNetStatusIcon" FontSize="12" Glyph="" Visibility="Collapsed"/>
                            <TextBlock x:Name="DotNetStatusText" FontSize="12" FontWeight="SemiBold" Text="检测中…"/>
                        </StackPanel>
                        <Button x:Name="DotNetRepairButton" Tag="dotnet" Click="RepairButton_Click" MinWidth="112" MinHeight="34" Padding="12,0" IsEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing x:Name="DotNetBtnSpinner" Width="14" Height="14" IsActive="True" Visibility="Collapsed" VerticalAlignment="Center"/>
                                <TextBlock x:Name="DotNetBtnText" FontSize="14" Text="修复缺失项" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                            <toolkit:SettingsCard.Header>
                                <TextBlock x:Name="DotNetDetail" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="使用微软离线 Runtime 安装包，不安装开发者工具包。" TextWrapping="Wrap"/>
                            </toolkit:SettingsCard.Header>
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="DotNetMissing" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                                <StackPanel x:Name="DotNetProgressPanel" Visibility="Collapsed" Spacing="4" Margin="0,8,0,0">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="DotNetPhaseText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock x:Name="DotNetPctText" Grid.Column="1" FontSize="12" FontWeight="SemiBold" Text="0%"/>
                                    </Grid>
                                    <ProgressBar x:Name="DotNetBar" Height="5" Minimum="0" Maximum="100" Value="0"/>
                                </StackPanel>
                            </StackPanel>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
                <!-- ═════════ DirectX 9-12 ═════════ -->
                <toolkit:SettingsExpander IsExpanded="True">
                    <toolkit:SettingsExpander.Header>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="DxIconBg" Style="{StaticResource IconTileStyle}" VerticalAlignment="Top">
                                <FontIcon x:Name="DxIcon" FontSize="20" Glyph="" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </Border>
                            <TextBlock Text="DirectX 9-12 游戏组件" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        </Grid>
                    </toolkit:SettingsExpander.Header>
                    <toolkit:SettingsExpander.Description>
                        <TextBlock x:Name="DxDesc" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="补充旧版 DirectX SDK 兼容组件" TextWrapping="Wrap"/>
                    </toolkit:SettingsExpander.Description>
                    <StackPanel Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <FontIcon x:Name="DxStatusIcon" FontSize="12" Glyph="" Visibility="Collapsed"/>
                            <TextBlock x:Name="DxStatusText" FontSize="12" FontWeight="SemiBold" Text="检测中…"/>
                        </StackPanel>
                        <Button x:Name="DxRepairButton" Tag="directx" Click="RepairButton_Click" MinWidth="112" MinHeight="34" Padding="12,0" IsEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing x:Name="DxBtnSpinner" Width="14" Height="14" IsActive="True" Visibility="Collapsed" VerticalAlignment="Center"/>
                                <TextBlock x:Name="DxBtnText" FontSize="14" Text="修复缺失项" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                            <toolkit:SettingsCard.Header>
                                <TextBlock x:Name="DxDetail" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="修复 D3DX、XAudio、XInput 等旧游戏依赖；系统 DirectX 12 由 Windows 更新维护。" TextWrapping="Wrap"/>
                            </toolkit:SettingsCard.Header>
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="DxMissing" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                                <StackPanel x:Name="DxProgressPanel" Visibility="Collapsed" Spacing="4" Margin="0,8,0,0">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="DxPhaseText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock x:Name="DxPctText" Grid.Column="1" FontSize="12" FontWeight="SemiBold" Text="0%"/>
                                    </Grid>
                                    <ProgressBar x:Name="DxBar" Height="5" Minimum="0" Maximum="100" Value="0"/>
                                </StackPanel>
                            </StackPanel>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="安装过程可能需要网络连接，完成后按系统提示重启。"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>