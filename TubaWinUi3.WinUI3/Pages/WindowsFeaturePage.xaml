<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TubaWinUi3.Pages.WindowsFeaturePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:TubaWinUi3.Pages"
    mc:Ignorable="d"
    Loaded="WindowsFeaturePage_Loaded">

    <Page.Resources>
        <!-- 小圆角提示标签的通用底框 -->
        <Style x:Key="TagBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Background" Value="#14000000" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 列表项去毛边 -->
        <Style x:Key="FeatureItemContainer" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <!-- 功能卡片模板（浏览列表与搜索结果共用） -->
        <DataTemplate x:Key="FeatureCardTemplate" x:DataType="local:FeatureRowVm">
            <Border Background="#0D000000" BorderBrush="#1F000000" BorderThickness="1" CornerRadius="12" Padding="14,10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Style="{StaticResource TagBorder}">
                                <TextBlock FontSize="12" Opacity="0.85" Text="{x:Bind IdText}" />
                            </Border>
                            <Border Style="{StaticResource TagBorder}" Background="{x:Bind StateBackground}">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{x:Bind StateBrush}" Text="{x:Bind StateText}" />
                            </Border>
                            <Border Style="{StaticResource TagBorder}" Background="{x:Bind ExperimentBackground}" Visibility="{x:Bind ExperimentVisibility}">
                                <TextBlock FontSize="12" Foreground="{x:Bind ExperimentBrush}" Text="{x:Bind ExperimentText}" />
                            </Border>
                            <Border Style="{StaticResource TagBorder}">
                                <TextBlock FontSize="12" Opacity="0.7" Text="{x:Bind PriorityText}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button CornerRadius="7" Padding="12,6" Tag="{x:Bind Self}" IsEnabled="{x:Bind CanEnable}" Click="FeatureButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE73E;" FontSize="12" />
                                <TextBlock Text="启用" FontSize="13" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel Spacing="10" Padding="4,0">
                                        <TextBlock Text="{x:Bind FlyoutTitle}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind FlyoutDesc}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                            <Button Content="取消" CornerRadius="7" Click="CancelFlyout_Click" />
                                            <Button Content="确认启用" CornerRadius="7" Style="{StaticResource AccentButtonStyle}" Tag="{x:Bind Self}" Click="ConfirmFeature_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button CornerRadius="7" Padding="12,6" Tag="{x:Bind Self}" IsEnabled="{x:Bind CanDisable}" Click="FeatureButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE71A;" FontSize="12" />
                                <TextBlock Text="禁用" FontSize="13" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel Spacing="10" Padding="4,0">
                                        <TextBlock Text="{x:Bind FlyoutTitle}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind FlyoutDesc}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                            <Button Content="取消" CornerRadius="7" Click="CancelFlyout_Click" />
                                            <Button Content="确认禁用" CornerRadius="7" Style="{StaticResource AccentButtonStyle}" Tag="{x:Bind Self}" Click="ConfirmFeature_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button CornerRadius="7" Padding="12,6" Tag="{x:Bind Self}" IsEnabled="{x:Bind CanReset}" Click="FeatureButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE777;" FontSize="12" />
                                <TextBlock Text="重置" FontSize="13" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel Spacing="10" Padding="4,0">
                                        <TextBlock Text="{x:Bind FlyoutTitle}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind FlyoutDesc}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                            <Button Content="取消" CornerRadius="7" Click="CancelFlyout_Click" />
                                            <Button Content="确认重置" CornerRadius="7" Style="{StaticResource AccentButtonStyle}" Tag="{x:Bind Self}" Click="ConfirmFeature_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Padding="28,18,28,8" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 品牌渐变图标块 -->
            <Border Width="44" Height="44" CornerRadius="13">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#7C6CF0" />
                        <GradientStop Offset="1" Color="#5B8DEF" />
                    </LinearGradientBrush>
                </Border.Background>
                <FontIcon FontSize="20" Foreground="White" Glyph="&#xE950;" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <TextBlock FontSize="21" FontWeight="SemiBold" Text="Windows 隐藏功能" />
                <TextBlock FontSize="12" Opacity="0.65" Text="系统功能配置 API 直读（ViVe 引擎移植）· 查询 / 启用 / 禁用 / 重置实验性功能开关" />
            </StackPanel>
            <Button x:Name="BackButton" Grid.Column="2" Click="BackButton_Click" Padding="10,5" VerticalAlignment="Center" Margin="0,0,8,0" Background="Transparent" BorderBrush="#26000000">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="12" />
                    <TextBlock Text="返回" FontSize="13" />
                </StackPanel>
            </Button>
            <Button x:Name="RefreshButton" Grid.Column="3" Click="RefreshButton_Click" Padding="12,5" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon x:Name="RefreshIcon" Glyph="&#xE72C;" FontSize="12" />
                    <TextBlock x:Name="RefreshText" Text="重新加载" FontSize="13" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 正文 -->
        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto" Padding="28,6,28,28">
            <StackPanel Spacing="16">

                <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True" Title="操作失败" />
                <InfoBar x:Name="SuccessBar" Severity="Success" IsOpen="False" IsClosable="True" />
                <!-- nexbox 同款状态提示（刷新时按实际状态切换可见性） -->
                <InfoBar x:Name="BootPendingBar" Severity="Informational" IsOpen="True" IsClosable="False" Visibility="Collapsed"
                         Title="部分功能配置将在下次重启后生效" />
                <InfoBar x:Name="NotAdminBar" Severity="Warning" IsOpen="True" IsClosable="False" Visibility="Collapsed"
                         Title="当前未以管理员身份运行" Message="启用 / 禁用 / 重置操作将被系统拒绝，请以管理员身份重新启动工具箱。" />
                <InfoBar x:Name="DictMissingBar" Severity="Warning" IsOpen="True" IsClosable="False" Visibility="Collapsed"
                         Title="未找到功能字典（FeatureDictionary.pfs）" Message="列表将只显示系统已有配置的编号，无法按名称搜索。" />

                <!-- 加载中 -->
                <StackPanel x:Name="LoadingPanel" Visibility="Collapsed" Spacing="12" Padding="0,64">
                    <ProgressRing Width="42" Height="42" IsActive="True" HorizontalAlignment="Center" Foreground="#7C6CF0" />
                    <TextBlock FontSize="13" Opacity="0.7" HorizontalAlignment="Center" Text="正在读取功能配置存储…" />
                </StackPanel>

                <!-- 系统不支持 -->
                <Border x:Name="MissingPanel" Visibility="Collapsed" CornerRadius="22" Padding="24" BorderThickness="1" BorderBrush="#26F5A623">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#14F5A623" />
                            <GradientStop Offset="1" Color="#00000000" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Spacing="8" HorizontalAlignment="Center" Padding="0,18">
                        <FontIcon Glyph="&#xE7BA;" FontSize="30" Foreground="#F5A623" HorizontalAlignment="Center" />
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="当前系统不支持功能配置 API" HorizontalAlignment="Center" />
                        <TextBlock x:Name="MissingText" FontSize="12" Opacity="0.7" TextWrapping="Wrap" MaxWidth="560" TextAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- 主内容 -->
                <StackPanel x:Name="ContentPanel" Visibility="Collapsed" Spacing="16">

                    <!-- ═════════ 状态统计（4 枚小圆角芯片） ═════════ -->
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="#0D000000" BorderBrush="#1F000000" BorderThickness="1" CornerRadius="10" Padding="14,10">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#7C6CF0" VerticalAlignment="Center" />
                                <StackPanel Spacing="0">
                                    <TextBlock x:Name="BuildValue" FontSize="25" FontWeight="Bold" Text="--" Foreground="#7C6CF0" />
                                    <TextBlock FontSize="12" Opacity="0.6" Text="系统版本" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#0D000000" BorderBrush="#1F000000" BorderThickness="1" CornerRadius="10" Padding="14,10">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#5B8DEF" VerticalAlignment="Center" />
                                <StackPanel Spacing="0">
                                    <TextBlock x:Name="DictValue" FontSize="25" FontWeight="Bold" Text="--" Foreground="#5B8DEF" />
                                    <TextBlock FontSize="12" Opacity="0.6" Text="功能字典" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#0D000000" BorderBrush="#1F000000" BorderThickness="1" CornerRadius="10" Padding="14,10">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#2BB673" VerticalAlignment="Center" />
                                <StackPanel Spacing="0">
                                    <TextBlock x:Name="ConfiguredValue" FontSize="25" FontWeight="Bold" Text="--" Foreground="#2BB673" />
                                    <TextBlock FontSize="12" Opacity="0.6" Text="已配置功能" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Background="#0D000000" BorderBrush="#1F000000" BorderThickness="1" CornerRadius="10" Padding="14,10">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#F5A623" VerticalAlignment="Center" />
                                <StackPanel Spacing="0">
                                    <TextBlock x:Name="EnabledValue" FontSize="25" FontWeight="Bold" Text="--" Foreground="#F5A623" />
                                    <TextBlock FontSize="12" Opacity="0.6" Text="已启用" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ═════════ 功能列表（浏览 + 搜索，nexbox 单列表逻辑） ═════════ -->
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="功能列表" />
                            <TextBlock x:Name="ListStats" FontSize="12" Opacity="0.55" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <!-- 搜索框：打字不触发查询，回车 / 点击搜索按钮才提交（nexbox 同款） -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchBox" PlaceholderText="输入功能名称或 ID（回车或点击搜索提交），如 TIFE、48433719…" FontSize="14" />
                            <Button x:Name="SearchButton" Grid.Column="1" CornerRadius="7" Padding="16,10" Click="SearchButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE721;" FontSize="13" />
                                    <TextBlock Text="搜索" FontSize="13" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 存储切换 + 展示开关（nexbox 同款：store / namedOnly / persistBoot） -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <ToggleButton x:Name="RuntimeStoreButton" Click="StoreButton_Click" Padding="12,5" CornerRadius="7"
                                              ToolTipService.ToolTip="运行时存储：本次开机有效的功能配置">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE770;" FontSize="12" />
                                        <TextBlock Text="运行时" FontSize="13" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="BootStoreButton" Click="StoreButton_Click" Padding="12,5" CornerRadius="7"
                                              ToolTipService.ToolTip="引导存储：重启后依然生效的持久化配置">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE7E8;" FontSize="12" />
                                        <TextBlock Text="引导（重启生效）" FontSize="13" />
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ToggleSwitch x:Name="NamedOnlyToggle" OnContent="仅显示有名称" OffContent="显示全部配置"
                                              MinWidth="0" Margin="0,0" ToolTipService.ToolTip="浏览态（无搜索词）只显示字典可识别名称的条目，过滤系统内部 servicing 编号项" />
                                <ToggleSwitch x:Name="PersistBootToggle" OnContent="重启后保持生效" OffContent="仅本次开机有效"
                                              MinWidth="0" Margin="0,0" ToolTipService.ToolTip="启用 / 禁用时是否同时写入 Boot 存储（注册表 Overrides），重启后保持生效" />
                            </StackPanel>
                        </Grid>

                        <!-- 单一列表：浏览态 = 所选存储全量配置（按 ID 升序），搜索态 = 配置命中 + 字典补充 -->
                        <ListView x:Name="FeatureList" SelectionMode="None"
                                  ItemContainerStyle="{StaticResource FeatureItemContainer}"
                                  ItemTemplate="{StaticResource FeatureCardTemplate}" />

                        <!-- 空状态 / 无结果 -->
                        <Border x:Name="NoResultsPanel" Background="#0D000000" BorderBrush="#1F000000" BorderThickness="1"
                                CornerRadius="12" Padding="20,18" Visibility="Collapsed">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE721;" FontSize="20" Opacity="0.4" HorizontalAlignment="Center" />
                                <TextBlock x:Name="NoResultsText" FontSize="13" Opacity="0.6" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- 分批加载：每批 100 条（nexbox PAGE_SIZE） -->
                        <Button x:Name="LoadMoreButton" HorizontalAlignment="Center" Padding="20,8" CornerRadius="7"
                                Click="LoadMoreButton_Click" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                <TextBlock Text="加载更多" FontSize="13" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 使用说明 -->
                    <Border Background="#0D000000" BorderBrush="#1F000000" BorderThickness="1" CornerRadius="12" Padding="16,12">
                        <StackPanel Spacing="6">
                            <TextBlock FontSize="14" FontWeight="SemiBold">
                                <Run Text="使用说明" /><Run Text="　" /><Run Text="(需求 Windows 10 1903+ 系统)" FontSize="11" Foreground="#808080" />
                            </TextBlock>
                            <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap" LineHeight="19">
                                <Run Text="· 总列表按功能 ID 升序分批展示（单次最多 500 条，点击「加载更多」继续），默认仅显示字典可识别名称的条目，可关闭「仅显示有名称」查看系统内部 servicing 配置；「运行时 / 引导」切换查看两种存储。" />
                                <LineBreak />
                                <Run Text="· 搜索按名称或数字 ID 匹配系统配置与内置功能字典（17000 条），字典命中但系统未配置的条目会以「未配置」状态一并展示，可直接启用。" />
                                <LineBreak />
                                <Run Text="· 「启用 / 禁用」写入 User 优先级（ViVeTool 同款）；「重启后保持生效」开启时同时写入 Boot 存储，关闭时仅本次开机有效；「重置」会删除该功能的全部自定义配置，恢复系统默认。部分功能需要重启才能生效。" />
                                <LineBreak />
                                <Run Text="· 实验性功能可能不稳定或引发系统异常，请按需开启、谨慎操作。" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
