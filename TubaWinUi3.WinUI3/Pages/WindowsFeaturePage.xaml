<?xml version="1.0" encoding="utf-8" ?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="using:TubaWinUi3.Pages" xmlns:controls="using:TubaWinUi3.Controls" x:Class="TubaWinUi3.Pages.WindowsFeaturePage" mc:Ignorable="d" Loaded="WindowsFeaturePage_Loaded">
    <Page.Resources>
        <!-- 小圆角提示标签的通用底框 -->
        <Style x:Key="TagBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- 列表项去毛边 -->
        <Style x:Key="FeatureItemContainer" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <!-- 功能卡片模板（浏览列表与搜索结果共用） -->
        <DataTemplate x:Key="FeatureCardTemplate" x:DataType="local:FeatureRowVm">
            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Style="{StaticResource TagBorder}">
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind IdText}"/>
                            </Border>
                            <Border Style="{StaticResource TagBorder}" Background="{x:Bind StateBackground}">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{x:Bind StateBrush}" Text="{x:Bind StateText}"/>
                            </Border>
                            <Border Style="{StaticResource TagBorder}" Background="{x:Bind ExperimentBackground}" Visibility="{x:Bind ExperimentVisibility}">
                                <TextBlock FontSize="12" Foreground="{x:Bind ExperimentBrush}" Text="{x:Bind ExperimentText}"/>
                            </Border>
                            <Border Style="{StaticResource TagBorder}">
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind PriorityText}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Grid.Row="1">
                        <Button CornerRadius="4" Padding="12,8" Tag="{x:Bind Self}" IsEnabled="{x:Bind CanEnable}" Click="FeatureButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE73E;" FontSize="12"/>
                                <TextBlock Text="启用" FontSize="14"/>
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel Spacing="8" Padding="4,0">
                                        <TextBlock Text="{x:Bind FlyoutTitle}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{x:Bind FlyoutDesc}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                            <Button Content="取消" CornerRadius="4" Click="CancelFlyout_Click"/>
                                            <Button Content="确认启用" CornerRadius="4" Style="{StaticResource AccentButtonStyle}" Tag="{x:Bind Self}" Click="ConfirmFeature_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button CornerRadius="4" Padding="12,8" Tag="{x:Bind Self}" IsEnabled="{x:Bind CanDisable}" Click="FeatureButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE71A;" FontSize="12"/>
                                <TextBlock Text="禁用" FontSize="14"/>
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel Spacing="8" Padding="4,0">
                                        <TextBlock Text="{x:Bind FlyoutTitle}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{x:Bind FlyoutDesc}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                            <Button Content="取消" CornerRadius="4" Click="CancelFlyout_Click"/>
                                            <Button Content="确认禁用" CornerRadius="4" Style="{StaticResource AccentButtonStyle}" Tag="{x:Bind Self}" Click="ConfirmFeature_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button CornerRadius="4" Padding="12,8" Tag="{x:Bind Self}" IsEnabled="{x:Bind CanReset}" Click="FeatureButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE777;" FontSize="12"/>
                                <TextBlock Text="重置" FontSize="14"/>
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel Spacing="8" Padding="4,0">
                                        <TextBlock Text="{x:Bind FlyoutTitle}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{x:Bind FlyoutDesc}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                            <Button Content="取消" CornerRadius="4" Click="CancelFlyout_Click"/>
                                            <Button Content="确认重置" CornerRadius="4" Style="{StaticResource AccentButtonStyle}" Tag="{x:Bind Self}" Click="ConfirmFeature_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <controls:ToolPageHeader ToolId="windows-feature" Grid.Row="0" Title="Windows 隐藏功能" Subtitle="系统功能配置 API 直读（ViVe 引擎移植）· 查询 / 启用 / 禁用 / 重置实验性功能开关" Glyph="&#xE950;">
            <controls:ToolPageHeader.Actions>
                <Button x:Name="RefreshButton" Click="RefreshButton_Click" Style="{StaticResource ToolHeaderActionButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:Name="RefreshIcon" Glyph="&#xE72C;" FontSize="12"/>
                        <TextBlock x:Name="RefreshText" Text="重新加载"/>
                    </StackPanel>
                </Button>
            </controls:ToolPageHeader.Actions>
        </controls:ToolPageHeader>
        <!-- 正文 -->
        <Grid Grid.Row="1" Padding="24,4,24,24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Spacing="8">
                <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True" Title="操作失败"/>
                <InfoBar x:Name="SuccessBar" Severity="Success" IsOpen="False" IsClosable="True"/>
                <InfoBar x:Name="BootPendingBar" Severity="Informational" IsOpen="True" IsClosable="False" Visibility="Collapsed" Title="部分功能配置将在下次重启后生效"/>
                <InfoBar x:Name="NotAdminBar" Severity="Warning" IsOpen="True" IsClosable="False" Visibility="Collapsed" Title="当前未以管理员身份运行" Message="启用 / 禁用 / 重置操作将被系统拒绝，请以管理员身份重新启动工具箱。"/>
                <InfoBar x:Name="DictMissingBar" Severity="Warning" IsOpen="True" IsClosable="False" Visibility="Collapsed" Title="未找到功能字典（FeatureDictionary.pfs）" Message="列表将只显示系统已有配置的编号，无法按名称搜索。"/>
                <StackPanel x:Name="LoadingPanel" Visibility="Collapsed" Spacing="12" Padding="0,64">
                    <ProgressRing Width="42" Height="42" IsActive="True" HorizontalAlignment="Center" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Text="正在读取功能配置存储…"/>
                </StackPanel>
                <Border x:Name="MissingPanel" Visibility="Collapsed" CornerRadius="8" Padding="24" BorderThickness="1" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" BorderBrush="{ThemeResource SystemFillColorCautionBrush}">
                    <StackPanel Spacing="8" HorizontalAlignment="Center" Padding="0,16">
                        <FontIcon Glyph="&#xE7BA;" FontSize="28" Foreground="{ThemeResource SystemFillColorCautionBrush}" HorizontalAlignment="Center"/>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="当前系统不支持功能配置 API" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="MissingText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxWidth="560" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <Grid x:Name="ContentPanel" Visibility="Collapsed" RowSpacing="16" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- ═════════ 状态统计（4 枚小圆角芯片） ═════════ -->
                <Grid ColumnSpacing="24" Style="{StaticResource ToolSummaryStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border>
                        <StackPanel Spacing="0">
                            <TextBlock x:Name="BuildValue" Style="{StaticResource StatValueStyle}" Text="--" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="系统版本"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1">
                        <StackPanel Spacing="0">
                            <TextBlock x:Name="DictValue" Style="{StaticResource StatValueStyle}" Text="--" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="功能字典"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2">
                        <StackPanel Spacing="0">
                            <TextBlock x:Name="ConfiguredValue" Style="{StaticResource StatValueStyle}" Text="--" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="已配置功能"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3">
                        <StackPanel Spacing="0">
                            <TextBlock x:Name="EnabledValue" Style="{StaticResource StatValueStyle}" Text="--" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="已启用"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <!-- ═════════ 功能列表（浏览 + 搜索，nexbox 单列表逻辑） ═════════ -->
                <Grid RowSpacing="12" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="功能列表"/>
                        <TextBlock x:Name="ListStats" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <!-- 搜索框：打字不触发查询，回车 / 点击搜索按钮才提交（nexbox 同款） -->
                    <Grid ColumnSpacing="8" Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <AutoSuggestBox x:Name="SearchBox" PlaceholderText="输入功能名称或 ID（回车或点击搜索提交），如 TIFE、48433719…" QueryIcon="Find" TextChanged="SearchBox_TextChanged" QuerySubmitted="SearchBox_QuerySubmitted"/>
                        <Button x:Name="SearchButton" Grid.Column="1" CornerRadius="4" Padding="16,8" Click="SearchButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE721;" FontSize="12"/>
                                <TextBlock Text="搜索" FontSize="14"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <!-- 存储切换 + 展示开关（nexbox 同款：store / namedOnly / persistBoot） -->
                    <StackPanel Grid.Row="2" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <ToggleButton x:Name="RuntimeStoreButton" Click="StoreButton_Click" Padding="12,4" CornerRadius="4" ToolTipService.ToolTip="运行时存储：本次开机有效的功能配置">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE770;" FontSize="12"/>
                                    <TextBlock Text="运行时" FontSize="14"/>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="BootStoreButton" Click="StoreButton_Click" Padding="12,4" CornerRadius="4" ToolTipService.ToolTip="引导存储：重启后依然生效的持久化配置">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE7E8;" FontSize="12"/>
                                    <TextBlock Text="引导（重启生效）" FontSize="14"/>
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <ToggleSwitch x:Name="NamedOnlyToggle" OnContent="仅显示有名称" OffContent="显示全部配置" MinWidth="0" Margin="0,0" ToolTipService.ToolTip="浏览态（无搜索词）只显示字典可识别名称的条目，过滤系统内部 servicing 编号项"/>
                            <ToggleSwitch x:Name="PersistBootToggle" OnContent="重启后保持生效" OffContent="仅本次开机有效" MinWidth="0" Margin="0,0" ToolTipService.ToolTip="启用 / 禁用时是否同时写入 Boot 存储（注册表 Overrides），重启后保持生效"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- 单一列表：浏览态 = 所选存储全量配置（按 ID 升序），搜索态 = 配置命中 + 字典补充 -->
                    <ListView x:Name="FeatureList" SelectionMode="None" ItemContainerStyle="{StaticResource FeatureItemContainer}" ItemTemplate="{StaticResource FeatureCardTemplate}" Grid.Row="3"/>
                    <!-- 空状态 / 无结果 -->
                    <Border x:Name="NoResultsPanel" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="24,16" Visibility="Collapsed" Grid.Row="3">
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE721;" FontSize="20" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="NoResultsText" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- 分批加载：每批 100 条（nexbox PAGE_SIZE） -->
                    <Button x:Name="LoadMoreButton" HorizontalAlignment="Center" Padding="16,8" CornerRadius="4" Click="LoadMoreButton_Click" Visibility="Collapsed" Grid.Row="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                            <TextBlock Text="加载更多" FontSize="14"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <!-- 使用说明 -->
                <Expander Header="使用说明" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Grid.Row="2">
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                        <StackPanel Spacing="8">
                            <TextBlock FontSize="14" FontWeight="SemiBold">
                                <Run Text="使用说明"/>
                                <Run Text="　"/>
                                <Run Text="(需求 Windows 10 1903+ 系统)" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" LineHeight="19">
                                <Run Text="· 总列表按功能 ID 升序分批展示（单次最多 500 条，点击「加载更多」继续），默认仅显示字典可识别名称的条目，可关闭「仅显示有名称」查看系统内部 servicing 配置；「运行时 / 引导」切换查看两种存储。"/>
                                <LineBreak/>
                                <Run Text="· 搜索按名称或数字 ID 匹配系统配置与内置功能字典（17000 条），字典命中但系统未配置的条目会以「未配置」状态一并展示，可直接启用。"/>
                                <LineBreak/>
                                <Run Text="· 「启用 / 禁用」写入 User 优先级（ViVeTool 同款）；「重启后保持生效」开启时同时写入 Boot 存储，关闭时仅本次开机有效；「重置」会删除该功能的全部自定义配置，恢复系统默认。部分功能需要重启才能生效。"/>
                                <LineBreak/>
                                <Run Text="· 实验性功能可能不稳定或引发系统异常，请按需开启、谨慎操作。"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Expander>
            </Grid>
        </Grid>
    </Grid>
</Page>
