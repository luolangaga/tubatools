<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TubaWinUi3.Pages.HandleCleanerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TubaWinUi3.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="using:WinUI3Localizer"
    xmlns:local="using:TubaWinUi3.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Page.Resources>
        <!-- 进程句柄排行行 -->
        <DataTemplate x:Key="ProcessRowTemplate" x:DataType="local:HandleCleanerProcessRow">
            <Grid ColumnSpacing="8" Padding="2,3" ToolTipService.ToolTip="{x:Bind ImagePath}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock FontSize="14" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Border
                        Padding="4,1"
                        Background="{x:Bind ProtectedBackground}"
                        CornerRadius="4"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ProtectedVisibility}">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{x:Bind ProtectedBrush}" Text="{x:Bind ProtectedText}" />
                    </Border>
                    <Border
                        Padding="4,1"
                        Background="{x:Bind LeakBackground}"
                        CornerRadius="4"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind LeakVisibility}">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{x:Bind LeakBrush}" Text="{x:Bind LeakText}" />
                    </Border>
                    <Border
                        Padding="4,1"
                        Background="{x:Bind CandidateBackground}"
                        CornerRadius="4"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind CandidateVisibility, Mode=OneWay}">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{x:Bind CandidateBrush}" Text="{x:Bind CandidateText, Mode=OneWay}" />
                    </Border>
                </StackPanel>

                <TextBlock
                    Grid.Column="1"
                    FontFamily="Consolas"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind PidText}"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="2"
                    FontFamily="Consolas"
                    FontSize="12"
                    HorizontalAlignment="Right"
                    Text="{x:Bind TotalText}"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="3"
                    FontFamily="Consolas"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Right"
                    Text="{x:Bind FileText}"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="4"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind TypesSummary}"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- 深度模式：解除占用结果行（按进程勾选） -->
        <DataTemplate x:Key="UnlockRowTemplate" x:DataType="local:HandleCleanerUnlockRow">
            <Grid Padding="2,3">
                <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}" MinWidth="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                    <StackPanel Spacing="2">
                        <TextBlock FontSize="14" Text="{x:Bind Title}" TextWrapping="Wrap" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind SamplePath}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </CheckBox>
            </Grid>
        </DataTemplate>

        <!-- 深度模式：句柄浏览器行 -->
        <DataTemplate x:Key="BrowseRowTemplate" x:DataType="local:HandleCleanerBrowseRow">
            <Grid ColumnSpacing="8" Padding="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    MinWidth="0"
                    VerticalAlignment="Center"
                    IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                    IsEnabled="{x:Bind CheckEnabled}" />
                <Border
                    Grid.Column="1"
                    Padding="4,0"
                    Background="{x:Bind RiskBackground}"
                    CornerRadius="4"
                    VerticalAlignment="Center">
                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{x:Bind RiskBrush}" Text="{x:Bind TypeLabel}" />
                </Border>
                <TextBlock
                    Grid.Column="2"
                    FontSize="12"
                    Text="{x:Bind NameText}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind NameText}"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="3"
                    FontFamily="Consolas"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind AccessText}"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="4"
                    FontFamily="Consolas"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind HandleText}"
                    VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:ToolPageHeader ToolId="handle-cleaner"
            Grid.Row="0"
            Title="句柄清理"
            Subtitle="安全清理失效文件句柄 · 句柄占用排行 · 缓解长期开机卡顿"
            Glyph="&#xE777;"
            BackRequested="PageHeader_BackRequested"
            l:Uids.Uid="HandleCleaner_PageHeader">
            <controls:ToolPageHeader.Actions>
                <Button x:Name="RefreshButton" Click="RefreshButton_Click" Style="{StaticResource ToolHeaderActionButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="12" Glyph="&#xE72C;" />
                        <TextBlock Text="重新扫描" l:Uids.Uid="HandleCleaner_RefreshButton" />
                    </StackPanel>
                </Button>
                <Button Click="HelpButton_Click" Style="{StaticResource ToolHeaderActionButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="12" Glyph="&#xE897;" />
                        <TextBlock Text="说明" l:Uids.Uid="HandleCleaner_HelpButton" />
                    </StackPanel>
                </Button>
            </controls:ToolPageHeader.Actions>
        </controls:ToolPageHeader>

        <Grid Grid.Row="1">
        <ScrollViewer
            x:Name="MainScroll"
            Padding="24,4,24,32"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" controls:ToolViewport.ConstrainContent="True">

            <StackPanel Spacing="24" MaxWidth="1120">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromHorizontalOffset="0" FromVerticalOffset="24" IsStaggeringEnabled="True" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>

                <!-- 使用模式 -->
                <Border Padding="16,12" Style="{StaticResource FluentCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Width="170" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="使用模式" l:Uids.Uid="HandleCleaner_ModeTitle" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="深度模式可关闭任意句柄，请谨慎使用"
                                TextWrapping="Wrap"
                                l:Uids.Uid="HandleCleaner_ModeHint" />
                        </StackPanel>
                        <RadioButtons x:Name="ModeRadios" Grid.Column="1" MaxColumns="2" SelectionChanged="ModeRadios_SelectionChanged">
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="安全模式" l:Uids.Uid="HandleCleaner_ModeSafe" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="只清理指向已删除文件的失效句柄，风险最低"
                                    TextWrapping="Wrap"
                                    l:Uids.Uid="HandleCleaner_ModeSafeDesc" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="深度模式" l:Uids.Uid="HandleCleaner_ModeDeep" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="任意句柄可查询 / 关闭 · 按路径强制解除占用"
                                    TextWrapping="Wrap"
                                    l:Uids.Uid="HandleCleaner_ModeDeepDesc" />
                            </StackPanel>
                        </RadioButtons>
                    </Grid>
                </Border>

                <!-- 未提权提示条（MSIX 版） -->
                <InfoBar x:Name="AdminBar" IsClosable="True" IsOpen="False" Severity="Warning">
                    <InfoBar.ActionButton>
                        <Button x:Name="RestartAsAdminBtn" Click="RestartAsAdmin_Click" Padding="12,5">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="12" Glyph="&#xE7EF;" />
                                <TextBlock Text="以管理员身份重新启动" l:Uids.Uid="HandleCleaner_AdminRestart" />
                                <ProgressRing x:Name="RestartAsAdminRing" Width="14" Height="14" IsActive="False" Visibility="Collapsed" />
                            </StackPanel>
                        </Button>
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- ═════════ 总览 ═════════ -->
                <Border Style="{StaticResource FluentCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource IconTileStyle}" Width="52" Height="52" VerticalAlignment="Top">
                            <FontIcon FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE777;" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="HeroTitle" FontSize="18" FontWeight="SemiBold" Text="正在读取系统句柄占用…" TextWrapping="Wrap" />
                                <ProgressRing x:Name="HeroRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock
                                x:Name="HeroDetail"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                Text="统计全系统句柄总数、各进程占用与疑似泄漏进程。" />

                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <StackPanel Spacing="1">
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="系统句柄总数" l:Uids.Uid="HandleCleaner_StatTotalLabel" />
                                    <TextBlock x:Name="StatTotalText" FontFamily="Consolas" FontSize="18" FontWeight="SemiBold" Text="--" />
                                </StackPanel>
                                <StackPanel Spacing="1">
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="进程数" l:Uids.Uid="HandleCleaner_StatProcessLabel" />
                                    <TextBlock x:Name="StatProcessText" FontFamily="Consolas" FontSize="18" FontWeight="SemiBold" Text="--" />
                                </StackPanel>
                                <StackPanel Spacing="1">
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="疑似泄漏进程" l:Uids.Uid="HandleCleaner_StatSuspectLabel" ToolTipService.ToolTip="句柄数超过 5 万的进程（红色为 20 万以上）" />
                                    <TextBlock x:Name="StatSuspectText" FontFamily="Consolas" FontSize="18" FontWeight="SemiBold" Text="--" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock x:Name="LastCleanText" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Text="还没有清理过" l:Uids.Uid="HandleCleaner_LastCleanNone" />
                        </StackPanel>

                        <StackPanel x:Name="HeroQuickCleanPanel" Grid.Column="2" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button
                                x:Name="QuickCleanButton"
                                Click="QuickClean_Click"
                                CornerRadius="4"
                                Padding="16,8"
                                Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="一键安全清理" l:Uids.Uid="HandleCleaner_QuickCleanButton" />
                                </StackPanel>
                            </Button>
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                HorizontalAlignment="Right"
                                MaxWidth="260"
                                Text="只关闭指向已删除文件的失效句柄，不碰其他类型句柄"
                                TextAlignment="Right"
                                TextWrapping="Wrap"
                                l:Uids.Uid="HandleCleaner_QuickCleanHint" />
                        </StackPanel>
                    </Grid>
                </Border>

                <InfoBar x:Name="ResultBar" IsClosable="True" IsOpen="False" />

                <!-- 扫描 / 清理进度 -->
                <StackPanel x:Name="ProgressPanel" Spacing="8" Visibility="Collapsed">
                    <ProgressBar x:Name="ScanProgressBar" IsIndeterminate="True" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="ProgressText"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="正在扫描…"
                            TextTrimming="CharacterEllipsis" />
                        <Button x:Name="CancelButton" Grid.Column="1" Click="CancelButton_Click" Padding="12,4" Visibility="Collapsed">
                            <TextBlock FontSize="12" Text="取消" l:Uids.Uid="HandleCleaner_CancelButton" />
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- ═════════ 深度模式（安全模式时隐藏） ═════════ -->
                <StackPanel x:Name="DeepPanel" Spacing="16" Visibility="Collapsed">
                    <InfoBar IsClosable="False" IsOpen="True" Severity="Warning" l:Uids.Uid="HandleCleaner_DeepWarning" />

                    <!-- 解除文件占用 -->
                    <Border Padding="16,12" Style="{StaticResource FluentCardStyle}">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="3" Height="16" CornerRadius="4" Background="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="解除文件占用" l:Uids.Uid="HandleCleaner_UnlockTitle" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    VerticalAlignment="Center"
                                    Text="强制关闭其他进程对指定路径的句柄——「删不掉 / 改不动」时使用"
                                    l:Uids.Uid="HandleCleaner_UnlockTagline" />
                            </StackPanel>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="UnlockPathBox" MinWidth="240" PlaceholderText="输入或选择要解除占用的文件 / 目录路径" l:Uids.Uid="HandleCleaner_UnlockPlaceholder" />
                                <Button x:Name="UnlockPickFileButton" Grid.Column="1" Click="UnlockPickFile_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="12" Glyph="&#xE8E5;" />
                                        <TextBlock Text="选择文件" l:Uids.Uid="HandleCleaner_UnlockPickFile" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="UnlockPickFolderButton" Grid.Column="2" Click="UnlockPickFolder_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="12" Glyph="&#xE8B7;" />
                                        <TextBlock Text="选择目录" l:Uids.Uid="HandleCleaner_UnlockPickFolder" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="UnlockScanButton" Grid.Column="3" Click="UnlockScan_Click" Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="12" Glyph="&#xE721;" />
                                        <TextBlock Text="扫描占用" l:Uids.Uid="HandleCleaner_UnlockScanButton" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <TextBlock x:Name="UnlockSummaryText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />

                            <ListView
                                x:Name="UnlockList"
                                ItemTemplate="{StaticResource UnlockRowTemplate}"
                                MaxHeight="280"
                                SelectionMode="None"
                                Visibility="Collapsed" />

                            <StackPanel x:Name="UnlockActionsPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                                <Button x:Name="UnlockCloseButton" Click="UnlockClose_Click" Padding="12,8" CornerRadius="4" Style="{StaticResource AccentButtonStyle}">
                                    <TextBlock x:Name="UnlockCloseButtonText" FontSize="14" FontWeight="SemiBold" Text="关闭选中句柄" />
                                </Button>
                                <Button x:Name="UnlockCloseDeleteButton" Click="UnlockCloseDelete_Click" Padding="12,8" CornerRadius="4">
                                    <TextBlock FontSize="14" Text="关闭并尝试删除" l:Uids.Uid="HandleCleaner_UnlockCloseDelete" />
                                </Button>
                            </StackPanel>

                            <InfoBar x:Name="UnlockBar" IsClosable="True" IsOpen="False" />
                        </StackPanel>
                    </Border>

                    <!-- 浏览器入口提示 -->
                    <Border Padding="16,12" Style="{StaticResource FluentCardStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE8A5;" VerticalAlignment="Center" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center"
                                Text="在下方「进程句柄排行」点击任意进程 → 打开句柄浏览器：查看该进程的全部句柄（类型 / 对象名 / 访问权限 / 风险），勾选后可强制关闭。"
                                l:Uids.Uid="HandleCleaner_BrowserTip" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═════════ 进程句柄排行 ═════════ -->
                <Border Padding="16,12" Style="{StaticResource FluentCardStyle}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Width="3" Height="16" CornerRadius="4" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="进程句柄排行" l:Uids.Uid="HandleCleaner_RankingTitle" />
                                <TextBlock x:Name="RankingSummaryText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <AutoSuggestBox
                                x:Name="SearchBox"
                                Grid.Column="1"
                                MinWidth="230"
                                PlaceholderText="搜索进程名或 PID"
                                QueryIcon="Find"
                                l:Uids.Uid="HandleCleaner_RankingSearchPlaceholder"
                                TextChanged="SearchBox_TextChanged"
                                QuerySubmitted="SearchBox_QuerySubmitted" />
                        </Grid>

                        <!-- 列标题 -->
                        <Border Padding="12,4" CornerRadius="8,8,0,0">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="12" FontWeight="SemiBold" Text="进程" l:Uids.Uid="HandleCleaner_ColProcess" />
                                <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Text="PID" l:Uids.Uid="HandleCleaner_ColPid" />
                                <TextBlock Grid.Column="2" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Text="句柄总数" l:Uids.Uid="HandleCleaner_ColTotal" />
                                <TextBlock Grid.Column="3" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Text="文件句柄" l:Uids.Uid="HandleCleaner_ColFile" />
                                <TextBlock Grid.Column="4" FontSize="12" FontWeight="SemiBold" Text="主要类型" l:Uids.Uid="HandleCleaner_ColTypes" />
                            </Grid>
                        </Border>

                        <ListView
                            x:Name="ProcessList"
                            ItemTemplate="{StaticResource ProcessRowTemplate}"
                            ItemClick="ProcessList_ItemClick"
                            IsItemClickEnabled="True"
                            MaxHeight="430"
                            SelectionMode="None" />

                        <StackPanel x:Name="RankingEmptyPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                            <FontIcon FontSize="14" Glyph="&#xE946;" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            <TextBlock FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="没有匹配的进程" l:Uids.Uid="HandleCleaner_SearchEmpty" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock
                            x:Name="RankingHint"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="点任意一行查看句柄类型分布，并可单独清理该进程的失效句柄。"
                            l:Uids.Uid="HandleCleaner_RankingHint"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- ═════════ 快速动作 ═════════ -->
                <Border Padding="16,12" Style="{StaticResource FluentCardStyle}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Width="3" Height="16" CornerRadius="4" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="快速动作" l:Uids.Uid="HandleCleaner_QuickActionsTitle" />
                        </StackPanel>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="重启资源管理器" l:Uids.Uid="HandleCleaner_RestartExplorerButton" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    Text="资源管理器是句柄泄漏的常客；重启外壳可立即释放它占用的全部句柄（桌面与任务栏会短暂消失后恢复）。"
                                    l:Uids.Uid="HandleCleaner_RestartExplorerDesc" />
                            </StackPanel>
                            <Button x:Name="RestartExplorerButton" Grid.Column="1" Click="RestartExplorer_Click" Padding="12,8" CornerRadius="4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="12" Glyph="&#xE72C;" />
                                    <TextBlock FontSize="14" Text="重启资源管理器" l:Uids.Uid="HandleCleaner_RestartExplorerButton2" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="复制诊断报告" l:Uids.Uid="HandleCleaner_CopyReportButton" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    Text="把句柄总数、进程排行、失效句柄统计与运行环境整理成文本，方便粘贴给他人排查。"
                                    l:Uids.Uid="HandleCleaner_CopyReportDesc" />
                            </StackPanel>
                            <Button x:Name="CopyReportButton" Grid.Column="1" Click="CopyReport_Click" Padding="12,8" CornerRadius="4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                                    <TextBlock FontSize="14" Text="复制报告" l:Uids.Uid="HandleCleaner_CopyReportButton2" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═════════ 原理解释 ═════════ -->
                <Border Padding="16,12" Style="{StaticResource FluentCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="为什么清理句柄能缓解卡顿？" l:Uids.Uid="HandleCleaner_ExplainTitle" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            LineHeight="19"
                            TextWrapping="Wrap">
                            <Run Text="· 每打开一个文件、事件、注册表项，系统都会记账一个「句柄」；程序忘记归还（泄漏）时，句柄会一直占着内核资源。" l:Uids.Uid="HandleCleaner_Explain1" />
                            <LineBreak />
                            <Run Text="· 长期开机后句柄越积越多；系统句柄表接近上限时，整个系统的文件与网络操作都会开始卡顿。" l:Uids.Uid="HandleCleaner_Explain2" />
                            <LineBreak />
                            <Run Text="· 本工具只清理「指向已删除文件」的失效句柄——文件已经不会回来，清理安全且立竿见影；其他类型句柄一律不碰。" l:Uids.Uid="HandleCleaner_Explain3" />
                            <LineBreak />
                            <Run Text="· 清理前会重新校验（进程身份 + 句柄仍失效），并跳过系统关键进程；建议清理后重启长期累积句柄的程序。" l:Uids.Uid="HandleCleaner_Explain4" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ═════════ 句柄浏览器（深度模式整页视图） ═════════ -->
        <Grid x:Name="BrowserView" Padding="24,4,24,32" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 头部 -->
            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BrowserBackButton" Click="BrowserBack_Click" Style="{StaticResource ToolHeaderActionButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="12" Glyph="&#xE72B;" />
                        <TextBlock FontSize="14" Text="返回" l:Uids.Uid="HandleCleaner_BrowserBack" />
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="BrowserTitleText" FontSize="18" FontWeight="SemiBold" Text="句柄浏览器" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="BrowserSubtitleText" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button x:Name="BrowserRefreshButton" Grid.Column="2" Click="BrowserRefresh_Click" Style="{StaticResource ToolHeaderActionButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="12" Glyph="&#xE72C;" />
                        <TextBlock FontSize="14" Text="刷新" l:Uids.Uid="HandleCleaner_BrowserRefresh" />
                    </StackPanel>
                </Button>
                <Button x:Name="BrowserCopyButton" Grid.Column="3" Click="BrowserCopy_Click" Style="{StaticResource ToolHeaderActionButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                        <TextBlock FontSize="14" Text="复制列表" l:Uids.Uid="HandleCleaner_BrowserCopy" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 风险提示 -->
            <TextBlock
                x:Name="BrowserHintText"
                Grid.Row="1"
                Margin="0,8,0,0"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                TextWrapping="Wrap"
                Text="勾选要关闭的句柄。关闭任意句柄都可能影响目标程序（报错 / 卡死），请谨慎操作；系统关键进程仅可查看。"
                l:Uids.Uid="HandleCleaner_BrowserHint" />

            <!-- 工具栏 -->
            <Grid Grid.Row="2" Margin="0,8,0,8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="BrowserTypeCombo" MinWidth="190" DisplayMemberPath="Display" SelectionChanged="BrowserTypeCombo_SelectionChanged" />
                <AutoSuggestBox
                    x:Name="BrowserSearchBox"
                    Grid.Column="1"
                    MinWidth="200"
                    PlaceholderText="搜索对象名 / 句柄值"
                    QueryIcon="Find"
                    l:Uids.Uid="HandleCleaner_BrowserSearch"
                    TextChanged="BrowserSearchBox_TextChanged"
                    QuerySubmitted="BrowserSearchBox_QuerySubmitted" />
                <CheckBox
                    x:Name="BrowserDeletedOnly"
                    Grid.Column="2"
                    MinWidth="0"
                    Checked="BrowserDeletedOnly_Changed"
                    Content="只看已删除文件（低风险）"
                    l:Uids.Uid="HandleCleaner_BrowserDeletedOnly"
                    Unchecked="BrowserDeletedOnly_Changed" />
                <Button x:Name="BrowserSelectAllButton" Grid.Column="3" Click="BrowserSelectAll_Click" Padding="12,5">
                    <TextBlock FontSize="12" Text="全选当前结果" l:Uids.Uid="HandleCleaner_BrowserSelectAll" />
                </Button>
                <Button x:Name="BrowserClearButton" Grid.Column="4" Click="BrowserClear_Click" Padding="12,5">
                    <TextBlock FontSize="12" Text="清除选择" l:Uids.Uid="HandleCleaner_BrowserClear" />
                </Button>
                <TextBlock x:Name="BrowserCountText" Grid.Column="5" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
            </Grid>

            <!-- 列表 -->
            <Grid Grid.Row="3">
                <ListView x:Name="BrowserList" ItemTemplate="{StaticResource BrowseRowTemplate}" SelectionMode="None" />
                <StackPanel x:Name="BrowserLoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
                    <ProgressRing x:Name="BrowserLoadingRing" Width="36" Height="36" IsActive="True" />
                    <TextBlock x:Name="BrowserLoadingText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="正在读取句柄…" />
                </StackPanel>
                <TextBlock
                    x:Name="BrowserEmptyText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="没有匹配的句柄"
                    l:Uids.Uid="HandleCleaner_BrowserEmpty"
                    Visibility="Collapsed" />
            </Grid>

            <!-- 底部操作 -->
            <Grid Grid.Row="4" Margin="0,8,0,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BrowserCloseSelectedButton" Click="BrowserCloseSelected_Click" Padding="16,8" CornerRadius="4" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="12" Glyph="&#xE74D;" />
                        <TextBlock x:Name="BrowserCloseSelectedText" FontSize="14" FontWeight="SemiBold" Text="关闭选中" />
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressRing x:Name="BrowserBusyRing" Width="14" Height="14" IsActive="False" Visibility="Collapsed" />
                    <TextBlock x:Name="BrowserStatusText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Grid>
        </Grid>
    </Grid>
</Page>
