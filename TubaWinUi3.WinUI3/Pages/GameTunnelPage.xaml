<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TubaWinUi3.Pages.GameTunnelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TubaWinUi3.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TubaWinUi3.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:ToolPageHeader ToolId="game-tunnel"
            Grid.Row="0"
            Title="游戏联机助手"
            Subtitle="把两台电脑接进同一个虚拟局域网 · 我的世界 / 泰拉瑞亚 / 帕鲁，不开路由器也能一起玩"
            Glyph="&#xE774;">
            <controls:ToolPageHeader.Actions>
                <Button x:Name="DiagnosticsButton" Click="Diagnostics_Click" Style="{StaticResource ToolHeaderActionButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="12" Glyph="&#xE9D9;" />
                        <TextBlock Text="网络检测" />
                    </StackPanel>
                </Button>
                <Button x:Name="HelpButton" Click="Help_Click" Style="{StaticResource ToolHeaderActionButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="12" Glyph="&#xE897;" />
                        <TextBlock Text="教程" />
                    </StackPanel>
                </Button>
            </controls:ToolPageHeader.Actions>
        </controls:ToolPageHeader>

        <ScrollViewer
            Grid.Row="1"
            Padding="24,4,24,32"
            HorizontalScrollMode="Disabled"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" controls:ToolViewport.ConstrainContent="True">

            <StackPanel Spacing="12" MaxWidth="1120">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromHorizontalOffset="0" FromVerticalOffset="24" IsStaggeringEnabled="True" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>

                <!-- ═════════ 联机环境：我的地址 + 网里有谁 ═════════ -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="StatusIconTile" Width="52" Height="52" CornerRadius="8" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" VerticalAlignment="Top">
                            <FontIcon x:Name="StatusIcon" FontSize="24" Glyph="&#xE9F5;" Foreground="{ThemeResource SystemFillColorSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusTitle" Style="{StaticResource CardTitleStyle}" Text="正在检查联机环境…" />
                            <TextBlock x:Name="StatusDetail" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <StackPanel x:Name="AddressRow" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                                <TextBlock x:Name="MyAddressText" Style="{StaticResource StatValueStyle}" FontFamily="Consolas" IsTextSelectionEnabled="True" VerticalAlignment="Center" />
                                <Button x:Name="CopyAddressButton" Click="CopyAddress_Click" Padding="8,4" CornerRadius="4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                                        <TextBlock FontSize="12" Text="复制" />
                                    </StackPanel>
                                </Button>
                                <Border x:Name="LiveBadge" Style="{StaticResource StatusPillStyle}" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" VerticalAlignment="Center" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Ellipse Width="6" Height="6" Fill="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="游戏正在监听端口" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="PeerLine" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                            <TextBlock
                                x:Name="TrayHint"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed"
                                Text="想关掉联机时：右键系统托盘（任务栏右下角）的 Tailscale 图标选 Disconnect；要从后台彻底退出就选 Exit。" />
                        </StackPanel>

                        <Button
                            x:Name="PrepareButton"
                            Grid.Column="2"
                            Click="Prepare_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            Padding="16,8"
                            CornerRadius="4"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE896;" />
                                <TextBlock x:Name="PrepareButtonText" FontSize="14" FontWeight="SemiBold" Text="准备联机环境" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <InfoBar x:Name="HealthBar" IsOpen="False" IsClosable="True" Severity="Warning" />

                <!-- ═════════ 和朋友连起来 ═════════ -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="HostCard"
                        Style="{StaticResource FluentCardStyle}">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Style="{StaticResource IconTileStyle}">
                                    <FontIcon FontSize="18" Glyph="&#xE7FC;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="我当主机，邀请朋友" />
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="游戏跑在我这台，朋友一键进来" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                Text="选一个游戏 → 把邀请码发给朋友 → 他进的是同一个虚拟局域网，并拿到你的联机地址。端口和游戏里的操作都会自动准备好。" />
                            <Button x:Name="StartHostButton" Click="StartHost_Click" Style="{StaticResource AccentButtonStyle}" CornerRadius="4" Padding="0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Text="选择游戏并邀请" />
                            </Button>
                            <Button
                                x:Name="CurrentInviteButton"
                                Click="ShowCurrentInvite_Click"
                                CornerRadius="4"
                                Padding="0,8"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon x:Name="CurrentInviteIcon" FontSize="12" Glyph="&#xE8F1;" />
                                    <ProgressRing x:Name="CurrentInviteRing" Width="12" Height="12" IsActive="False" Visibility="Collapsed" />
                                    <TextBlock x:Name="CurrentInviteText" FontSize="12" Text="查看当前邀请信息" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="1"
                        x:Name="JoinCard"
                        Style="{StaticResource FluentCardStyle}">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Style="{StaticResource IconTileStyle}">
                                    <FontIcon FontSize="18" Glyph="&#xE8F1;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="我加入朋友" />
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="朋友当主机，我进他的虚拟网络" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                Text="粘贴朋友发来的邀请码（连说明文字一起粘也行），没装 Tailscale 也会自动装好；进网络后照游戏卡上的端口，在游戏里用「通过 IP 加入」连他。" />
                            <Button x:Name="StartJoinButton" Click="StartJoin_Click" CornerRadius="4" Padding="0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Text="粘贴邀请码加入" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ═════════ 我要玩的游戏（端口速查 + 一键邀请） ═════════ -->
                <StackPanel x:Name="GamesSection" Spacing="8">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Width="3" Height="16" CornerRadius="4" Background="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="我要玩的游戏" />
                        </StackPanel>
                        <TextBlock
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="点一下 = 选好端口并进入邀请流程" />
                    </Grid>

                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Auto"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled">
                        <ItemsControl x:Name="GamesList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:TunnelGameCard">
                                    <Button
                                        Click="GameChip_Click"
                                        Tag="{x:Bind Self}"
                                        Padding="0"
                                        CornerRadius="4"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                        <StackPanel Width="122" Padding="12,8" Spacing="8">
                                            <Grid Height="34">
                                                <FontIcon
                                                    FontSize="16"
                                                    Glyph="{x:Bind Glyph}"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />
                                                <Image Source="{x:Bind Logo, Mode=OneWay}" Stretch="Uniform" />
                                            </Grid>
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Name}"
                                                MaxLines="1"
                                                TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind PortText}" />
                                                <Border
                                                    Style="{StaticResource StatusPillStyle}"
                                                    Padding="4,0"
                                                    Visibility="{x:Bind HasProtocolBadge}">
                                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ProtocolBadge}" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- ═════════ 原理与说明 ═════════ -->
                <Border
                    Style="{StaticResource FluentCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="它是怎么把两台电脑连起来的？" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap">
                            <Run Text="· Tailscale 把两台电脑接进同一个虚拟局域网：每台有一个 100 开头的固定地址，TCP / UDP 游戏都能跑，不用公网 IP、不用改路由器。" />
                            <LineBreak />
                            <Run Text="· 这个虚拟网络是「三层」的：局域网组播和子网广播跨不过去，所以能不能自动刷出对方的房间取决于游戏怎么找主机——刷不出来时，在游戏里选「直接连接 / 通过 IP 加入」填地址和端口，这一步任何游戏都有效。" />
                            <LineBreak />
                            <Run Text="· 打洞成功时是点对点直连（延迟接近直连），打洞失败会自动走加密中继，能玩但延迟略高——想看自己属于哪种，点右上角「网络检测」。" />
                            <LineBreak />
                            <Run Text="· 少数游戏的联机走平台自己的通道（例如 Steam 好友邀请），不受上面这条限制。" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
