                                    </StackPanel>
                                </toolkit:SettingsCard.Header>
                                <toolkit:SettingsCard.HeaderIcon>
                                    <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" Glyph=""/>
                                </toolkit:SettingsCard.HeaderIcon>
                                <Button VerticalAlignment="Center" Click="ThrowErrorButton_Click" Content="抛出异常" l:Uids.Uid="Settings_TestError_Button"/>
