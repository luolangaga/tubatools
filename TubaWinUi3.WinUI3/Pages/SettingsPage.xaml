                                    </StackPanel>
                                </toolkit:SettingsCard.Header>
                                <toolkit:SettingsCard.HeaderIcon>
                                    <FontIcon FontSize="18" Glyph=""/>
                                </toolkit:SettingsCard.HeaderIcon>
                                <Button x:Name="CommunitySubmitButton" VerticalAlignment="Center" Padding="12,8" Click="CommunitySubmitButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="12" Glyph=""/>
                                        <TextBlock Text="提交工具" l:Uids.Uid="Settings_CommunitySubmit_Button" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Button>
                            </toolkit:SettingsCard>
                        </Border>
                        <Border x:Name="SettingsFeedbackCard" Style="{StaticResource SettingsRowSurface}">
                            <toolkit:SettingsCard HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" MinHeight="76">
                                <toolkit:SettingsCard.Header>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource SettingsRowTitle}" Text="反馈与建议" l:Uids.Uid="Settings_Feedback_Title" TextWrapping="Wrap"/>
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Text="在 GitHub 上提交问题、功能建议或反馈" l:Uids.Uid="Settings_Feedback_Desc"/>
                                    </StackPanel>
                                </toolkit:SettingsCard.Header>
                                <toolkit:SettingsCard.HeaderIcon>
                                    <FontIcon FontSize="18" Glyph=""/>
                                </toolkit:SettingsCard.HeaderIcon>
                                <Button x:Name="FeedbackButton" VerticalAlignment="Center" Padding="12,8" Click="FeedbackButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="12" Glyph=""/>
                                        <TextBlock Text="提交反馈" l:Uids.Uid="Settings_Feedback_Button" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Button>
                            </toolkit:SettingsCard>
                        </Border>
                    </StackPanel>
                    <StackPanel Spacing="4" Margin="0,0,0,28" x:Name="CreditsExpander">
                        <TextBlock Text="关于与鸣谢" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" AutomationProperties.HeadingLevel="Level2" l:Uids.Uid="Settings_GroupAbout" TextWrapping="Wrap"/>
