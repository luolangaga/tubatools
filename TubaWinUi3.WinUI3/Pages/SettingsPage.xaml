                                <toolkit:SettingsCard Header="项目仓库" IsClickEnabled="True" Click="SettingsRepository_Click" MinHeight="60" l:Uids.Uid="Settings_AboutRepository">
                                    <TextBlock Text="github.com/luolangaga/tubatool" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </toolkit:SettingsCard>
                                <toolkit:SettingsCard Header="报告问题或提出建议" IsClickEnabled="True" Click="FeedbackButton_Click" MinHeight="60" l:Uids.Uid="Settings_AboutFeedback"/>
