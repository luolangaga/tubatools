                                <toolkit:SettingsCard.Header>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource SettingsRowTitle}" Text="喜欢我们的软件吗？" l:Uids.Uid="Settings_StoreRating_Title" TextWrapping="Wrap"/>
