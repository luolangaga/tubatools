                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="12" Glyph=""/>
                                            <TextBlock Text="登录" l:Uids.Uid="Settings_GitHub_LoginButton" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="GitHubLogoutButton" Padding="12,8" Click="GitHubLogoutButton_Click" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="12" Glyph=""/>
                                            <TextBlock Text="登出" l:Uids.Uid="Settings_GitHub_LogoutButton" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </toolkit:SettingsCard>
                        </Border>
                        <Border x:Name="SettingsCommunitySubmitCard" Style="{StaticResource SettingsRowSurface}">
                            <toolkit:SettingsCard HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" MinHeight="76">
