                                    <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/luolangaga"/>
                                </toolkit:SettingsCard>
                                <toolkit:SettingsCard Header="工具来源" Description="硬件检测与测试工具来源于图吧工具箱项目。" MinHeight="60" l:Uids.Uid="Settings_AboutSource">
                                    <HyperlinkButton Content="访问官网" NavigateUri="https://www.tbtool.cn" l:Uids.Uid="Settings_Credits_VisitSite"/>
                                </toolkit:SettingsCard>
                                <toolkit:SettingsCard Header="特别鸣谢" Description="新境盒 NexBox" MinHeight="60" l:Uids.Uid="Settings_AboutThanks">
                                    <HyperlinkButton Content="访问官网" NavigateUri="https://nexbox.top" l:Uids.Uid="Settings_Credits_VisitSite"/>
                                </toolkit:SettingsCard>
                                <toolkit:SettingsCard HorizontalContentAlignment="Stretch" Padding="0" MinHeight="0" ContentAlignment="Vertical">
                                    <Border Padding="58,12,16,16">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="开源引用" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" l:Uids.Uid="Settings_OpenSource_Title"/>
                                            <HyperlinkButton Content="Windows App SDK (WinUI 3)" NavigateUri="https://github.com/microsoft/WindowsAppSDK" Padding="0,4" HorizontalAlignment="Left"/>
                                            <HyperlinkButton Content="Win2D" NavigateUri="https://github.com/microsoft/Win2D" Padding="0,4" HorizontalAlignment="Left"/>
                                            <HyperlinkButton Content="LibreHardwareMonitorLib" NavigateUri="https://github.com/LibreHardwareMonitor/LibreHardwareMonitor" Padding="0,4" HorizontalAlignment="Left"/>
                                            <HyperlinkButton Content="System.Drawing.Common" NavigateUri="https://learn.microsoft.com/dotnet/core/compatibility/core-libraries/6.0/system-drawing-common-windows-only" Padding="0,4" HorizontalAlignment="Left"/>
                                            <HyperlinkButton Content="System.Management" NavigateUri="https://learn.microsoft.com/dotnet/api/system.management" Padding="0,4" HorizontalAlignment="Left"/>
                                            <HyperlinkButton Content="System.Diagnostics.EventLog" NavigateUri="https://learn.microsoft.com/dotnet/api/system.diagnostics.eventlog" Padding="0,4" HorizontalAlignment="Left"/>
                                            <HyperlinkButton Content="Microsoft.Windows.SDK.BuildTools" NavigateUri="https://www.nuget.org/packages/Microsoft.Windows.SDK.BuildTools" Padding="0,4" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>
                                </toolkit:SettingsCard>
                            </toolkit:SettingsExpander.Items>
                        </toolkit:SettingsExpander>
                    </StackPanel>
                </StackPanel>
            </RelativePanel>
        </ScrollViewer>
        <Grid x:Name="RatingThanksOverlay" Visibility="Collapsed">
            <Border x:Name="RatingThanksScrim" Background="{ThemeResource SmokeFillColorDefaultBrush}" Opacity="0" Tapped="RatingThanksScrim_Tapped"/>
            <Border x:Name="RatingThanksCard" Width="360" Padding="24,32,24,24" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Opacity="0" RenderTransformOrigin="0.5,0.5" Translation="0,0,32">
                <Border.Shadow>
                    <ThemeShadow/>
                </Border.Shadow>
                <Border.RenderTransform>
                    <CompositeTransform x:Name="RatingThanksCardTransform" ScaleX="0.88" ScaleY="0.88" TranslateY="16"/>
                </Border.RenderTransform>
                <StackPanel Spacing="16" HorizontalAlignment="Stretch">
                    <Grid Width="136" Height="136" HorizontalAlignment="Center">
                        <Ellipse x:Name="RatingThanksHalo" Width="136" Height="136" Opacity="0" Fill="{ThemeResource SystemFillColorCautionBackgroundBrush}"/>
                        <Ellipse x:Name="RatingThanksRing1" Width="104" Height="104" Opacity="0" RenderTransformOrigin="0.5,0.5" Stroke="{ThemeResource SystemFillColorCautionBrush}" StrokeThickness="2">
                            <Ellipse.RenderTransform>
                                <CompositeTransform x:Name="RatingThanksRing1Transform" ScaleX="0.4" ScaleY="0.4"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="RatingThanksRing2" Width="104" Height="104" Opacity="0" RenderTransformOrigin="0.5,0.5" Stroke="{ThemeResource SystemFillColorCautionBrush}" StrokeThickness="1.5">
                            <Ellipse.RenderTransform>
                                <CompositeTransform x:Name="RatingThanksRing2Transform" ScaleX="0.4" ScaleY="0.4"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Border x:Name="RatingThanksBadge" Width="104" Height="104" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" BorderBrush="{ThemeResource SystemFillColorCautionBrush}" BorderThickness="1" CornerRadius="12" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <CompositeTransform x:Name="RatingThanksBadgeTransform" Rotation="-80" ScaleX="0.3" ScaleY="0.3"/>
                            </Border.RenderTransform>
                            <Path Width="60" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 50,2 L 61.76,33.82 L 95.66,35.17 L 69.02,56.18 L 78.21,88.83 L 50,70 L 21.79,88.83 L 30.98,56.18 L 4.34,35.17 L 38.24,33.82 Z" Fill="{ThemeResource SystemFillColorCautionBrush}" Stretch="Uniform"/>
                        </Border>
                    </Grid>
                    <TextBlock HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="感谢你的支持！" l:Uids.Uid="Settings_RatingThanks_Title"/>
                    <TextBlock HorizontalAlignment="Center" MaxWidth="296" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Text="你的每一份评价，都会让图吧工具箱变得更好。" l:Uids.Uid="Settings_RatingThanks_Desc"/>
                    <Button x:Name="RatingThanksCloseButton" MinWidth="136" Margin="0,8,0,0" HorizontalAlignment="Center" Click="RatingThanksCloseButton_Click" Content="太棒了" l:Uids.Uid="Settings_RatingThanks_Button" Style="{StaticResource AccentButtonStyle}"/>
                </StackPanel>
            </Border>
            <Canvas x:Name="RatingThanksParticleCanvas" IsHitTestVisible="False"/>
        </Grid>
    </Grid>
