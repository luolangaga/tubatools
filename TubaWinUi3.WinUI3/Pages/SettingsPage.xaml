                                        <TextBlock Text="去好评" l:Uids.Uid="Settings_StoreRating_Button" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Button>
                            </toolkit:SettingsCard>
                        </Border>
                        <Border x:Name="SettingsCommunityCard" Style="{StaticResource SettingsRowSurface}">
                            <toolkit:SettingsCard HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" MinHeight="76">
                                <toolkit:SettingsCard.Header>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource SettingsRowTitle}" Text="GitHub 账号" l:Uids.Uid="Settings_GitHub_Title" TextWrapping="Wrap"/>
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" x:Name="GitHubLoginStatusText" FontSize="12" TextWrapping="Wrap" Text="未登录" l:Uids.Uid="Settings_GitHub_Status"/>
