                            <toolkit:SettingsExpander.Header>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="图吧工具箱CE" Style="{StaticResource BodyStrongTextBlockStyle}" l:Uids.Uid="Settings_AppTitle"/>
                                    <TextBlock Text="开源的 PC 硬件与实用工具集合" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" l:Uids.Uid="Settings_AboutSummary"/>
                                </StackPanel>
                            </toolkit:SettingsExpander.Header>
                            <toolkit:SettingsExpander.HeaderIcon>
                                <ImageIcon Source="ms-appx:///Assets/Square44x44Logo.targetsize-48_altform-unplated.png"/>
                            </toolkit:SettingsExpander.HeaderIcon>
                            <toolkit:SettingsExpander.Content>
                                <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" x:Name="AboutVersionText"/>
                            </toolkit:SettingsExpander.Content>
