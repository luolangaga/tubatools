<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TubaWinUi3.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="using:WinUI3Localizer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Page.Resources>
        <Storyboard x:Name="DrawerOpenStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="DrawerOverlayBackground"
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:0.2" />
            <DoubleAnimation
                Storyboard.TargetName="DrawerPanelTransform"
                Storyboard.TargetProperty="X"
                From="420"
                To="0"
                Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Name="DrawerCloseStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="DrawerOverlayBackground"
                Storyboard.TargetProperty="Opacity"
                From="1"
                To="0"
                Duration="0:0:0.15" />
            <DoubleAnimation
                Storyboard.TargetName="DrawerPanelTransform"
                Storyboard.TargetProperty="X"
                From="0"
                To="420"
                Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Grid Background="Transparent">
        <ScrollViewer
            x:Name="RootScrollViewer"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <RelativePanel HorizontalAlignment="Stretch">
                <StackPanel
                    x:Name="ContentPanel"
                    RelativePanel.AlignHorizontalCenterWithPanel="True"
                    RelativePanel.AlignLeftWithPanel="True"
                    RelativePanel.AlignRightWithPanel="True"
                    MaxWidth="1000"
                    Spacing="4"
                    Padding="40,28,40,48">
                    <StackPanel.Transitions>
                        <TransitionCollection>
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </StackPanel.Transitions>

                    <TextBlock
                        FontSize="28"
                        FontWeight="Bold"
                        Text="设置"
                        l:Uids.Uid="Settings_PageTitle" />
                    <TextBlock
                        Opacity="1.0"
                        Margin="0,0,0,16"
                        Text="管理应用外观、更新及查看关于信息。"
                        l:Uids.Uid="Settings_PageSubtitle" />

                    <Border x:Name="SettingsStoreRatingCard" Style="{StaticResource SettingsCardStyle}" Visibility="Collapsed">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconBorderStyle}">
                                <FontIcon FontSize="18" Glyph="&#xE734;" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock FontWeight="Bold" Text="喜欢我们的软件吗？" l:Uids.Uid="Settings_StoreRating_Title" />
                                <TextBlock Opacity="1.0" FontSize="13" TextWrapping="Wrap" Text="给一个好评吧！点击直接打开商店评分" l:Uids.Uid="Settings_StoreRating_Desc" />
                            </StackPanel>
                            <Button x:Name="StoreRatingButton" Grid.Column="2" VerticalAlignment="Center" Padding="14,6" Style="{StaticResource AccentButtonStyle}" Click="StoreRatingButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="&#xE734;" />
                                    <TextBlock Text="去好评" l:Uids.Uid="Settings_StoreRating_Button" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <Border
                        x:Name="AppInfoCard"
                        Style="{StaticResource SettingsCardStyle}"
                        Tapped="AppInfoCard_Tapped"
                        RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="AppInfoCardScale" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Image
                                x:Name="AppIconImage"
                                Width="56"
                                Height="56"
                                Stretch="UniformToFill" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    x:Name="AppTitleText"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Text="图吧工具箱CE"
                                    l:Uids.Uid="Settings_AppTitle" />
                                <TextBlock
                                    x:Name="AppSubtitleText"
                                    Opacity="1.0"
                                    Text="基于 WinUI 3 构建的 PC 硬件工具集合"
                                    l:Uids.Uid="Settings_AppSubtitle" />
                                <TextBlock
                                    x:Name="VersionText"
                                    Opacity="1.0"
                                    FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Expander
                        x:Name="GeneralExpander"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                         IsExpanded="True">
                         <Expander.Header>
                             <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,8" MinHeight="56">
                                 <Border Style="{StaticResource NavCardIconBorderStyle}">
                                     <FontIcon FontSize="20" Glyph="&#xE80F;" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                 </Border>
                                 <StackPanel VerticalAlignment="Center" Spacing="2">
                                     <TextBlock FontWeight="Bold" Text="常规" l:Uids.Uid="Settings_General_Title" />
                                    <TextBlock Opacity="1.0" FontSize="13" Text="主题、更新、启动页面、快速模式" l:Uids.Uid="Settings_General_Desc" />
                                </StackPanel>
                            </StackPanel>
                        </Expander.Header>
                        <Expander.Content>
                            <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                            <StackPanel Spacing="2" Padding="0,4,0,0">

                                <Border x:Name="SettingsUpdateCard" Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconBorderStyle}">
                                            <FontIcon FontSize="18" Glyph="&#xE777;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock FontWeight="Bold" Text="检查更新" l:Uids.Uid="Settings_Update_Title" />
                                            <TextBlock x:Name="UpdateStatusText" Opacity="1.0" FontSize="13" Text="点击检查是否有新版本" l:Uids.Uid="Settings_Update_Status" />
                                        </StackPanel>
                                        <Button x:Name="CheckUpdateButton" Grid.Column="2" VerticalAlignment="Center" Padding="14,6" Click="CheckUpdateButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontSize="12" Glyph="&#xE777;" />
                                                <TextBlock Text="检查更新" l:Uids.Uid="Settings_Update_Button" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <Border x:Name="SettingsToolsBundleCard" Style="{StaticResource SettingsCardStyle}" Visibility="Collapsed">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconBorderStyle}">
                                            <FontIcon FontSize="18" Glyph="&#xE896;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock FontWeight="Bold" Text="内核更新" l:Uids.Uid="Settings_ToolsBundle_Title" />
                                            <TextBlock x:Name="ToolsBundleStatusText" Opacity="1.0" FontSize="13" Text="点击检查内核是否有新版本" l:Uids.Uid="Settings_ToolsBundle_Status" />
                                        </StackPanel>
                                        <Button x:Name="CheckToolsBundleButton" Grid.Column="2" VerticalAlignment="Center" Padding="14,6" Click="CheckToolsBundleButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontSize="12" Glyph="&#xE896;" />
                                                <TextBlock Text="检查更新" l:Uids.Uid="Settings_ToolsBundle_Button" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <Border x:Name="SettingsLanguageCard" Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconBorderStyle}">
                                            <FontIcon FontSize="18" Glyph="&#xE774;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock FontWeight="Bold" Text="界面语言" l:Uids.Uid="Settings_LanguageTitle" />
                                            <TextBlock Opacity="1.0" FontSize="13" TextWrapping="Wrap" Text="选择应用的显示语言" l:Uids.Uid="Settings_LanguageDesc" />
                                        </StackPanel>
                                        <ComboBox x:Name="LanguageComboBox" Grid.Column="2" MinWidth="120" SelectionChanged="LanguageComboBox_SelectionChanged" />
                                    </Grid>
                                </Border>

                                <Border x:Name="SettingsCompactModeCard" Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconBorderStyle}">
                                            <FontIcon FontSize="18" Glyph="&#xE8FD;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock FontWeight="Bold" Text="简洁列表模式" l:Uids.Uid="Settings_Compact_Title" />
                                            <TextBlock Opacity="1.0" FontSize="13" TextWrapping="Wrap" Text="原版图吧工具箱的样式" l:Uids.Uid="Settings_Compact_Desc" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="CompactModeToggle" Grid.Column="2" VerticalAlignment="Center" Toggled="CompactModeToggle_Toggled" />
                                    </Grid>
                                </Border>

                                <Border x:Name="SettingsNavLayoutCard" Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconBorderStyle}">
                                            <FontIcon FontSize="18" Glyph="&#xE713;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock FontWeight="Bold" Text="导航布局" l:Uids.Uid="Settings_NavLayout_Title" />
                                            <TextBlock Opacity="1.0" FontSize="13" TextWrapping="Wrap" Text="切换侧边栏或顶部标签页导航" l:Uids.Uid="Settings_NavLayout_Desc" />
                                        </StackPanel>
                                        <ComboBox x:Name="NavLayoutComboBox" Grid.Column="2" MinWidth="120" SelectionChanged="NavLayoutComboBox_SelectionChanged" />
                                    </Grid>
                                </Border>

                                <Border x:Name="SettingsDefaultPageCard" Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconBorderStyle}">
                                            <FontIcon FontSize="18" Glyph="&#xE80F;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock FontWeight="Bold" Text="默认启动页面" l:Uids.Uid="Settings_DefaultPage_Title" />
                                            <TextBlock Opacity="1.0" FontSize="13" TextWrapping="Wrap" Text="选择应用启动后默认打开的页面" l:Uids.Uid="Settings_DefaultPage_Desc" />
                                        </StackPanel>
                                        <ComboBox x:Name="DefaultPageComboBox" Grid.Column="2" MinWidth="120" SelectionChanged="DefaultPageComboBox_SelectionChanged" />
                                    </Grid>
                                </Border>

                                <Border x:Name="SettingsShowFrequentCard" Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconBorderStyle}">
                                            <FontIcon FontSize="18" Glyph="&#xE734;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock FontWeight="Bold" Text="显示常用推荐" l:Uids.Uid="Settings_ShowFrequent_Title" />
                                            <TextBlock Opacity="1.0" FontSize="13" TextWrapping="Wrap" Text="在「常用」页面顶部显示按使用频率排序的推荐工具" l:Uids.Uid="Settings_ShowFrequent_Desc" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="ShowFrequentToggle" Grid.Column="2" VerticalAlignment="Center" Toggled="ShowFrequentToggle_Toggled" />
                                    </Grid>
                                </Border>

                                <Border x:Name="SettingsFastModeCard" Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconBorderStyle}">
                                            <FontIcon FontSize="18" Glyph="&#xE945;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock FontWeight="Bold" Text="快速模式" l:Uids.Uid="Settings_FastMode_Title" />
                                            <TextBlock Opacity="1.0" FontSize="13" TextWrapping="Wrap" Text="禁用所有动画，提升响应速度" l:Uids.Uid="Settings_FastMode_Desc" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="FastModeToggle" Grid.Column="2" VerticalAlignment="Center" Toggled="FastModeToggle_Toggled" />
                                    </Grid>
                                </Border>

                                <Border x:Name="SettingsRememberWindowCard" Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconBorderStyle}">
                                            <FontIcon FontSize="18" Glyph="&#xE784;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock FontWeight="Bold" Text="记住窗口位置和大小" l:Uids.Uid="Settings_RememberWindow_Title" />
                                            <TextBlock Opacity="1.0" FontSize="13" TextWrapping="Wrap" Text="关闭后下次启动将居中显示，避免多显示器断开后窗口位置异常" l:Uids.Uid="Settings_RememberWindow_Desc" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="RememberWindowToggle" Grid.Column="2" VerticalAlignment="Center" Toggled="RememberWindowToggle_Toggled" />
                                    </Grid>
                                </Border>

                                <Border x:Name="SettingsProxyCard" Style="{StaticResource SettingsCardStyle}">
                                    <Grid RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource IconBorderStyle}">
                                                <FontIcon FontSize="18" Glyph="&#xE774;" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock FontWeight="Bold" Text="代理设置" l:Uids.Uid="Settings_Proxy_Title" />
                                                <TextBlock x:Name="ProxyStatusText" Opacity="1.0" FontSize="13" TextWrapping="Wrap" Text="配置 HTTP/HTTPS 代理，所有网络请求将使用代理" l:Uids.Uid="Settings_Proxy_Desc" />
                                            </StackPanel>
                                            <ToggleSwitch x:Name="ProxyToggle" Grid.Column="2" VerticalAlignment="Center" Toggled="ProxyToggle_Toggled" />
                                        </Grid>
                                        <Border Grid.Row="1" Padding="0,1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" x:Name="ProxyDivider" Visibility="Collapsed" />
                                        <Grid Grid.Row="2" ColumnSpacing="16" x:Name="ProxyAddressPanel" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource IconBorderStyle}">
                                                <FontIcon FontSize="18" Glyph="&#xE71B;" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock FontWeight="Bold" Text="代理地址" l:Uids.Uid="Settings_ProxyAddress_Title" />
                                                <TextBlock Opacity="1.0" FontSize="13" TextWrapping="Wrap" Text="格式：http://host:port 或 socks5://host:port" l:Uids.Uid="Settings_ProxyAddress_Desc" />
                                            </StackPanel>
                                            <TextBox x:Name="ProxyAddressTextBox" Grid.Column="2" MinWidth="280" MaxWidth="360" PlaceholderText="http://127.0.0.1:7890" TextChanged="ProxyAddressTextBox_TextChanged" />
                                        </Grid>
                                        <Grid Grid.Row="3" ColumnSpacing="16" x:Name="ProxyAuthPanel" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource IconBorderStyle}">
                                                <FontIcon FontSize="18" Glyph="&#xE72E;" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock FontWeight="Bold" Text="代理认证（可选）" l:Uids.Uid="Settings_ProxyAuth_Title" />
                                                <TextBlock Opacity="1.0" FontSize="13" TextWrapping="Wrap" Text="如需认证，输入用户名和密码" l:Uids.Uid="Settings_ProxyAuth_Desc" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                <TextBox x:Name="ProxyUsernameTextBox" Width="100" PlaceholderText="用户名" l:Uids.Uid="Settings_ProxyUsername_Placeholder" TextChanged="ProxyUsernameTextBox_TextChanged" />
                                                <PasswordBox x:Name="ProxyPasswordBox" Width="140" PlaceholderText="密码" l:Uids.Uid="Settings_ProxyPassword_Placeholder" PasswordChanged="ProxyPasswordBox_PasswordChanged" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Grid.Row="4" ColumnSpacing="16" x:Name="ProxyTestPanel" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource IconBorderStyle}">
                                                <FontIcon FontSize="18" Glyph="&#xE73E;" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock FontWeight="Bold" Text="测试代理连接" l:Uids.Uid="Settings_ProxyTest_Title" />
                                                <TextBlock x:Name="ProxyTestStatusText" Opacity="1.0" FontSize="13" TextWrapping="Wrap" Text="验证代理是否可用" l:Uids.Uid="Settings_ProxyTest_Desc" />
                                            </StackPanel>
                                            <Button x:Name="ProxyTestButton" Grid.Column="2" Padding="14,6" Click="ProxyTestButton_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon x:Name="ProxyTestIcon" FontSize="12" Glyph="&#xE73E;" />
                                                    <TextBlock x:Name="ProxyTestButtonText" Text="测试连接" l:Uids.Uid="Settings_ProxyTest_Button" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>

                            </StackPanel>
                            </ScrollViewer>
                        </Expander.Content>
                    </Expander>

                    <Expander
                        x:Name="AppearanceExpander"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsExpanded="False">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,8" MinHeight="56">
                                <Border Style="{StaticResource NavCardIconBorderStyle}">
                                    <FontIcon FontSize="20" Glyph="&#xE7F3;" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock FontWeight="Bold" Text="外观" l:Uids.Uid="Settings_Appearance_Title" />
                                    <TextBlock Opacity="1.0" FontSize="13" Text="窗口材质、背景图片、界面字体、水印、品牌 Logo" l:Uids.Uid="Settings_Appearance_Desc" />
                                </StackPanel>
                            </StackPanel>
                        </Expander.Header>
                        <Expander.Content>
                            <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                            <StackPanel Spacing="2" Padding="0,4,0,0">

                                <Border x:Name="SettingsBackdropCard" Style="{StaticResource SettingsCardStyle}">
                                    <Grid RowSpacing="14">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource IconBorderStyle}">
                                                <FontIcon FontSize="18" Glyph="&#xE7F3;" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock FontWeight="Bold" Text="窗口材质" l:Uids.Uid="Settings_Backdrop_Title" />
                                                <TextBlock Opacity="1.0" FontSize="13" TextWrapping="Wrap" Text="选择窗口背景的视觉材质效果，并可自定义色调" l:Uids.Uid="Settings_Backdrop_Desc" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Grid.Row="1" RowSpacing="8" ColumnSpacing="8" HorizontalAlignment="Stretch">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="BackdropMicaOption" Tag="Mica" CornerRadius="8" BorderThickness="2" BorderBrush="{ThemeResource SubtleFillColorSecondaryBrush}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Padding="10,8" Tapped="BackdropOption_Tapped" PointerEntered="BackdropOption_PointerEntered" PointerExited="BackdropOption_PointerExited">
                                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                                    <Border Width="48" Height="32" CornerRadius="4" Background="#1A000000">
                                                        <Border CornerRadius="3" Margin="3" Background="#0CFFFFFF">
                                                            <Border CornerRadius="2" Margin="2" Background="#08FFFFFF" />
                                                        </Border>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="Mica" />
                                                        <TextBlock FontSize="11" Opacity="1.0" Text="柔和云母" l:Uids.Uid="Settings_BackdropMica_Desc" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="BackdropMicaAltOption" Grid.Column="1" Tag="MicaAlt" CornerRadius="8" BorderThickness="2" BorderBrush="{ThemeResource SubtleFillColorSecondaryBrush}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Padding="10,8" Tapped="BackdropOption_Tapped" PointerEntered="BackdropOption_PointerEntered" PointerExited="BackdropOption_PointerExited">
                                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                                    <Border Width="48" Height="32" CornerRadius="4" Background="#2A000000">
                                                        <Border CornerRadius="3" Margin="3" Background="#14FFFFFF">
                                                            <Border CornerRadius="2" Margin="2" Background="#0AFFFFFF" />
                                                        </Border>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center" Spacing="2">
