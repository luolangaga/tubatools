<?xml version='1.0' encoding='utf-8'?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:l="using:WinUI3Localizer" xmlns:toolkit="using:CommunityToolkit.WinUI.Controls" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Class="TubaWinUi3.Pages.SettingsPage" NavigationCacheMode="Enabled" mc:Ignorable="d">
    <Page.Resources>
        <Style TargetType="Border" x:Key="SettingsRowSurface">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SettingsRowTitle" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SettingsRowDescription">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Page.Resources>
    <Grid Background="Transparent">
        <ScrollViewer x:Name="RootScrollViewer" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
            <RelativePanel HorizontalAlignment="Stretch">
                <StackPanel x:Name="ContentPanel" RelativePanel.AlignHorizontalCenterWithPanel="True" RelativePanel.AlignLeftWithPanel="True" RelativePanel.AlignRightWithPanel="True" Spacing="0" Padding="32,24,32,40" SizeChanged="SettingsContent_SizeChanged">
                    <Grid Margin="0,0,0,24" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" l:Uids.Uid="Settings_PageTitle" TextWrapping="Wrap"/>
                        <ComboBox Width="172" VerticalAlignment="Center" PlaceholderText="跳转到分类" SelectionChanged="SettingsSection_SelectionChanged" Grid.Column="1" x:Name="SettingsSectionPicker" l:Uids.Uid="Settings_SectionPicker">
                            <ComboBoxItem Content="版本和更新" Tag="UpdatesSection" l:Uids.Uid="Settings_GroupOptionUpdates"/>
                            <ComboBoxItem Content="启动和行为" Tag="GeneralExpander" l:Uids.Uid="Settings_GroupOptionBehavior"/>
                            <ComboBoxItem Content="外观和布局" Tag="AppearanceExpander" l:Uids.Uid="Settings_GroupOptionAppearance"/>
                            <ComboBoxItem Content="硬件信息" Tag="HardwareAiExpander" l:Uids.Uid="Settings_GroupOptionHardware"/>
                            <ComboBoxItem Content="工具和系统集成" Tag="IntegrationSection" l:Uids.Uid="Settings_GroupOptionIntegration"/>
                            <ComboBoxItem Content="网络和下载" Tag="NetworkSection" l:Uids.Uid="Settings_GroupOptionNetwork"/>
                            <ComboBoxItem Content="数据和存储" Tag="ToolsCommunityExpander" l:Uids.Uid="Settings_GroupOptionStorage"/>
                            <ComboBoxItem Content="隐私和诊断" Tag="PrivacySection" l:Uids.Uid="Settings_GroupOptionPrivacy"/>
                            <ComboBoxItem Content="社区和反馈" Tag="CommunitySection" l:Uids.Uid="Settings_GroupOptionCommunity"/>
                            <ComboBoxItem Content="关于与鸣谢" Tag="CreditsExpander" l:Uids.Uid="Settings_GroupOptionAbout"/>
                        </ComboBox>
                    </Grid>
                    <Border x:Name="AppInfoCard" Style="{StaticResource SettingsRowSurface}" Tapped="AppInfoCard_Tapped" RenderTransformOrigin="0.5,0.5" Margin="0,0,0,28">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="AppInfoCardScale" ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image x:Name="AppIconImage" Width="72" Height="72" Stretch="Uniform"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                <TextBlock x:Name="AppTitleText" Style="{StaticResource CardTitleStyle}" Text="图吧工具箱CE" l:Uids.Uid="Settings_AppTitle" TextWrapping="Wrap"/>
                                <TextBlock x:Name="AppSubtitleText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="基于 WinUI 3 构建的 PC 硬件工具集合" l:Uids.Uid="Settings_AppSubtitle" TextWrapping="Wrap"/>
                                <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="12" Margin="-12,6,0,0">
                                    <HyperlinkButton Content="官方网站" Click="SettingsWebsite_Click" Padding="12,4" l:Uids.Uid="Settings_WebsiteLink"/>
                                    <HyperlinkButton Content="GitHub" Click="SettingsRepository_Click" Padding="12,4" l:Uids.Uid="Settings_RepositoryLink"/>
                                    <HyperlinkButton Content="反馈与建议" Click="FeedbackButton_Click" Padding="12,4" l:Uids.Uid="Settings_FeedbackLink"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Spacing="4" Margin="0,0,0,28" x:Name="UpdatesSection">
                        <TextBlock Text="版本和更新" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" AutomationProperties.HeadingLevel="Level2" l:Uids.Uid="Settings_GroupUpdates" TextWrapping="Wrap"/>
                        <Border x:Name="SettingsUpdateCard" Style="{StaticResource SettingsRowSurface}">
                            <toolkit:SettingsCard HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" MinHeight="76">
                                <toolkit:SettingsCard.Header>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource SettingsRowTitle}" Text="检查更新" l:Uids.Uid="Settings_Update_Title" TextWrapping="Wrap"/>
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" x:Name="UpdateStatusText" FontSize="12" Text="点击检查是否有新版本" l:Uids.Uid="Settings_Update_Status" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </toolkit:SettingsCard.Header>
                                <toolkit:SettingsCard.HeaderIcon>
                                    <FontIcon FontSize="18" Glyph=""/>
                                </toolkit:SettingsCard.HeaderIcon>
                                <Button x:Name="CheckUpdateButton" VerticalAlignment="Center" Padding="12,8" Click="CheckUpdateButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="12" Glyph=""/>
                                        <TextBlock Text="检查更新" l:Uids.Uid="Settings_Update_Button" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Button>
                            </toolkit:SettingsCard>
                        </Border>
                        <Border x:Name="SettingsToolsBundleCard" Style="{StaticResource SettingsRowSurface}" Visibility="Collapsed">
                            <toolkit:SettingsCard HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" MinHeight="76">
                                <toolkit:SettingsCard.Header>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource SettingsRowTitle}" Text="内核更新" l:Uids.Uid="Settings_ToolsBundle_Title" TextWrapping="Wrap"/>
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" x:Name="ToolsBundleStatusText" FontSize="12" Text="点击检查内核是否有新版本" l:Uids.Uid="Settings_ToolsBundle_Status" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </toolkit:SettingsCard.Header>
                                <toolkit:SettingsCard.HeaderIcon>
                                    <FontIcon FontSize="18" Glyph=""/>
                                </toolkit:SettingsCard.HeaderIcon>
                                <Button x:Name="CheckToolsBundleButton" VerticalAlignment="Center" Padding="12,8" Click="CheckToolsBundleButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="12" Glyph=""/>
                                        <TextBlock Text="检查更新" l:Uids.Uid="Settings_ToolsBundle_Button" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Button>
                            </toolkit:SettingsCard>
                        </Border>
                        <Border Style="{StaticResource SettingsRowSurface}">
                            <toolkit:SettingsCard HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" MinHeight="76" IsClickEnabled="True" Click="SettingsWhatsNew_Click" IsActionIconVisible="True">
                                <toolkit:SettingsCard.Header>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource SettingsRowTitle}" Text="新增内容" l:Uids.Uid="Settings_WhatsNew_Title" TextWrapping="Wrap"/>
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Text="查看各版本更新日志和新功能" l:Uids.Uid="Settings_WhatsNew_Desc" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </toolkit:SettingsCard.Header>
                                <toolkit:SettingsCard.HeaderIcon>
                                    <FontIcon FontSize="20" Glyph="" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </toolkit:SettingsCard.HeaderIcon>
                            </toolkit:SettingsCard>
                        </Border>
                    </StackPanel>
                    <StackPanel Spacing="4" Margin="0,0,0,28" x:Name="GeneralExpander">
                        <TextBlock Text="启动和行为" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" AutomationProperties.HeadingLevel="Level2" l:Uids.Uid="Settings_GroupBehavior" TextWrapping="Wrap"/>
                        <Border x:Name="SettingsDefaultPageCard" Style="{StaticResource SettingsRowSurface}">
                            <toolkit:SettingsCard HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" MinHeight="76">
                                <toolkit:SettingsCard.Header>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource SettingsRowTitle}" Text="默认启动页面" l:Uids.Uid="Settings_DefaultPage_Title" TextWrapping="Wrap"/>
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Text="选择应用启动后默认打开的页面" l:Uids.Uid="Settings_DefaultPage_Desc"/>
                                    </StackPanel>
                                </toolkit:SettingsCard.Header>
                                <toolkit:SettingsCard.HeaderIcon>
                                    <FontIcon FontSize="18" Glyph=""/>
                                </toolkit:SettingsCard.HeaderIcon>
                                <ComboBox x:Name="DefaultPageComboBox" MinWidth="120" SelectionChanged="DefaultPageComboBox_SelectionChanged" VerticalAlignment="Center"/>
                            </toolkit:SettingsCard>
                        </Border>
                        <Border x:Name="SettingsRememberWindowCard" Style="{StaticResource SettingsRowSurface}">
                            <toolkit:SettingsCard HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" MinHeight="76">
                                <toolkit:SettingsCard.Header>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource SettingsRowTitle}" Text="记住窗口位置和大小" l:Uids.Uid="Settings_RememberWindow_Title" TextWrapping="Wrap"/>
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Text="关闭后下次启动将居中显示，避免多显示器断开后窗口位置异常" l:Uids.Uid="Settings_RememberWindow_Desc"/>
                                    </StackPanel>
                                </toolkit:SettingsCard.Header>
                                <toolkit:SettingsCard.HeaderIcon>
                                    <FontIcon FontSize="18" Glyph=""/>
                                </toolkit:SettingsCard.HeaderIcon>
                                <ToggleSwitch x:Name="RememberWindowToggle" VerticalAlignment="Center" Toggled="RememberWindowToggle_Toggled"/>
                            </toolkit:SettingsCard>
                        </Border>
                        <Border x:Name="SettingsCloseToTrayCard" Style="{StaticResource SettingsRowSurface}">
                            <toolkit:SettingsCard HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" MinHeight="76">
                                <toolkit:SettingsCard.Header>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource SettingsRowTitle}" Text="关闭主窗口时最小化到系统托盘" l:Uids.Uid="Settings_CloseToTray_Title" TextWrapping="Wrap"/>
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Text="点关闭按钮不再退出程序，而是留在系统托盘继续运行，避免误关闭后重启时重新检测硬件信息；双击托盘图标恢复窗口，右键可退出" l:Uids.Uid="Settings_CloseToTray_Desc"/>
                                    </StackPanel>
                                </toolkit:SettingsCard.Header>
                                <toolkit:SettingsCard.HeaderIcon>
                                    <FontIcon FontSize="18" Glyph=""/>
                                </toolkit:SettingsCard.HeaderIcon>
                                <ToggleSwitch x:Name="CloseToTrayToggle" VerticalAlignment="Center" Toggled="CloseToTrayToggle_Toggled"/>
                            </toolkit:SettingsCard>
                        </Border>
                        <Border x:Name="SettingsFastModeCard" Style="{StaticResource SettingsRowSurface}">
                            <toolkit:SettingsCard HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" MinHeight="76">
                                <toolkit:SettingsCard.Header>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource SettingsRowTitle}" Text="低配模式" l:Uids.Uid="Settings_FastMode_Title" TextWrapping="Wrap"/>
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Text="禁用动画与启动预加载，降低老电脑资源占用" l:Uids.Uid="Settings_FastMode_Desc"/>
                                    </StackPanel>
                                </toolkit:SettingsCard.Header>
                                <toolkit:SettingsCard.HeaderIcon>
                                    <FontIcon FontSize="18" Glyph=""/>
                                </toolkit:SettingsCard.HeaderIcon>
                                <ToggleSwitch x:Name="FastModeToggle" VerticalAlignment="Center" Toggled="FastModeToggle_Toggled"/>
                            </toolkit:SettingsCard>
                        </Border>
                        <Border x:Name="SettingsShowFrequentCard" Style="{StaticResource SettingsRowSurface}">
                            <toolkit:SettingsCard HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" MinHeight="76">
                                <toolkit:SettingsCard.Header>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource SettingsRowTitle}" Text="显示常用推荐" l:Uids.Uid="Settings_ShowFrequent_Title" TextWrapping="Wrap"/>
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Text="在「常用」页面顶部显示按使用频率排序的推荐工具" l:Uids.Uid="Settings_ShowFrequent_Desc"/>
                                    </StackPanel>
                                </toolkit:SettingsCard.Header>
                                <toolkit:SettingsCard.HeaderIcon>
                                    <FontIcon FontSize="18" Glyph=""/>
                                </toolkit:SettingsCard.HeaderIcon>
                                <ToggleSwitch x:Name="ShowFrequentToggle" VerticalAlignment="Center" Toggled="ShowFrequentToggle_Toggled"/>
                            </toolkit:SettingsCard>
                        </Border>
                        <Border x:Name="SettingsBuiltinToolOpenModeCard" Style="{StaticResource SettingsRowSurface}">
                            <toolkit:SettingsCard HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" MinHeight="76">
                                <toolkit:SettingsCard.Header>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource SettingsRowTitle}" Text="内置工具打开方式" l:Uids.Uid="Settings_BuiltinOpenMode_Title" TextWrapping="Wrap"/>
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Text="选择打开内置工具时嵌入当前页面，还是打开独立窗口" l:Uids.Uid="Settings_BuiltinOpenMode_Desc"/>
                                    </StackPanel>
                                </toolkit:SettingsCard.Header>
                                <toolkit:SettingsCard.HeaderIcon>
                                    <FontIcon FontSize="18" Glyph=""/>
                                </toolkit:SettingsCard.HeaderIcon>
                                <ComboBox x:Name="BuiltinToolOpenModeComboBox" MinWidth="120" SelectionChanged="BuiltinToolOpenModeComboBox_SelectionChanged" VerticalAlignment="Center"/>
                            </toolkit:SettingsCard>
                        </Border>
                    </StackPanel>
                    <StackPanel Spacing="4" Margin="0,0,0,28" x:Name="AppearanceExpander">
                        <TextBlock Text="外观和布局" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" AutomationProperties.HeadingLevel="Level2" l:Uids.Uid="Settings_GroupAppearance" TextWrapping="Wrap"/>
                        <Border x:Name="SettingsThemeCard" Style="{StaticResource SettingsRowSurface}">
                            <toolkit:SettingsCard HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" MinHeight="76">
                                <toolkit:SettingsCard.Header>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource SettingsRowTitle}" Text="主题" l:Uids.Uid="Settings_ThemeCard_Title" TextWrapping="Wrap"/>
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Text="选择应用的显示主题，切换后立即生效" l:Uids.Uid="Settings_ThemeCard_Desc"/>
                                    </StackPanel>
                                </toolkit:SettingsCard.Header>
                                <toolkit:SettingsCard.HeaderIcon>
                                    <FontIcon FontSize="18" Glyph=""/>
                                </toolkit:SettingsCard.HeaderIcon>
                                <ComboBox x:Name="ThemeSelector" MinWidth="120" SelectionChanged="ThemeSelector_SelectionChanged" VerticalAlignment="Center">
                                    <ComboBoxItem Content="跟随系统" l:Uids.Uid="Settings_Theme_System" Tag="auto"/>
                                    <ComboBoxItem Content="浅色" l:Uids.Uid="Settings_Theme_Light" Tag="light"/>
                                    <ComboBoxItem Content="深色" l:Uids.Uid="Settings_Theme_Dark" Tag="dark"/>
                                </ComboBox>
                            </toolkit:SettingsCard>
                        </Border>
                        <Border x:Name="SettingsLanguageCard" Style="{StaticResource SettingsRowSurface}">
                            <toolkit:SettingsCard HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" MinHeight="76">
                                <toolkit:SettingsCard.Header>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource SettingsRowTitle}" Text="界面语言" l:Uids.Uid="Settings_LanguageTitle" TextWrapping="Wrap"/>
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Text="选择应用的显示语言" l:Uids.Uid="Settings_LanguageDesc"/>
                                    </StackPanel>
                                </toolkit:SettingsCard.Header>
                                <toolkit:SettingsCard.HeaderIcon>
                                    <FontIcon FontSize="18" Glyph=""/>
                                </toolkit:SettingsCard.HeaderIcon>
                                <ComboBox x:Name="LanguageComboBox" MinWidth="120" SelectionChanged="LanguageComboBox_SelectionChanged" VerticalAlignment="Center"/>
                            </toolkit:SettingsCard>
                        </Border>
                        <Border x:Name="SettingsNavLayoutCard" Style="{StaticResource SettingsRowSurface}">
                            <toolkit:SettingsCard HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" MinHeight="76">
                                <toolkit:SettingsCard.Header>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource SettingsRowTitle}" Text="导航布局" l:Uids.Uid="Settings_NavLayout_Title" TextWrapping="Wrap"/>
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Text="切换侧边栏或顶部标签页导航" l:Uids.Uid="Settings_NavLayout_Desc"/>
                                    </StackPanel>
                                </toolkit:SettingsCard.Header>
                                <toolkit:SettingsCard.HeaderIcon>
                                    <FontIcon FontSize="18" Glyph=""/>
                                </toolkit:SettingsCard.HeaderIcon>
                                <ComboBox x:Name="NavLayoutComboBox" MinWidth="120" SelectionChanged="NavLayoutComboBox_SelectionChanged" VerticalAlignment="Center"/>
                            </toolkit:SettingsCard>
                        </Border>
                        <Border x:Name="SettingsCompactModeCard" Style="{StaticResource SettingsRowSurface}">
                            <toolkit:SettingsCard HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" MinHeight="76">
                                <toolkit:SettingsCard.Header>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource SettingsRowTitle}" Text="简洁列表模式" l:Uids.Uid="Settings_Compact_Title" TextWrapping="Wrap"/>
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Text="原版图吧工具箱的样式" l:Uids.Uid="Settings_Compact_Desc"/>
                                    </StackPanel>
                                </toolkit:SettingsCard.Header>
                                <toolkit:SettingsCard.HeaderIcon>
                                    <FontIcon FontSize="18" Glyph=""/>
                                </toolkit:SettingsCard.HeaderIcon>
                                <ToggleSwitch x:Name="CompactModeToggle" VerticalAlignment="Center" Toggled="CompactModeToggle_Toggled"/>
                            </toolkit:SettingsCard>
                        </Border>
                        <Border x:Name="SettingsBackdropCard" Style="{StaticResource SettingsRowSurface}">
                            <toolkit:SettingsExpander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                                <toolkit:SettingsExpander.Header>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource SettingsRowTitle}" Text="窗口材质" l:Uids.Uid="Settings_Backdrop_Title" TextWrapping="Wrap"/>
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Text="选择窗口背景的视觉材质效果，并可自定义色调" l:Uids.Uid="Settings_Backdrop_Desc"/>
                                    </StackPanel>
                                </toolkit:SettingsExpander.Header>
                                <toolkit:SettingsExpander.HeaderIcon>
                                    <FontIcon FontSize="18" Glyph=""/>
                                </toolkit:SettingsExpander.HeaderIcon>
                                <toolkit:SettingsExpander.Items>
                                    <toolkit:SettingsCard HorizontalContentAlignment="Stretch" Padding="0" MinHeight="0" ContentAlignment="Vertical">
                                        <Border Padding="20,16">
                                            <Grid RowSpacing="12">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="1" RowSpacing="8" ColumnSpacing="8" HorizontalAlignment="Stretch">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="BackdropMicaOption" Tag="Mica" CornerRadius="8" BorderThickness="2" BorderBrush="{ThemeResource SubtleFillColorSecondaryBrush}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Padding="12,8" Tapped="BackdropOption_Tapped" PointerEntered="BackdropOption_PointerEntered" PointerExited="BackdropOption_PointerExited">
                                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                                            <Border Width="48" Height="32" CornerRadius="4" Background="#1A000000">
                                                                <Border CornerRadius="4" Margin="3" Background="#0CFFFFFF">
                                                                    <Border CornerRadius="4" Margin="2" Background="#08FFFFFF"/>
                                                                </Border>
                                                            </Border>
                                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="Mica" TextWrapping="Wrap"/>
                                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Text="柔和云母" l:Uids.Uid="Settings_BackdropMica_Desc" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="BackdropMicaAltOption" Grid.Column="1" Tag="MicaAlt" CornerRadius="8" BorderThickness="2" BorderBrush="{ThemeResource SubtleFillColorSecondaryBrush}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Padding="12,8" Tapped="BackdropOption_Tapped" PointerEntered="BackdropOption_PointerEntered" PointerExited="BackdropOption_PointerExited">
                                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                                            <Border Width="48" Height="32" CornerRadius="4" Background="#2A000000">
                                                                <Border CornerRadius="4" Margin="3" Background="#14FFFFFF">
                                                                    <Border CornerRadius="4" Margin="2" Background="#0AFFFFFF"/>
                                                                </Border>
                                                            </Border>
                                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="Mica Alt" TextWrapping="Wrap"/>
                                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Text="层次云母" l:Uids.Uid="Settings_BackdropMicaAlt_Desc" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="BackdropAcrylicOption" Grid.Row="1" Tag="Acrylic" CornerRadius="8" BorderThickness="2" BorderBrush="{ThemeResource SubtleFillColorSecondaryBrush}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Padding="12,8" Tapped="BackdropOption_Tapped" PointerEntered="BackdropOption_PointerEntered" PointerExited="BackdropOption_PointerExited">
                                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                                            <Border Width="48" Height="32" CornerRadius="4">
                                                                <Border.Background>
                                                                    <AcrylicBrush TintColor="#FF202020" TintOpacity="0.8" TintLuminosityOpacity="0.3"/>
                                                                </Border.Background>
                                                                <Border CornerRadius="4" Margin="4" Background="#18FFFFFF"/>
                                                            </Border>
                                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="亚克力" l:Uids.Uid="Settings_BackdropAcrylic_Title" TextWrapping="Wrap"/>
                                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Text="磨砂玻璃" l:Uids.Uid="Settings_BackdropAcrylic_Desc" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
