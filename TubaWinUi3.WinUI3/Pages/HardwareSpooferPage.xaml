<?xml version="1.0" encoding="utf-8" ?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:controls="using:TubaWinUi3.Controls" xmlns:toolkit="using:CommunityToolkit.WinUI.Controls" x:Class="TubaWinUi3.Pages.HardwareSpooferPage" mc:Ignorable="d">
    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <controls:ToolPageHeader ToolId="hardware-spoofer" x:Name="PageHeader" Grid.Row="0" Title="配置修改器" Subtitle="修改注册表中的硬件信息显示" Glyph="&#xEEA1;"/>
        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto" Padding="24,4,24,32" HorizontalContentAlignment="Stretch" controls:ToolViewport.ConstrainContent="True">
            <StackPanel x:Name="MainPanel" Spacing="24" MaxWidth="1120">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromHorizontalOffset="0" FromVerticalOffset="24" IsStaggeringEnabled="True"/>
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <Grid ColumnSpacing="24" Style="{StaticResource ToolSummaryStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border>
                        <StackPanel Spacing="2">
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="已修改项"/>
                            <TextBlock x:Name="ModifiedCountText" FontSize="20" FontWeight="SemiBold" Text="0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1">
                        <StackPanel Spacing="2">
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="备份状态"/>
                            <TextBlock x:Name="BackupStatusText" FontSize="14" FontWeight="SemiBold" Text="无备份"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2">
                        <StackPanel Spacing="2">
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="管理员权限"/>
                            <TextBlock x:Name="AdminStatusText" FontSize="14" FontWeight="SemiBold" Text="检测中..."/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Border x:Name="WarningBorder" Padding="12,8,12,8" BorderThickness="1" CornerRadius="8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon x:Name="WarningIcon" FontSize="16" Glyph="&#xE7BA;"/>
                        <TextBlock FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" Text="修改注册表可能影响系统稳定性，建议在修改前创建系统还原点。部分软件可能仍通过其他方式检测真实硬件。" Grid.Column="1"/>
                    </Grid>
                </Border>
                <toolkit:SettingsExpander x:Name="CpuExpander" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <toolkit:SettingsExpander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xEEA1;"/>
                            <TextBlock FontWeight="SemiBold" Text="CPU 处理器"/>
                        </StackPanel>
                    </toolkit:SettingsExpander.Header>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="16" Padding="0,8">
                                <ComboBox x:Name="CpuNameBox" IsEditable="True" HorizontalAlignment="Stretch" PlaceholderText="输入或选择 CPU 名称" Header="CPU 名称"/>
                                <ComboBox x:Name="CpuVendorBox" HorizontalAlignment="Stretch" SelectedIndex="0" Header="厂商标识">
                                    <x:String>GenuineIntel</x:String>
                                    <x:String>AuthenticAMD</x:String>
                                </ComboBox>
                                <TextBox x:Name="CpuMhzBox" HorizontalAlignment="Stretch" PlaceholderText="如 3600" Header="频率 (MHz)"/>
                                <TextBlock x:Name="CpuOriginalText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
                <toolkit:SettingsExpander x:Name="GpuExpander" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <toolkit:SettingsExpander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xF211;"/>
                            <TextBlock FontWeight="SemiBold" Text="GPU 显卡"/>
                        </StackPanel>
                    </toolkit:SettingsExpander.Header>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="16" Padding="0,8">
                                <ComboBox x:Name="GpuDescBox" IsEditable="True" HorizontalAlignment="Stretch" PlaceholderText="输入或选择 GPU 名称" Header="GPU 描述"/>
                                <ComboBox x:Name="GpuProviderBox" IsEditable="True" HorizontalAlignment="Stretch" Header="驱动提供商">
                                    <x:String>NVIDIA</x:String>
                                    <x:String>AMD</x:String>
                                    <x:String>Intel</x:String>
                                </ComboBox>
                                <TextBlock x:Name="GpuOriginalText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
                <toolkit:SettingsExpander x:Name="SystemExpander" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <toolkit:SettingsExpander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE977;"/>
                            <TextBlock FontWeight="SemiBold" Text="系统信息"/>
                        </StackPanel>
                    </toolkit:SettingsExpander.Header>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="16" Padding="0,8">
                                <ComboBox x:Name="SystemProductBox" IsEditable="True" HorizontalAlignment="Stretch" PlaceholderText="如 XPS 15 9530" Header="产品名称"/>
                                <ComboBox x:Name="SystemManufacturerBox" IsEditable="True" HorizontalAlignment="Stretch" Header="制造商">
                                    <x:String>Dell Inc.</x:String>
                                    <x:String>LENOVO</x:String>
                                    <x:String>ASUSTeK COMPUTER INC.</x:String>
                                    <x:String>HP</x:String>
                                    <x:String>Microsoft Corporation</x:String>
                                    <x:String>Apple Inc.</x:String>
                                </ComboBox>
                                <TextBox x:Name="SystemFamilyBox" HorizontalAlignment="Stretch" PlaceholderText="可选" Header="系统系列"/>
                                <TextBlock x:Name="SystemOriginalText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
                <toolkit:SettingsExpander x:Name="BiosExpander" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <toolkit:SettingsExpander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE977;"/>
                            <TextBlock FontWeight="SemiBold" Text="BIOS / 主板"/>
                        </StackPanel>
                    </toolkit:SettingsExpander.Header>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="16" Padding="0,8">
                                <ComboBox x:Name="BiosVendorBox" IsEditable="True" HorizontalAlignment="Stretch" Header="BIOS 厂商">
                                    <x:String>American Megatrends Inc.</x:String>
                                    <x:String>Insyde Corp.</x:String>
                                    <x:String>Phoenix Technologies LTD</x:String>
                                    <x:String>Dell Inc.</x:String>
                                </ComboBox>
                                <TextBox x:Name="BiosVersionBox" HorizontalAlignment="Stretch" PlaceholderText="可选" Header="BIOS 版本"/>
                                <ComboBox x:Name="BoardManufacturerBox" IsEditable="True" HorizontalAlignment="Stretch" Header="主板制造商">
                                    <x:String>ASUSTeK COMPUTER INC.</x:String>
                                    <x:String>Micro-Star International Co., Ltd.</x:String>
                                    <x:String>Gigabyte Technology Co., Ltd.</x:String>
                                    <x:String>ASRock</x:String>
                                </ComboBox>
                                <TextBox x:Name="BoardProductBox" HorizontalAlignment="Stretch" PlaceholderText="可选" Header="主板型号"/>
                                <TextBlock x:Name="BiosOriginalText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
                <InfoBar x:Name="StatusBar" IsClosable="True" IsOpen="False"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Padding="24,12,24,16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Click="ApplyButton_Click" Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="12" Glyph="&#xE73E;"/>
                        <TextBlock Text="应用修改"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Click="RestoreButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="12" Glyph="&#xE72C;"/>
                        <TextBlock Text="一键恢复"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Click="BackupButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="12" Glyph="&#xE787;"/>
                        <TextBlock Text="备份当前"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="4" Click="RefreshButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="12" Glyph="&#xE72C;"/>
                        <TextBlock Text="刷新"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
