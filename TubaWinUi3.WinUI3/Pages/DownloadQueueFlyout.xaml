<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TubaWinUi3.Pages.DownloadQueueFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Width="380" MaxHeight="480" Spacing="0">
        <Grid Padding="16,12,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Style="{StaticResource SectionHeaderStyle}"
                VerticalAlignment="Center"
                Text="下载队列" />

            <HyperlinkButton
                x:Name="ClearAllButton"
                Grid.Column="1"
                Padding="8,4"
                FontSize="12"
                Click="ClearAllButton_Click"
                Content="全部清除" />
        </Grid>

        <Border
            Height="1"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
            Margin="16,0" />

        <ScrollViewer
            x:Name="QueueScrollViewer"
            VerticalScrollBarVisibility="Auto"
            Padding="8,4,8,8"
            MaxHeight="420">
            <ItemsRepeater
                x:Name="QueueRepeater"
                ItemsSource="{x:Bind Items}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,4"
                            Padding="12,8"
                            Style="{StaticResource FluentCardStyle}">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Width="32" Height="32"
                                        Style="{StaticResource IconTileStyle}"
                                        VerticalAlignment="Center">
                                        <FontIcon
                                            FontSize="14"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Glyph="{Binding Glyph}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock
                                            Style="{StaticResource SectionHeaderStyle}"
                                            TextTrimming="CharacterEllipsis"
                                            MaxLines="1"
                                            Text="{Binding DisplayName}" />
                                        <TextBlock
                                            FontSize="12"
                                            TextTrimming="CharacterEllipsis"
                                            MaxLines="1"
                                            Text="{Binding Description}" />
                                    </StackPanel>

                                    <Border
                                        Grid.Column="2"
                                        Style="{StaticResource StatusPillStyle}"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{Binding StateBrush}"
                                            Text="{Binding StateText}" />
                                    </Border>
                                </Grid>

                                <ProgressBar
                                    Grid.Row="1"
                                    IsIndeterminate="{Binding IsIndeterminate}"
                                    Value="{Binding ProgressValue}"
                                    ShowError="{Binding IsError}"
                                    Visibility="{Binding ProgressVisible}" />

                                <Grid Grid.Row="2" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        FontSize="12"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="1"
                                        Text="{Binding StatusLine}" />

                                    <StackPanel
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="4">
                                        <Button
                                            Tag="{Binding Id}"
                                            Click="PauseButton_Click"
                                            Padding="8,4"
                                            FontSize="12"
                                            Visibility="{Binding PauseVisible}"
                                            Content="暂停" />
                                        <Button
                                            Tag="{Binding Id}"
                                            Click="ResumeButton_Click"
                                            Padding="8,4"
                                            FontSize="12"
                                            Visibility="{Binding ResumeVisible}"
                                            Content="继续" />
                                        <Button
                                            Tag="{Binding Id}"
                                            Click="RetryButton_Click"
                                            Padding="8,4"
                                            FontSize="12"
                                            Visibility="{Binding RetryVisible}"
                                            Content="重试" />
                                        <Button
                                            Tag="{Binding Id}"
                                            Click="CancelButton_Click"
                                            Padding="8,4"
                                            FontSize="12"
                                            Visibility="{Binding CancelVisible}"
                                            Content="取消" />
                                        <Button
                                            Tag="{Binding Id}"
                                            Click="OpenFolderButton_Click"
                                            Padding="8,4"
                                            FontSize="12"
                                            Visibility="{Binding OpenFolderVisible}"
                                            Content="打开" />
                                        <Button
                                            Tag="{Binding Id}"
                                            Click="DeleteFileButton_Click"
                                            Padding="8,4"
                                            FontSize="12"
                                            Visibility="{Binding DeleteFileVisible}"
                                            ToolTipService.ToolTip="删除文件">
                                            <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                        </Button>
                                        <Button
                                            Tag="{Binding Id}"
                                            Click="RemoveButton_Click"
                                            Padding="8,4"
                                            FontSize="12"
                                            Visibility="{Binding RemoveVisible}">
                                            <FontIcon FontSize="12" Glyph="&#xE711;" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <StackPanel
            x:Name="EmptyState"
            Padding="0,40,0,32"
            HorizontalAlignment="Center"
            Spacing="8"
            Visibility="Visible">
            <FontIcon
                FontSize="28"
                HorizontalAlignment="Center"
                Glyph="&#xE896;" />
            <TextBlock
                FontSize="12"
                HorizontalAlignment="Center"
                Text="暂无下载任务" />
        </StackPanel>
    </StackPanel>
</UserControl>
